[
 {
  "num": "001",
  "scene": "S01",
  "text": "넋이 들렸다며 가리킨 무녀의 손끝에, 진짜 살인자가 서 있었습니다.",
  "sec": 8.131
 },
 {
  "num": "002",
  "scene": "S02",
  "text": "그런데 그 무녀는 귀신을 본 게 아니었지요.",
  "sec": 5.491
 },
 {
  "num": "003",
  "scene": "S02",
  "text": "\"물은 거꾸로 흐르지 않습니다.\"",
  "sec": 3.571
 },
 {
  "num": "004",
  "scene": "S03",
  "text": "허허, 허허서방이올시다. 그 무녀 이야기, 부채 한 번 치고 들려드리리다. 탁!",
  "sec": 9.331
 },
 {
  "num": "005",
  "scene": "S04",
  "text": "그 여인 이름은 월선, 전라도 어느 강마을에서 굿을 하던 무녀였습니다.",
  "sec": 8.531
 },
 {
  "num": "006",
  "scene": "S04",
  "text": "무녀라는 게 무엇인가 하면요.",
  "sec": 3.651
 },
 {
  "num": "007",
  "scene": "S04",
  "text": "굿을 해서 산 사람과 죽은 사람 사이를 이어 주는 사람입니다.",
  "sec": 7.211
 },
 {
  "num": "008",
  "scene": "S04",
  "text": "그 시절에는 만신이라고도 불렀어요.",
  "sec": 3.811
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "아픈 사람이 생겨도 부르고, 사람이 죽어도 불렀지요.",
  "sec": 6.691
 },
 {
  "num": "010",
  "scene": "S04",
  "text": "그런데 부를 때만 반가웠습니다.",
  "sec": 3.851
 },
 {
  "num": "011",
  "scene": "S04",
  "text": "굿이 끝나면 아무도 아는 척을 안 했어요.",
  "sec": 4.931
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "무녀는 그 시절 가장 낮은 축에 들었습니다.",
  "sec": 4.051
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "백정, 광대와 한 줄에 섰지요.",
  "sec": 4.251
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "길에서 마주치면 사람들이 침을 뱉었어요.",
  "sec": 4.331
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "자식은 글방에도 못 보냈고요.",
  "sec": 3.771
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "혼처도 무당 집안끼리만 났습니다.",
  "sec": 4.251
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "월선이도 그렇게 살았어요.",
  "sec": 2.931
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "열다섯에 신이 내렸다 하여 무녀가 됐고요.",
  "sec": 4.411
 },
 {
  "num": "019",
  "scene": "S05",
  "text": "그 뒤로 서른 해를 굿판에서 보냈습니다.",
  "sec": 5.331
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "월선이가 제일 많이 한 굿이 있었어요.",
  "sec": 4.651
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "넋건지기굿이라는 겁니다.",
  "sec": 1.891
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "강마을에는 물에 빠져 죽는 사람이 많았거든요.",
  "sec": 5.211
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "물에 빠져 죽은 넋은 물속에 갇힌다고들 믿었습니다.",
  "sec": 5.491
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "그래서 무녀가 물가에 나가 그 넋을 건져 올려요.",
  "sec": 5.131
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "넋을 담을 그릇에 쌀과 넋옷을 넣고요.",
  "sec": 5.771
 },
 {
  "num": "026",
  "scene": "S06",
  "text": "긴 줄에 매달아 물에 띄웁니다.",
  "sec": 4.371
 },
 {
  "num": "027",
  "scene": "S06",
  "text": "그 그릇이 흘러가다 멈추는 자리에 넋이 있다고 했지요.",
  "sec": 7.891
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "서른 해를 그 굿을 하다 보니 아는 게 생겼어요.",
  "sec": 5.451
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "물이 어디로 흐르는지를요.",
  "sec": 3.851
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "강은 겉으로는 다 같아 보입니다.",
  "sec": 3.971
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "그런데 물속에는 길이 따로 있어요.",
  "sec": 5.171
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "빠른 길이 있고, 도는 자리가 있고, 멈추는 자리가 있습니다.",
  "sec": 7.931
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "물에 빠진 사람이 어디서 떠오를지도 그 길을 따라갑니다.",
  "sec": 6.131
 },
 {
  "num": "034",
  "scene": "S07",
  "text": "월선이는 그걸 눈이 아니라 발로 알았어요.",
  "sec": 4.091
 },
 {
  "num": "035",
  "scene": "S07",
  "text": "서른 해를 그 물에 발을 담갔으니까요.",
  "sec": 4.131
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "그리고 한 가지는 어느 물이나 똑같았습니다.",
  "sec": 5.531
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "물은 아래로만 흐른다는 겁니다.",
  "sec": 3.531
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "아무리 굽이가 져도요.",
  "sec": 2.691
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "아무리 소용돌이가 쳐도요.",
  "sec": 3.251
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "위로 거슬러 올라가는 법은 없어요.",
  "sec": 4.051
 },
 {
  "num": "041",
  "scene": "S08",
  "text": "허허, 너무 뻔한 소리지요.",
  "sec": 3.971
 },
 {
  "num": "042",
  "scene": "S08",
  "text": "그런데 이 뻔한 것을 아무도 맞춰 보지 않았습니다.",
  "sec": 5.771
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "그 마을에 만복이라는 사내가 있었어요.",
  "sec": 4.291
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "서른 살 먹은 농사꾼이었습니다.",
  "sec": 3.811
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "성실하기로 소문이 났지요.",
  "sec": 3.091
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "아내 분이와 늙은 어머니를 모시고 살았어요.",
  "sec": 4.731
 },
 {
  "num": "047",
  "scene": "S09",
  "text": "그해 가을 만복이가 소를 팔러 장에 갔습니다.",
  "sec": 6.091
 },
 {
  "num": "048",
  "scene": "S09",
  "text": "소를 판 돈이 쉰 냥이었어요.",
  "sec": 3.251
 },
 {
  "num": "049",
  "scene": "S09",
  "text": "한 해 농사보다 큰돈이었지요.",
  "sec": 3.691
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "장에는 외사촌 칠복이가 같이 갔습니다.",
  "sec": 4.851
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "칠복이는 만복이와 한동네에서 자란 사람이었어요.",
  "sec": 5.891
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "그런데 노름을 좋아했습니다.",
  "sec": 3.051
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "빚이 많다는 소문이 있었지요.",
  "sec": 3.131
 },
 {
  "num": "054",
  "scene": "S10",
  "text": "그날 둘이 장에서 술을 마시고 밤길을 걸어 돌아왔어요.",
  "sec": 6.491
 },
 {
  "num": "055",
  "scene": "S10",
  "text": "마을로 들어오려면 개울을 하나 건너야 했습니다.",
  "sec": 4.891
 },
 {
  "num": "056",
  "scene": "S10",
  "text": "징검다리가 놓인 개울이었지요.",
  "sec": 3.611
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "이튿날 아침, 칠복이가 마을에 소리를 질렀어요.",
  "sec": 5.531
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "형님이 물에 빠졌다고요.",
  "sec": 3.091
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "술에 취해 징검다리를 건너다 미끄러졌다고 했습니다.",
  "sec": 5.251
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "밤이 어두워 아무리 찾아도 못 찾았다고 했어요.",
  "sec": 6.011
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "마을 사람들이 개울로 몰려갔습니다.",
  "sec": 4.251
 },
 {
  "num": "062",
  "scene": "S11",
  "text": "만복이는 개울 위쪽 소에서 떠올랐어요.",
  "sec": 5.531
 },
 {
  "num": "063",
  "scene": "S11",
  "text": "물이 깊게 고인 웅덩이를 소라고 하지요.",
  "sec": 5.411
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "만복이 어머니가 그 자리에서 쓰러졌습니다.",
  "sec": 4.451
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "분이는 소리도 못 내고 울었어요.",
  "sec": 4.451
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "그런데 소 판 돈 쉰 냥이 없었습니다.",
  "sec": 5.731
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "칠복이가 말했어요.",
  "sec": 2.291
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "\"형님 품에 있었는데 물에 쓸려 갔나 봅니다.\"",
  "sec": 5.331
 },
 {
  "num": "069",
  "scene": "S12",
  "text": "다들 그런가 보다 했지요.",
  "sec": 2.491
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "그런데 며칠이 지나자 이상한 말이 돌았습니다.",
  "sec": 5.531
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "분이가 남편을 밀었다는 겁니다.",
  "sec": 3.451
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "그 말을 처음 꺼낸 게 누구였겠어요.",
  "sec": 4.371
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "칠복이였습니다.",
  "sec": 2.531
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "\"형수가 그날 밤 개울가에 나와 있는 걸 봤소.\"",
  "sec": 5.371
 },
 {
  "num": "075",
  "scene": "S13",
  "text": "\"둘이 다투는 소리도 들었단 말이오.\"",
  "sec": 3.731
 },
 {
  "num": "076",
  "scene": "S13",
  "text": "분이는 그날 밤 집에서 시어머니 약을 달이고 있었어요.",
  "sec": 6.411
 },
 {
  "num": "077",
  "scene": "S13",
  "text": "그런데 그걸 본 사람이 시어머니뿐이었습니다.",
  "sec": 4.771
 },
 {
  "num": "078",
  "scene": "S13",
  "text": "그 시어머니는 아들을 잃고 넋이 나가 있었고요.",
  "sec": 5.451
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "관아에서 사람이 나왔습니다.",
  "sec": 3.251
 },
 {
  "num": "080",
  "scene": "S14",
  "text": "분이를 끌고 갔어요.",
  "sec": 2.971
 },
 {
  "num": "081",
  "scene": "S14",
  "text": "남편을 죽인 아내는 그 시절 가장 큰 죄였습니다.",
  "sec": 6.611
 },
 {
  "num": "082",
  "scene": "S14",
  "text": "죄가 드러나면 목숨을 내놓아야 했지요.",
  "sec": 4.771
 },
 {
  "num": "083",
  "scene": "S15",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 6.131
 },
 {
  "num": "084",
  "scene": "S16",
  "text": "만복이 어머니가 정신을 차리고 한 말이 있었어요.",
  "sec": 5.331
 },
 {
  "num": "085",
  "scene": "S16",
  "text": "\"내 아들 넋을 불러 직접 물어보겠다.\"",
  "sec": 4.851
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "그래서 월선이를 불렀습니다.",
  "sec": 3.531
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "넋건지기굿을 해서 아들 넋을 불러내겠다는 거였지요.",
  "sec": 5.451
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "마을 사람들도 그러자 했어요.",
  "sec": 2.971
 },
 {
  "num": "089",
  "scene": "S16",
  "text": "넋이 직접 말하면 누가 죽였는지 알 거라고요.",
  "sec": 5.771
 },
 {
  "num": "090",
  "scene": "S17",
  "text": "굿 전날 밤, 칠복이가 월선이 집에 찾아왔습니다.",
  "sec": 6.091
 },
 {
  "num": "091",
  "scene": "S17",
  "text": "엽전 꾸러미를 내밀었어요.",
  "sec": 3.451
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "열 냥이었습니다.",
  "sec": 2.091
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "\"굿판에서 넋이 들리거든 말이오.\"",
  "sec": 4.571
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "\"형수가 밀었다고 한마디만 해 주시오.\"",
  "sec": 4.811
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "\"무당 말이야 넋 말이니, 아무도 따지지 않을 것이오.\"",
  "sec": 5.611
 },
 {
  "num": "096",
  "scene": "S18",
  "text": "월선이가 그 돈을 한참 내려다봤어요.",
  "sec": 4.891
 },
 {
  "num": "097",
  "scene": "S18",
  "text": "그러고는 받았습니다.",
  "sec": 2.531
 },
 {
  "num": "098",
  "scene": "S18",
  "text": "칠복이가 웃으며 돌아갔지요.",
  "sec": 4.011
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "허허, 받았답니다.",
  "sec": 3.051
 },
 {
  "num": "100",
  "scene": "S18",
  "text": "그 돈을 왜 받았는지는 조금 있다가 말씀드리리다.",
  "sec": 5.451
 },
 {
  "num": "101",
  "scene": "S19",
  "text": "월선이는 굿을 하기 전에 늘 하는 일이 있었어요.",
  "sec": 4.691
 },
 {
  "num": "102",
  "scene": "S19",
  "text": "죽은 사람이 어떤 사람이었는지 묻고 다니는 겁니다.",
  "sec": 5.411
 },
 {
  "num": "103",
  "scene": "S19",
  "text": "무엇을 좋아했는지, 말버릇이 어땠는지요.",
  "sec": 5.091
 },
 {
  "num": "104",
  "scene": "S19",
  "text": "넋을 불러 그 사람 목소리로 말하려면 알아야 하니까요.",
  "sec": 5.691
 },
 {
  "num": "105",
  "scene": "S19",
  "text": "그날도 분이네 집에 가서 물었습니다.",
  "sec": 3.291
 },
 {
  "num": "106",
  "scene": "S19",
  "text": "만복이 어머니가 울면서 아들 이야기를 했어요.",
  "sec": 5.491
 },
 {
  "num": "107",
  "scene": "S19",
  "text": "그날 밤 며느리가 제 곁에서 약을 달였다는 말도요.",
  "sec": 5.771
 },
 {
  "num": "108",
  "scene": "S20",
  "text": "그다음에 월선이가 개울에 나갔습니다.",
  "sec": 4.651
 },
 {
  "num": "109",
  "scene": "S20",
  "text": "넋건지기굿은 넋이 빠진 자리에서 해야 하거든요.",
  "sec": 5.411
 },
 {
  "num": "110",
  "scene": "S20",
  "text": "칠복이 말로는 징검다리였지요.",
  "sec": 4.451
 },
 {
  "num": "111",
  "scene": "S20",
  "text": "월선이가 징검다리 위에 섰습니다.",
  "sec": 3.691
 },
 {
  "num": "112",
  "scene": "S20",
  "text": "그리고 물을 내려다봤어요.",
  "sec": 2.971
 },
 {
  "num": "113",
  "scene": "S21",
  "text": "그런데 월선이 눈이 위쪽으로 갔습니다.",
  "sec": 4.491
 },
 {
  "num": "114",
  "scene": "S21",
  "text": "만복이가 떠오른 소는 징검다리보다 위에 있었어요.",
  "sec": 5.971
 },
 {
  "num": "115",
  "scene": "S21",
  "text": "개울이 굽이도는 자리, 징검다리에서 백 걸음쯤 올라간 곳이었지요.",
  "sec": 6.891
 },
 {
  "num": "116",
  "scene": "S21",
  "text": "월선이가 짚신을 벗고 물에 발을 담갔습니다.",
  "sec": 6.091
 },
 {
  "num": "117",
  "scene": "S21",
  "text": "물이 발목을 감고 아래로 흘렀어요.",
  "sec": 5.491
 },
 {
  "num": "118",
  "scene": "S21",
  "text": "서른 해를 담가 본 물이었지요.",
  "sec": 3.091
 },
 {
  "num": "119",
  "scene": "S22",
  "text": "허허, 여기가 중요하오.",
  "sec": 3.131
 },
 {
  "num": "120",
  "scene": "S22",
  "text": "징검다리에서 빠진 사람이 어떻게 위쪽 소에서 떠오르겠습니까.",
  "sec": 6.291
 },
 {
  "num": "121",
  "scene": "S23",
  "text": "물은 아래로만 흐릅니다.",
  "sec": 3.051
 },
 {
  "num": "122",
  "scene": "S23",
  "text": "징검다리에서 빠졌으면 아래로 쓸려 가야 해요.",
  "sec": 4.971
 },
 {
  "num": "123",
  "scene": "S23",
  "text": "위로 백 걸음을 거슬러 올라갈 수는 없습니다.",
  "sec": 5.611
 },
 {
  "num": "124",
  "scene": "S23",
  "text": "그러니 만복이는 징검다리에서 빠진 게 아니었어요.",
  "sec": 6.451
 },
 {
  "num": "125",
  "scene": "S23",
  "text": "처음부터 소에 빠진 겁니다.",
  "sec": 3.211
 },
 {
  "num": "126",
  "scene": "S23",
  "text": "그런데 징검다리라고 말한 사람이 누구였지요.",
  "sec": 5.051
 },
 {
  "num": "127",
  "scene": "S23",
  "text": "칠복이 하나뿐이었습니다.",
  "sec": 2.971
 },
 {
  "num": "128",
  "scene": "S24",
  "text": "월선이가 소 쪽으로 걸어 올라갔어요.",
  "sec": 4.371
 },
 {
  "num": "129",
  "scene": "S24",
  "text": "소 옆으로 좁은 길이 하나 나 있었습니다.",
  "sec": 4.931
 },
 {
  "num": "130",
  "scene": "S24",
  "text": "마을로 바로 들어가는 길이 아니었어요.",
  "sec": 3.731
 },
 {
  "num": "131",
  "scene": "S24",
  "text": "칠복이 집 뒤로 이어지는 길이었지요.",
  "sec": 3.731
 },
 {
  "num": "132",
  "scene": "S24",
  "text": "월선이가 그 자리에 오래 서 있었습니다.",
  "sec": 4.531
 },
 {
  "num": "133",
  "scene": "S25",
  "text": "그런데 이걸 누구한테 말하겠습니까.",
  "sec": 4.171
 },
 {
  "num": "134",
  "scene": "S25",
  "text": "무녀 말을 사또가 들어 주겠어요.",
  "sec": 3.451
 },
 {
  "num": "135",
  "scene": "S25",
  "text": "굿판 밖에서 하는 무당 말은 그냥 천것의 말입니다.",
  "sec": 5.251
 },
 {
  "num": "136",
  "scene": "S25",
  "text": "칠복이는 무당이 지어낸다고 하면 그만이고요.",
  "sec": 5.651
 },
 {
  "num": "137",
  "scene": "S25",
  "text": "게다가 칠복이가 준 돈이 월선이 손에 있었습니다.",
  "sec": 5.091
 },
 {
  "num": "138",
  "scene": "S25",
  "text": "돈 받고 꾸민 말이라고 몰리면 월선이 목이 먼저 날아갈 판이었지요.",
  "sec": 7.371
 },
 {
  "num": "139",
  "scene": "S26",
  "text": "월선이가 그날 밤 잠을 못 잤어요.",
  "sec": 4.091
 },
 {
  "num": "140",
  "scene": "S26",
  "text": "그러다 하나를 떠올렸습니다.",
  "sec": 2.971
 },
 {
  "num": "141",
  "scene": "S26",
  "text": "사람들이 무녀 말을 안 듣는 건 굿판 밖에서뿐이라는 걸요.",
  "sec": 6.411
 },
 {
  "num": "142",
  "scene": "S26",
  "text": "굿판 안에서는 다릅니다.",
  "sec": 3.251
 },
 {
  "num": "143",
  "scene": "S26",
  "text": "넋이 들린 무녀가 하는 말은 아무도 못 막아요.",
  "sec": 4.691
 },
 {
  "num": "144",
  "scene": "S26",
  "text": "산 사람 말이 아니라 죽은 사람 말이니까요.",
  "sec": 4.771
 },
 {
  "num": "145",
  "scene": "S27",
  "text": "이튿날 개울가에 굿판이 벌어졌습니다.",
  "sec": 4.851
 },
 {
  "num": "146",
  "scene": "S27",
  "text": "온 마을 사람이 다 나왔어요.",
  "sec": 4.171
 },
 {
  "num": "147",
  "scene": "S27",
  "text": "관아에서도 아전이 둘 나와 지켜봤습니다.",
  "sec": 4.291
 },
 {
  "num": "148",
  "scene": "S27",
  "text": "분이도 오랏줄에 묶인 채 끌려 나왔고요.",
  "sec": 4.651
 },
 {
  "num": "149",
  "scene": "S27",
  "text": "칠복이는 맨 앞자리에 앉았어요.",
  "sec": 4.371
 },
 {
  "num": "150",
  "scene": "S28",
  "text": "장구가 울리고 징이 울렸습니다.",
  "sec": 4.371
 },
 {
  "num": "151",
  "scene": "S28",
  "text": "월선이가 방울을 흔들며 돌기 시작했어요.",
  "sec": 4.931
 },
 {
  "num": "152",
  "scene": "S28",
  "text": "넋 그릇을 징검다리에서 물에 띄웠습니다.",
  "sec": 4.531
 },
 {
  "num": "153",
  "scene": "S28",
  "text": "그 그릇이 아래로, 아래로 흘러갔지요.",
  "sec": 5.611
 },
 {
  "num": "154",
  "scene": "S28",
  "text": "사람들은 그게 무슨 뜻인지 몰랐어요.",
  "sec": 4.091
 },
 {
  "num": "155",
  "scene": "S28",
  "text": "월선이만 그걸 보고 있었습니다.",
  "sec": 3.011
 },
 {
  "num": "156",
  "scene": "S29",
  "text": "한참을 돌던 월선이가 갑자기 멈췄어요.",
  "sec": 4.731
 },
 {
  "num": "157",
  "scene": "S29",
  "text": "몸이 떨리기 시작했습니다.",
  "sec": 3.491
 },
 {
  "num": "158",
  "scene": "S29",
  "text": "목소리가 바뀌었어요.",
  "sec": 2.731
 },
 {
  "num": "159",
  "scene": "S29",
  "text": "굵은 사내 목소리였지요.",
  "sec": 2.651
 },
 {
  "num": "160",
  "scene": "S29",
  "text": "만복이 어머니가 소리를 질렀습니다.",
  "sec": 3.651
 },
 {
  "num": "161",
  "scene": "S29",
  "text": "\"우리 만복이 목소리다!\"",
  "sec": 2.531
 },
 {
  "num": "162",
  "scene": "S30",
  "text": "넋이 들린 월선이가 분이를 봤어요.",
  "sec": 5.091
 },
 {
  "num": "163",
  "scene": "S30",
  "text": "칠복이가 몸을 앞으로 내밀었습니다.",
  "sec": 5.131
 },
 {
  "num": "164",
  "scene": "S30",
  "text": "이제 분이 이름이 나올 차례였으니까요.",
  "sec": 3.731
 },
 {
  "num": "165",
  "scene": "S30",
  "text": "그런데 월선이 입에서 나온 말은 이랬습니다.",
  "sec": 4.731
 },
 {
  "num": "166",
  "scene": "S30",
  "text": "\"분이야, 너는 그날 밤 어머니 약을 달였지.\"",
  "sec": 5.651
 },
 {
  "num": "167",
  "scene": "S30",
  "text": "\"내가 다 안다.\"",
  "sec": 2.451
 },
 {
  "num": "168",
  "scene": "S31",
  "text": "칠복이 얼굴이 하얘졌어요.",
  "sec": 3.891
 },
 {
  "num": "169",
  "scene": "S31",
  "text": "월선이가 천천히 돌아섰습니다.",
  "sec": 3.571
 },
 {
  "num": "170",
  "scene": "S31",
  "text": "그리고 칠복이를 손가락으로 가리켰어요.",
  "sec": 4.491
 },
 {
  "num": "171",
  "scene": "S31",
  "text": "\"칠복아.\"",
  "sec": 2.091
 },
 {
  "num": "172",
  "scene": "S31",
  "text": "\"너는 나를 징검다리에서 잃었다고 했지.\"",
  "sec": 4.731
 },
 {
  "num": "173",
  "scene": "S31",
  "text": "\"나는 징검다리에 간 적이 없다.\"",
  "sec": 4.051
 },
 {
  "num": "174",
  "scene": "S32",
  "text": "\"나는 소에서 빠졌다.\"",
  "sec": 3.291
 },
 {
  "num": "175",
  "scene": "S32",
  "text": "\"네 집 뒤로 난 그 길에서 말이다.\"",
  "sec": 4.371
 },
 {
  "num": "176",
  "scene": "S32",
  "text": "\"칠복아, 내 소 판 돈 쉰 냥은 어디 두었느냐.\"",
  "sec": 6.211
 },
 {
  "num": "177",
  "scene": "S32",
  "text": "굿판이 쥐 죽은 듯 조용해졌습니다.",
  "sec": 4.291
 },
 {
  "num": "178",
  "scene": "S33",
  "text": "월선이가 품에서 엽전 꾸러미를 꺼냈어요.",
  "sec": 4.411
 },
 {
  "num": "179",
  "scene": "S33",
  "text": "그걸 칠복이 앞에 던졌습니다.",
  "sec": 4.251
 },
 {
  "num": "180",
  "scene": "S33",
  "text": "\"이건 네가 어젯밤 무녀한테 준 돈이다.\"",
  "sec": 4.891
 },
 {
  "num": "181",
  "scene": "S33",
  "text": "\"분이 이름을 대라고 준 돈이지.\"",
  "sec": 4.531
 },
 {
  "num": "182",
  "scene": "S33",
  "text": "사람들 눈이 일제히 칠복이한테 갔어요.",
  "sec": 5.611
 },
 {
  "num": "183",
  "scene": "S33",
  "text": "칠복이가 벌떡 일어나 도망쳤습니다.",
  "sec": 4.971
 },
 {
  "num": "184",
  "scene": "S34",
  "text": "아전 둘이 쫓아가 붙잡았어요.",
  "sec": 4.091
 },
 {
  "num": "185",
  "scene": "S34",
  "text": "도망친 게 곧 자백이나 마찬가지였지요.",
  "sec": 4.131
 },
 {
  "num": "186",
  "scene": "S34",
  "text": "허허, 죄 없는 사람은 굿판에서 도망칠 일이 없으니까요.",
  "sec": 5.931
 },
 {
  "num": "187",
  "scene": "S35",
  "text": "일이 이렇게 됐으니 사또 앞으로 갔습니다.",
  "sec": 4.571
 },
 {
  "num": "188",
  "scene": "S35",
  "text": "칠복이는 끝까지 우겼어요.",
  "sec": 3.331
 },
 {
  "num": "189",
  "scene": "S35",
  "text": "\"무당이 지어낸 말입니다.\"",
  "sec": 2.891
 },
 {
  "num": "190",
  "scene": "S35",
  "text": "\"귀신 말로 사람을 잡으시겠습니까.\"",
  "sec": 4.251
 },
 {
  "num": "191",
  "scene": "S35",
  "text": "아전들도 고개를 끄덕였습니다.",
  "sec": 3.651
 },
 {
  "num": "192",
  "scene": "S35",
  "text": "굿판 말을 증거로 삼을 수는 없었으니까요.",
  "sec": 4.691
 },
 {
  "num": "193",
  "scene": "S36",
  "text": "사또가 월선이를 불렀어요.",
  "sec": 3.931
 },
 {
  "num": "194",
  "scene": "S36",
  "text": "\"네가 정말 넋을 보았느냐.\"",
  "sec": 4.131
 },
 {
  "num": "195",
  "scene": "S36",
  "text": "월선이가 엎드린 채로 말했습니다.",
  "sec": 3.931
 },
 {
  "num": "196",
  "scene": "S36",
  "text": "\"소인은 넋을 보지 못했습니다.\"",
  "sec": 4.011
 },
 {
  "num": "197",
  "scene": "S36",
  "text": "아전들이 웅성거렸어요.",
  "sec": 2.971
 },
 {
  "num": "198",
  "scene": "S36",
  "text": "무녀가 제 입으로 그렇게 말한 겁니다.",
  "sec": 4.051
 },
 {
  "num": "199",
  "scene": "S37",
  "text": "\"다만 물을 보았습니다.\"",
  "sec": 3.211
 },
 {
  "num": "200",
  "scene": "S37",
  "text": "\"물은 거꾸로 흐르지 않습니다.\"",
  "sec": 3.771
 },
 {
  "num": "201",
  "scene": "S37",
  "text": "\"징검다리에서 빠진 사람은 아래로 쓸려 갑니다.\"",
  "sec": 6.851
 },
 {
  "num": "202",
  "scene": "S37",
  "text": "\"그런데 만복이는 백 걸음 위쪽 소에서 떠올랐습니다.\"",
  "sec": 6.211
 },
 {
  "num": "203",
  "scene": "S37",
  "text": "\"그러니 처음부터 소에 빠진 것입니다.\"",
  "sec": 4.211
 },
 {
  "num": "204",
  "scene": "S37",
  "text": "\"징검다리라고 한 사람은 칠복이 하나뿐입니다.\"",
  "sec": 4.691
 },
 {
  "num": "205",
  "scene": "S38",
  "text": "\"그리고 소 옆길은 칠복이 집 뒤로 납니다.\"",
  "sec": 5.131
 },
 {
  "num": "206",
  "scene": "S38",
  "text": "\"그날 밤 두 사람이 그 길로 갔다면, 칠복이 집으로 간 것입니다.\"",
  "sec": 8.891
 },
 {
  "num": "207",
  "scene": "S38",
  "text": "사또가 한참을 생각했어요.",
  "sec": 3.731
 },
 {
  "num": "208",
  "scene": "S38",
  "text": "그러고는 일어섰습니다.",
  "sec": 2.971
 },
 {
  "num": "209",
  "scene": "S38",
  "text": "\"개울로 가자.\"",
  "sec": 2.251
 },
 {
  "num": "210",
  "scene": "S39",
  "text": "사또가 징검다리 위에 섰습니다.",
  "sec": 3.811
 },
 {
  "num": "211",
  "scene": "S39",
  "text": "박 바가지 하나를 물에 띄우라고 했어요.",
  "sec": 4.451
 },
 {
  "num": "212",
  "scene": "S39",
  "text": "바가지가 아래로 흘러갔습니다.",
  "sec": 3.771
 },
 {
  "num": "213",
  "scene": "S39",
  "text": "한 번 더 띄웠어요.",
  "sec": 3.211
 },
 {
  "num": "214",
  "scene": "S39",
  "text": "또 아래로 흘러갔지요.",
  "sec": 3.051
 },
 {
  "num": "215",
  "scene": "S39",
  "text": "열 번을 띄워도 한 번을 위로 안 올라갔습니다.",
  "sec": 4.811
 },
 {
  "num": "216",
  "scene": "S40",
  "text": "사또가 칠복이 집을 뒤지라고 했어요.",
  "sec": 4.131
 },
 {
  "num": "217",
  "scene": "S40",
  "text": "헛간 바닥을 파 보니 돈 꾸러미가 나왔습니다.",
  "sec": 5.571
 },
 {
  "num": "218",
  "scene": "S40",
  "text": "마흔 냥이었어요.",
  "sec": 2.291
 },
 {
  "num": "219",
  "scene": "S40",
  "text": "월선이한테 준 열 냥을 더하면 꼭 쉰 냥이었지요.",
  "sec": 5.931
 },
 {
  "num": "220",
  "scene": "S40",
  "text": "칠복이가 그제야 무릎을 꿇었습니다.",
  "sec": 5.931
 },
 {
  "num": "221",
  "scene": "S41",
  "text": "노름빚에 쫓기고 있었다고 했어요.",
  "sec": 2.971
 },
 {
  "num": "222",
  "scene": "S41",
  "text": "형님 품의 소 판 돈을 보고 눈이 뒤집혔다고요.",
  "sec": 5.931
 },
 {
  "num": "223",
  "scene": "S41",
  "text": "술 취한 형님을 제 집 뒷길로 데려가다가요.",
  "sec": 5.291
 },
 {
  "num": "224",
  "scene": "S41",
  "text": "소 옆에서 밀었다고 했습니다.",
  "sec": 3.491
 },
 {
  "num": "225",
  "scene": "S41",
  "text": "그러고는 징검다리라고 둘러댄 겁니다.",
  "sec": 3.971
 },
 {
  "num": "226",
  "scene": "S41",
  "text": "늘 다니는 길이라고 해야 아무도 의심을 안 하니까요.",
  "sec": 5.331
 },
 {
  "num": "227",
  "scene": "S41",
  "text": "형수한테 뒤집어씌울 생각까지 하면서요.",
  "sec": 4.051
 },
 {
  "num": "228",
  "scene": "S42",
  "text": "분이가 풀려났습니다.",
  "sec": 3.131
 },
 {
  "num": "229",
  "scene": "S42",
  "text": "시어머니가 분이를 붙들고 울었어요.",
  "sec": 4.291
 },
 {
  "num": "230",
  "scene": "S42",
  "text": "\"내가 너를 의심했구나.\"",
  "sec": 3.571
 },
 {
  "num": "231",
  "scene": "S42",
  "text": "분이가 시어머니를 안았습니다.",
  "sec": 3.731
 },
 {
  "num": "232",
  "scene": "S42",
  "text": "둘이 한참을 그렇게 울었다고 해요.",
  "sec": 3.971
 },
 {
  "num": "233",
  "scene": "S43",
  "text": "그런데 마을에는 이런 말이 돌았습니다.",
  "sec": 5.811
 },
 {
  "num": "234",
  "scene": "S43",
  "text": "만복이 넋이 무녀 몸을 빌려 살인자를 잡았다고요.",
  "sec": 5.251
 },
 {
  "num": "235",
  "scene": "S43",
  "text": "사또 앞에서 한 말은 아무도 몰랐어요.",
  "sec": 3.971
 },
 {
  "num": "236",
  "scene": "S43",
  "text": "사또가 월선이한테 물었습니다.",
  "sec": 3.651
 },
 {
  "num": "237",
  "scene": "S43",
  "text": "\"사람들한테 사실대로 말해 주랴.\"",
  "sec": 3.771
 },
 {
  "num": "238",
  "scene": "S43",
  "text": "월선이가 고개를 저었어요.",
  "sec": 3.131
 },
 {
  "num": "239",
  "scene": "S44",
  "text": "\"그냥 넋이 했다고 두십시오.\"",
  "sec": 3.611
 },
 {
  "num": "240",
  "scene": "S44",
  "text": "\"그래야 다음에 누가 나쁜 마음을 먹어도요.\"",
  "sec": 4.851
 },
 {
  "num": "241",
  "scene": "S44",
  "text": "\"넋이 본다고 겁을 낼 것 아닙니까.\"",
  "sec": 4.211
 },
 {
  "num": "242",
  "scene": "S44",
  "text": "사또가 껄껄 웃었습니다.",
  "sec": 3.211
 },
 {
  "num": "243",
  "scene": "S44",
  "text": "그러고는 쌀 열 섬을 내렸어요.",
  "sec": 3.371
 },
 {
  "num": "244",
  "scene": "S45",
  "text": "월선이는 그 쌀을 분이네로 보냈습니다.",
  "sec": 5.571
 },
 {
  "num": "245",
  "scene": "S45",
  "text": "남편 잃은 집에 먹을 게 있어야 한다고요.",
  "sec": 4.211
 },
 {
  "num": "246",
  "scene": "S45",
  "text": "그 뒤로 마을 사람들이 월선이를 대하는 게 달라졌어요.",
  "sec": 5.811
 },
 {
  "num": "247",
  "scene": "S45",
  "text": "길에서 마주치면 먼저 고개를 숙였답니다.",
  "sec": 4.531
 },
 {
  "num": "248",
  "scene": "S45",
  "text": "침을 뱉던 사람들이 말이지요.",
  "sec": 3.971
 },
 {
  "num": "249",
  "scene": "S46",
  "text": "분이는 해마다 만복이 기일이면 월선이를 불렀어요.",
  "sec": 5.411
 },
 {
  "num": "250",
  "scene": "S46",
  "text": "굿을 하자는 게 아니었습니다.",
  "sec": 2.971
 },
 {
  "num": "251",
  "scene": "S46",
  "text": "같이 개울가에 앉아 있자는 거였지요.",
  "sec": 3.731
 },
 {
  "num": "252",
  "scene": "S46",
  "text": "둘이 말없이 물을 보다 돌아왔답니다.",
  "sec": 5.411
 },
 {
  "num": "253",
  "scene": "S46",
  "text": "월선이는 일흔까지 그 마을에서 살았다고 해요.",
  "sec": 4.891
 },
 {
  "num": "254",
  "scene": "S47",
  "text": "허허, 어떻습니까.",
  "sec": 2.731
 },
 {
  "num": "255",
  "scene": "S47",
  "text": "온 마을 사람이 그 개울을 날마다 건넜지요.",
  "sec": 6.451
 },
 {
  "num": "256",
  "scene": "S47",
  "text": "물이 아래로 흐르는 걸 모르는 사람은 하나도 없었습니다.",
  "sec": 6.611
 },
 {
  "num": "257",
  "scene": "S47",
  "text": "그런데 아무도 그걸 맞춰 보지 않았어요.",
  "sec": 4.091
 },
 {
  "num": "258",
  "scene": "S48",
  "text": "그런데 말이오.",
  "sec": 1.931
 },
 {
  "num": "259",
  "scene": "S48",
  "text": "월선이는 그걸 어떻게 알았겠습니까.",
  "sec": 3.691
 },
 {
  "num": "260",
  "scene": "S48",
  "text": "서른 해를 그 물에 넋을 건지러 들어갔으니 안 겁니다.",
  "sec": 5.851
 },
 {
  "num": "261",
  "scene": "S48",
  "text": "남들이 천하다고 침을 뱉던 그 일을 하면서요.",
  "sec": 4.691
 },
 {
  "num": "262",
  "scene": "S48",
  "text": "사람을 낮춰 보면 그 사람이 아는 것까지 낮아 보이는 모양입니다.",
  "sec": 7.011
 },
 {
  "num": "263",
  "scene": "S48",
  "text": "아는 것에 무슨 귀천이 있겠습니까.",
  "sec": 4.251
 },
 {
  "num": "264",
  "scene": "S49",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 5.571
 },
 {
  "num": "265",
  "scene": "S49",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 6.451
 }
]