[
 {
  "num": "001",
  "scene": "S01",
  "text": "삼십 년 남의 주검만 씻기던 사람이, 손톱 하나로 살인범을 바꿔 놓았습니다.",
  "sec": 7.171
 },
 {
  "num": "002",
  "scene": "S02",
  "text": "평생 마당에서 품삯을 받던 염쟁이가, 그날 처음 관아 마당에 섰지요.",
  "sec": 7.691
 },
 {
  "num": "003",
  "scene": "S02",
  "text": "\"이 사람은 물에 빠져 죽은 게 아닙니다.\"",
  "sec": 4.051
 },
 {
  "num": "004",
  "scene": "S03",
  "text": "허허, 허허서방이올시다. 그 염쟁이 이야기, 부채 한 번 치고 들려드리리다. 탁!",
  "sec": 9.211
 },
 {
  "num": "005",
  "scene": "S04",
  "text": "그 사람 이름은 덕배, 전라도 어느 고을에서 죽은 이를 씻기던 사람이었습니다.",
  "sec": 8.371
 },
 {
  "num": "006",
  "scene": "S04",
  "text": "염쟁이라고들 불렀지요.",
  "sec": 2.491
 },
 {
  "num": "007",
  "scene": "S04",
  "text": "사람이 죽으면 몸을 씻기고 옷을 입혀 관에 뉘는 일입니다.",
  "sec": 7.211
 },
 {
  "num": "008",
  "scene": "S04",
  "text": "열일곱에 아비를 따라 시작해 삼십 년을 했습니다.",
  "sec": 5.771
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "그 고을에서 죽은 사람은 거의 다 그 손을 거쳤어요.",
  "sec": 7.011
 },
 {
  "num": "010",
  "scene": "S04",
  "text": "양반도 거쳤고 머슴도 거쳤습니다.",
  "sec": 4.371
 },
 {
  "num": "011",
  "scene": "S04",
  "text": "죽고 나면 다 같아진다고, 덕배는 그렇게 말했지요.",
  "sec": 5.651
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "그런데 그 일로 먹고사는 사람은 대접이 없었습니다.",
  "sec": 5.691
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "품삯은 고을에서 제일 쌌어요.",
  "sec": 5.091
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "받을 때도 마당에서 받았지, 방에는 못 들어갔습니다.",
  "sec": 5.331
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "밥상도 따로 받았고요.",
  "sec": 2.811
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "잔칫집에는 아예 부르지 않았어요.",
  "sec": 4.051
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "\"죽은 사람 만진 손\"이라고들 했거든요.",
  "sec": 4.611
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "덕배는 그 말에 대꾸한 적이 없습니다.",
  "sec": 3.891
 },
 {
  "num": "019",
  "scene": "S06",
  "text": "그 손이 하루에 몇 번씩 씻겼습니다.",
  "sec": 4.771
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "찬물로 씻고 또 씻었어요.",
  "sec": 4.091
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "그래도 사람들은 그 손을 안 잡았지요.",
  "sec": 4.851
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "장에 가면 엽전을 바닥에 놓고 갔습니다.",
  "sec": 4.811
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "손에서 손으로 주고받지를 않았어요.",
  "sec": 4.171
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "덕배는 그것도 그러려니 했습니다.",
  "sec": 4.171
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "삼십 년이면 그러려니가 됩니다.",
  "sec": 3.931
 },
 {
  "num": "026",
  "scene": "S07",
  "text": "그런데 덕배는 아는 게 있었어요.",
  "sec": 4.491
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "주검은 말을 한다는 겁니다.",
  "sec": 3.811
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "앓다 간 사람은 등에 자국이 남습니다.",
  "sec": 4.371
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "오래 누워 있던 자리가 눌려서 그래요.",
  "sec": 4.331
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "추위에 간 사람은 손가락이 안 펴집니다.",
  "sec": 4.171
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "굶어 간 사람은 배가 아니라 목이 먼저 줄어요.",
  "sec": 5.531
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "맞아 간 사람은 멍이 겉이 아니라 속에 듭니다.",
  "sec": 5.811
 },
 {
  "num": "033",
  "scene": "S08",
  "text": "물에 빠져 간 사람은요.",
  "sec": 3.051
 },
 {
  "num": "034",
  "scene": "S08",
  "text": "손톱 밑에 모래가 낍니다.",
  "sec": 3.171
 },
 {
  "num": "035",
  "scene": "S08",
  "text": "숨이 막히면 사람은 허우적댑니다.",
  "sec": 5.011
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "바닥이든 풀이든 뭐든 움켜쥐어요.",
  "sec": 4.411
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "그게 손톱 밑에 그대로 남습니다.",
  "sec": 4.211
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "입과 코에는 허연 거품이 맺히고요.",
  "sec": 4.411
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "삼십 년을 씻기면 그게 눈에 들어옵니다.",
  "sec": 4.731
 },
 {
  "num": "040",
  "scene": "S09",
  "text": "덕배는 그걸 입 밖에 낸 적이 없었습니다.",
  "sec": 4.051
 },
 {
  "num": "041",
  "scene": "S09",
  "text": "염쟁이가 주검 이야기를 하고 다니면 어찌 되겠습니까.",
  "sec": 5.051
 },
 {
  "num": "042",
  "scene": "S09",
  "text": "그 집 식구들 가슴에 못을 박는 일이지요.",
  "sec": 4.251
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "그래서 알고도 다물었습니다.",
  "sec": 3.371
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "삼십 년을 그렇게 다물었어요.",
  "sec": 3.891
 },
 {
  "num": "045",
  "scene": "S10",
  "text": "그해 여름이었어요.",
  "sec": 2.291
 },
 {
  "num": "046",
  "scene": "S10",
  "text": "새벽에 강에서 사람이 떠올랐습니다.",
  "sec": 4.691
 },
 {
  "num": "047",
  "scene": "S10",
  "text": "스물 몇 살 먹은 젊은 사내였어요.",
  "sec": 4.371
 },
 {
  "num": "048",
  "scene": "S10",
  "text": "고을에서 모르는 사람이 없는 얼굴이었지요.",
  "sec": 4.331
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "돈을 꿔 주고 이자를 받는 집 아들이었거든요.",
  "sec": 6.051
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "제 아비 대신 빚을 받으러 다니던 사람이었습니다.",
  "sec": 4.771
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "그러니 미워하는 사람이 한둘이 아니었어요.",
  "sec": 4.491
 },
 {
  "num": "052",
  "scene": "S11",
  "text": "전날 밤 주막에서 소란이 있었습니다.",
  "sec": 3.851
 },
 {
  "num": "053",
  "scene": "S11",
  "text": "그 사내와 주막집 아들이 멱살을 잡았어요.",
  "sec": 5.331
 },
 {
  "num": "054",
  "scene": "S11",
  "text": "빚 때문이었지요.",
  "sec": 1.811
 },
 {
  "num": "055",
  "scene": "S11",
  "text": "주막집도 그 집에 돈을 꾼 처지였거든요.",
  "sec": 4.731
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "말이 거칠어졌고 손이 올라갔습니다.",
  "sec": 5.691
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "주막에 있던 사람이 열이 넘었어요.",
  "sec": 5.371
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "다들 그 장면을 봤습니다.",
  "sec": 3.371
 },
 {
  "num": "059",
  "scene": "S12",
  "text": "그러니 이튿날 아침에 답이 정해졌어요.",
  "sec": 4.891
 },
 {
  "num": "060",
  "scene": "S12",
  "text": "주막집 아들이 그날로 끌려갔습니다.",
  "sec": 3.851
 },
 {
  "num": "061",
  "scene": "S12",
  "text": "이름은 수철이라 했어요.",
  "sec": 2.731
 },
 {
  "num": "062",
  "scene": "S12",
  "text": "스물둘이었습니다.",
  "sec": 2.451
 },
 {
  "num": "063",
  "scene": "S12",
  "text": "열 사람이 봤다는데 무슨 말이 더 필요하겠습니까.",
  "sec": 4.651
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "수철이는 아니라고 했어요.",
  "sec": 3.331
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "그런데 아무도 안 들었습니다.",
  "sec": 3.851
 },
 {
  "num": "066",
  "scene": "S13",
  "text": "주막집 어미가 관아 앞에서 사흘을 빌었어요.",
  "sec": 5.331
 },
 {
  "num": "067",
  "scene": "S13",
  "text": "문지기가 들여보내 주지를 않았습니다.",
  "sec": 3.331
 },
 {
  "num": "068",
  "scene": "S13",
  "text": "없는 집 아들 일에 누가 나서겠습니까.",
  "sec": 4.531
 },
 {
  "num": "069",
  "scene": "S13",
  "text": "빚 준 집은 고을에서 힘이 있었고요.",
  "sec": 4.051
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "한번 말이 돌면 그게 사실이 되던 시절입니다.",
  "sec": 5.731
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "장에서도 그 이야기뿐이었어요.",
  "sec": 3.571
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "\"주막집 아들이 사람을 죽였다더라.\"",
  "sec": 3.931
 },
 {
  "num": "073",
  "scene": "S14",
  "text": "그 주검을 씻기는 일이 덕배한테 왔습니다.",
  "sec": 4.811
 },
 {
  "num": "074",
  "scene": "S14",
  "text": "죽은 집에서 사람을 보냈어요.",
  "sec": 4.451
 },
 {
  "num": "075",
  "scene": "S14",
  "text": "돈은 넉넉히 주겠다고 했습니다.",
  "sec": 3.611
 },
 {
  "num": "076",
  "scene": "S14",
  "text": "그 집은 돈이 많았으니까요.",
  "sec": 3.211
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "덕배는 늘 하던 대로 보따리를 들고 갔어요.",
  "sec": 5.171
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "그날도 여느 날 같았습니다.",
  "sec": 3.211
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "처음에는요.",
  "sec": 1.451
 },
 {
  "num": "080",
  "scene": "S15",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 4.811
 },
 {
  "num": "081",
  "scene": "S15",
  "text": "덕배가 그 손을 들어 올렸을 때 말이오.",
  "sec": 4.091
 },
 {
  "num": "082",
  "scene": "S15",
  "text": "무엇을 봤겠습니까.",
  "sec": 2.851
 },
 {
  "num": "083",
  "scene": "S16",
  "text": "덕배가 손부터 씻겼습니다.",
  "sec": 3.811
 },
 {
  "num": "084",
  "scene": "S16",
  "text": "늘 손부터 하거든요.",
  "sec": 3.251
 },
 {
  "num": "085",
  "scene": "S16",
  "text": "제일 많이 일한 자리니까요.",
  "sec": 3.731
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "그런데 손을 들어 올린 덕배가 멈췄어요.",
  "sec": 5.011
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "손톱 밑이 깨끗했습니다.",
  "sec": 3.691
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "모래 한 알이 없었어요.",
  "sec": 2.411
 },
 {
  "num": "089",
  "scene": "S17",
  "text": "덕배가 등잔을 당겨 왔습니다.",
  "sec": 3.771
 },
 {
  "num": "090",
  "scene": "S17",
  "text": "열 손가락을 다 봤어요.",
  "sec": 3.211
 },
 {
  "num": "091",
  "scene": "S17",
  "text": "하나도 빠짐없이 깨끗했습니다.",
  "sec": 4.531
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "강바닥은 모래와 자갈이에요.",
  "sec": 4.211
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "물풀도 많고요.",
  "sec": 2.131
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "빠진 사람이 가만히 있을 리가 없지요.",
  "sec": 3.691
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "그런데 이 손은 아무것도 안 쥐었습니다.",
  "sec": 5.211
 },
 {
  "num": "096",
  "scene": "S18",
  "text": "덕배가 입과 코를 봤습니다.",
  "sec": 3.651
 },
 {
  "num": "097",
  "scene": "S18",
  "text": "거품이 없었어요.",
  "sec": 2.331
 },
 {
  "num": "098",
  "scene": "S18",
  "text": "물에 빠지면 숨이 막히면서 거품이 올라옵니다.",
  "sec": 6.931
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "하루가 지나도 입가에 허옇게 남아요.",
  "sec": 4.611
 },
 {
  "num": "100",
  "scene": "S18",
  "text": "그게 없었습니다.",
  "sec": 2.691
 },
 {
  "num": "101",
  "scene": "S18",
  "text": "덕배는 그 자리에 한참 앉아 있었어요.",
  "sec": 4.291
 },
 {
  "num": "102",
  "scene": "S19",
  "text": "덕배가 머리를 봤습니다.",
  "sec": 2.811
 },
 {
  "num": "103",
  "scene": "S19",
  "text": "뒤통수에 자국이 있었어요.",
  "sec": 3.091
 },
 {
  "num": "104",
  "scene": "S19",
  "text": "둥근 것에 맞은 자국이었습니다.",
  "sec": 3.851
 },
 {
  "num": "105",
  "scene": "S19",
  "text": "그런데 그 자리가 불룩하게 부풀어 있었어요.",
  "sec": 5.451
 },
 {
  "num": "106",
  "scene": "S19",
  "text": "그게 중요합니다.",
  "sec": 2.731
 },
 {
  "num": "107",
  "scene": "S19",
  "text": "죽은 뒤에 생긴 자국은 붓지 않거든요.",
  "sec": 4.691
 },
 {
  "num": "108",
  "scene": "S19",
  "text": "피가 돌지 않으니까요.",
  "sec": 3.171
 },
 {
  "num": "109",
  "scene": "S19",
  "text": "부풀었다는 건 살아 있을 때 맞았다는 뜻입니다.",
  "sec": 4.811
 },
 {
  "num": "110",
  "scene": "S20",
  "text": "덕배가 발바닥도 봤습니다.",
  "sec": 3.971
 },
 {
  "num": "111",
  "scene": "S20",
  "text": "깨끗했어요.",
  "sec": 1.891
 },
 {
  "num": "112",
  "scene": "S20",
  "text": "강가에서 끌려갔으면 발에 진흙이 묻습니다.",
  "sec": 4.891
 },
 {
  "num": "113",
  "scene": "S20",
  "text": "제 발로 걸어 들어갔어도 묻고요.",
  "sec": 4.051
 },
 {
  "num": "114",
  "scene": "S20",
  "text": "그런데 깨끗했어요.",
  "sec": 3.091
 },
 {
  "num": "115",
  "scene": "S20",
  "text": "누가 들어다 넣었다는 뜻입니다.",
  "sec": 3.251
 },
 {
  "num": "116",
  "scene": "S21",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 4.971
 },
 {
  "num": "117",
  "scene": "S22",
  "text": "덕배가 그날 밤 잠을 못 잤습니다.",
  "sec": 4.011
 },
 {
  "num": "118",
  "scene": "S22",
  "text": "말하면 어찌 되는지 알거든요.",
  "sec": 4.011
 },
 {
  "num": "119",
  "scene": "S22",
  "text": "염쟁이가 관아에 들어가 입을 열었다 해 보십시오.",
  "sec": 5.411
 },
 {
  "num": "120",
  "scene": "S22",
  "text": "그날로 부르는 집이 없어집니다.",
  "sec": 4.051
 },
 {
  "num": "121",
  "scene": "S22",
  "text": "죽은 사람 만지는 일도 결국 누가 불러 줘야 하는 일이에요.",
  "sec": 6.291
 },
 {
  "num": "122",
  "scene": "S22",
  "text": "덕배한테는 그게 전부였습니다.",
  "sec": 4.331
 },
 {
  "num": "123",
  "scene": "S22",
  "text": "쌀 한 되가 거기서 나왔거든요.",
  "sec": 3.691
 },
 {
  "num": "124",
  "scene": "S23",
  "text": "게다가 그 집은 고을에서 힘이 있었어요.",
  "sec": 5.251
 },
 {
  "num": "125",
  "scene": "S23",
  "text": "돈을 꿔 주는 집이었으니까요.",
  "sec": 2.891
 },
 {
  "num": "126",
  "scene": "S23",
  "text": "그 집 아들을 두고 다른 말을 하면 어찌 되겠습니까.",
  "sec": 5.291
 },
 {
  "num": "127",
  "scene": "S23",
  "text": "덕배 같은 사람 하나 없애는 건 쉬운 일이었습니다.",
  "sec": 5.251
 },
 {
  "num": "128",
  "scene": "S23",
  "text": "그래서 사흘을 앓았어요.",
  "sec": 2.931
 },
 {
  "num": "129",
  "scene": "S23",
  "text": "밥도 안 넘어갔습니다.",
  "sec": 3.051
 },
 {
  "num": "130",
  "scene": "S24",
  "text": "사흘째 되던 날이었어요.",
  "sec": 3.371
 },
 {
  "num": "131",
  "scene": "S24",
  "text": "비가 왔습니다.",
  "sec": 2.491
 },
 {
  "num": "132",
  "scene": "S24",
  "text": "덕배가 관아 앞을 지나는데 주막집 어미가 거기 있었어요.",
  "sec": 6.011
 },
 {
  "num": "133",
  "scene": "S24",
  "text": "비를 그대로 맞고 꿇어앉아 있었습니다.",
  "sec": 4.571
 },
 {
  "num": "134",
  "scene": "S24",
  "text": "사흘째 그 자리였어요.",
  "sec": 2.731
 },
 {
  "num": "135",
  "scene": "S24",
  "text": "덕배가 한참을 서서 봤습니다.",
  "sec": 3.731
 },
 {
  "num": "136",
  "scene": "S24",
  "text": "그러고는 집으로 돌아가 옷을 갈아입었어요.",
  "sec": 4.571
 },
 {
  "num": "137",
  "scene": "S25",
  "text": "덕배가 관아 문 앞에 섰습니다.",
  "sec": 3.771
 },
 {
  "num": "138",
  "scene": "S25",
  "text": "문지기가 막았어요.",
  "sec": 3.291
 },
 {
  "num": "139",
  "scene": "S25",
  "text": "\"무슨 일이냐.\"",
  "sec": 1.971
 },
 {
  "num": "140",
  "scene": "S25",
  "text": "덕배가 대답했습니다.",
  "sec": 3.251
 },
 {
  "num": "141",
  "scene": "S25",
  "text": "\"죽은 사람을 씻긴 사람입니다.\"",
  "sec": 3.811
 },
 {
  "num": "142",
  "scene": "S25",
  "text": "\"아뢸 것이 있습니다.\"",
  "sec": 2.491
 },
 {
  "num": "143",
  "scene": "S25",
  "text": "문지기가 한참을 망설이다 안에 들였어요.",
  "sec": 4.491
 },
 {
  "num": "144",
  "scene": "S25",
  "text": "덕배는 그때까지 관아 문턱을 넘어 본 적이 없었습니다.",
  "sec": 6.131
 },
 {
  "num": "145",
  "scene": "S26",
  "text": "사또 앞에 엎드려 덕배가 말했습니다.",
  "sec": 4.371
 },
 {
  "num": "146",
  "scene": "S26",
  "text": "\"그 사람은 물에 빠져 죽은 게 아닙니다.\"",
  "sec": 3.651
 },
 {
  "num": "147",
  "scene": "S26",
  "text": "\"죽어서 물에 넣어진 겁니다.\"",
  "sec": 3.211
 },
 {
  "num": "148",
  "scene": "S26",
  "text": "사또가 눈을 들었어요.",
  "sec": 3.411
 },
 {
  "num": "149",
  "scene": "S26",
  "text": "염쟁이가 그런 말을 한 건 처음이었거든요.",
  "sec": 4.291
 },
 {
  "num": "150",
  "scene": "S27",
  "text": "\"그게 무슨 소리냐.\"",
  "sec": 2.251
 },
 {
  "num": "151",
  "scene": "S27",
  "text": "덕배가 손을 들어 보였습니다.",
  "sec": 4.051
 },
 {
  "num": "152",
  "scene": "S27",
  "text": "제 손톱을 가리켰어요.",
  "sec": 2.771
 },
 {
  "num": "153",
  "scene": "S27",
  "text": "\"물에 빠지면 사람이 바닥을 움켜쥡니다.\"",
  "sec": 4.131
 },
 {
  "num": "154",
  "scene": "S27",
  "text": "\"손톱 밑에 모래가 박힙니다.\"",
  "sec": 4.051
 },
 {
  "num": "155",
  "scene": "S27",
  "text": "\"털어도 안 나오고 씻어야 나오는 모래입니다.\"",
  "sec": 4.691
 },
 {
  "num": "156",
  "scene": "S27",
  "text": "\"그 사람 손톱에는 그게 없었습니다.\"",
  "sec": 4.651
 },
 {
  "num": "157",
  "scene": "S28",
  "text": "\"입과 코에도 거품이 없었습니다.\"",
  "sec": 4.611
 },
 {
  "num": "158",
  "scene": "S28",
  "text": "\"물에 빠져 죽으면 반드시 남는 것입니다.\"",
  "sec": 4.731
 },
 {
  "num": "159",
  "scene": "S28",
  "text": "\"그러니 숨이 붙은 채로 물에 들어간 게 아닙니다.\"",
  "sec": 4.851
 },
 {
  "num": "160",
  "scene": "S28",
  "text": "사또가 아무 말도 안 했어요.",
  "sec": 4.611
 },
 {
  "num": "161",
  "scene": "S28",
  "text": "덕배가 말을 이었습니다.",
  "sec": 3.651
 },
 {
  "num": "162",
  "scene": "S29",
  "text": "\"뒤통수에 맞은 자국이 있습니다.\"",
  "sec": 3.571
 },
 {
  "num": "163",
  "scene": "S29",
  "text": "\"그런데 그 자리가 불룩하게 부풀어 있었습니다.\"",
  "sec": 5.011
 },
 {
  "num": "164",
  "scene": "S29",
  "text": "\"죽은 뒤에 생긴 자국은 붓지 않습니다.\"",
  "sec": 4.331
 },
 {
  "num": "165",
  "scene": "S29",
  "text": "\"피가 돌지 않으니까요.\"",
  "sec": 2.811
 },
 {
  "num": "166",
  "scene": "S29",
  "text": "\"부풀었다는 건 살아 있을 때 맞았다는 뜻입니다.\"",
  "sec": 4.731
 },
 {
  "num": "167",
  "scene": "S29",
  "text": "\"맞고 나서 물에 들어간 겁니다.\"",
  "sec": 3.571
 },
 {
  "num": "168",
  "scene": "S30",
  "text": "\"발바닥도 깨끗했습니다.\"",
  "sec": 3.491
 },
 {
  "num": "169",
  "scene": "S30",
  "text": "\"강가는 진흙입니다.\"",
  "sec": 2.691
 },
 {
  "num": "170",
  "scene": "S30",
  "text": "\"제 발로 걸어 들어갔어도 묻고, 끌려갔어도 묻습니다.\"",
  "sec": 5.771
 },
 {
  "num": "171",
  "scene": "S30",
  "text": "\"묻지 않았다는 건 들려서 갔다는 뜻입니다.\"",
  "sec": 4.131
 },
 {
  "num": "172",
  "scene": "S30",
  "text": "\"사람 하나를 들어 나르려면 혼자서는 어렵습니다.\"",
  "sec": 5.571
 },
 {
  "num": "173",
  "scene": "S31",
  "text": "아전들이 수군거렸어요.",
  "sec": 3.211
 },
 {
  "num": "174",
  "scene": "S31",
  "text": "\"염쟁이 말을 믿으시겠습니까.\"",
  "sec": 3.211
 },
 {
  "num": "175",
  "scene": "S31",
  "text": "그 말에 사또가 눈을 들었습니다.",
  "sec": 4.851
 },
 {
  "num": "176",
  "scene": "S31",
  "text": "\"믿고 안 믿고는 내가 정한다.\"",
  "sec": 4.051
 },
 {
  "num": "177",
  "scene": "S31",
  "text": "\"저 사람이 삼십 년을 그 일만 했다면, 내가 모르는 것을 알 것이다.\"",
  "sec": 7.971
 },
 {
  "num": "178",
  "scene": "S31",
  "text": "마당이 조용해졌어요.",
  "sec": 3.211
 },
 {
  "num": "179",
  "scene": "S32",
  "text": "사또가 그 사내의 짐을 가져오라 했습니다.",
  "sec": 4.051
 },
 {
  "num": "180",
  "scene": "S32",
  "text": "죽은 사람이 지니고 다니던 것들 말이에요.",
  "sec": 4.451
 },
 {
  "num": "181",
  "scene": "S32",
  "text": "빚 문서를 넣고 다니던 보따리가 있었거든요.",
  "sec": 4.651
 },
 {
  "num": "182",
  "scene": "S32",
  "text": "그런데 그 보따리에서 문서 하나가 비어 있었습니다.",
  "sec": 7.051
 },
 {
  "num": "183",
  "scene": "S32",
  "text": "장부에는 적혀 있는데 문서가 없었어요.",
  "sec": 4.171
 },
 {
  "num": "184",
  "scene": "S32",
  "text": "누구 것이었겠습니까.",
  "sec": 2.291
 },
 {
  "num": "185",
  "scene": "S33",
  "text": "고을에서 논 여섯 마지기를 부치던 사람이었습니다.",
  "sec": 5.331
 },
 {
  "num": "186",
  "scene": "S33",
  "text": "그 논을 잡히고 돈을 꾼 지 삼 년이 됐어요.",
  "sec": 5.171
 },
 {
  "num": "187",
  "scene": "S33",
  "text": "이자가 본전을 넘어선 지 오래였습니다.",
  "sec": 4.851
 },
 {
  "num": "188",
  "scene": "S33",
  "text": "그달에 논을 넘기기로 돼 있었어요.",
  "sec": 3.891
 },
 {
  "num": "189",
  "scene": "S33",
  "text": "문서만 없어지면 넘길 논도 없어지는 겁니다.",
  "sec": 5.891
 },
 {
  "num": "190",
  "scene": "S33",
  "text": "죽은 사람 머릿속에만 있던 빚이 되는 거지요.",
  "sec": 4.731
 },
 {
  "num": "191",
  "scene": "S34",
  "text": "그 사람 집 아궁이에서 탄 종이가 나왔습니다.",
  "sec": 4.651
 },
 {
  "num": "192",
  "scene": "S34",
  "text": "다 타지 않은 귀퉁이에 도장 자국이 남아 있었어요.",
  "sec": 4.731
 },
 {
  "num": "193",
  "scene": "S34",
  "text": "그리고 헛간에서 지게가 나왔습니다.",
  "sec": 4.131
 },
 {
  "num": "194",
  "scene": "S34",
  "text": "지게 끈에 흙이 묻어 있었어요.",
  "sec": 4.251
 },
 {
  "num": "195",
  "scene": "S34",
  "text": "강가 흙이었습니다.",
  "sec": 2.571
 },
 {
  "num": "196",
  "scene": "S34",
  "text": "사람을 지고 간 겁니다.",
  "sec": 2.771
 },
 {
  "num": "197",
  "scene": "S35",
  "text": "허허, 그래서 어찌 됐겠습니까.",
  "sec": 4.051
 },
 {
  "num": "198",
  "scene": "S35",
  "text": "손톱 밑 모래 한 알이 사람 목숨을 둘이나 바꿔 놓았지요.",
  "sec": 6.091
 },
 {
  "num": "199",
  "scene": "S36",
  "text": "수철이가 풀려났습니다.",
  "sec": 3.491
 },
 {
  "num": "200",
  "scene": "S36",
  "text": "닷새 만이었어요.",
  "sec": 2.171
 },
 {
  "num": "201",
  "scene": "S36",
  "text": "곤장 맞은 자리가 아물지 않아 걷지를 못했습니다.",
  "sec": 5.731
 },
 {
  "num": "202",
  "scene": "S36",
  "text": "제 어미가 업고 집으로 갔어요.",
  "sec": 4.171
 },
 {
  "num": "203",
  "scene": "S36",
  "text": "주막집 어미가 그날 처음으로 소리를 내 울었답니다.",
  "sec": 4.571
 },
 {
  "num": "204",
  "scene": "S36",
  "text": "관아 앞에서 사흘을 꿇을 때는 한 방울도 안 울었는데 말이지요.",
  "sec": 5.891
 },
 {
  "num": "205",
  "scene": "S37",
  "text": "며칠 뒤 그 어미가 덕배를 찾아왔어요.",
  "sec": 5.171
 },
 {
  "num": "206",
  "scene": "S37",
  "text": "덕배 집 마당에서 절을 했습니다.",
  "sec": 3.691
 },
 {
  "num": "207",
  "scene": "S37",
  "text": "덕배가 놀라 손을 내저었어요.",
  "sec": 4.211
 },
 {
  "num": "208",
  "scene": "S37",
  "text": "\"이러지 마십시오.\"",
  "sec": 2.531
 },
 {
  "num": "209",
  "scene": "S37",
  "text": "\"소인한테 절하면 안 됩니다.\"",
  "sec": 3.051
 },
 {
  "num": "210",
  "scene": "S37",
  "text": "어미가 고개를 더 숙였습니다.",
  "sec": 3.411
 },
 {
  "num": "211",
  "scene": "S37",
  "text": "\"내 아들 목숨값입니다.\"",
  "sec": 3.731
 },
 {
  "num": "212",
  "scene": "S38",
  "text": "관아에서도 사례를 보내왔습니다.",
  "sec": 3.651
 },
 {
  "num": "213",
  "scene": "S38",
  "text": "엽전 꾸러미였어요.",
  "sec": 2.771
 },
 {
  "num": "214",
  "scene": "S38",
  "text": "덕배가 받지 않았습니다.",
  "sec": 3.011
 },
 {
  "num": "215",
  "scene": "S38",
  "text": "\"소인이 한 게 아닙니다.\"",
  "sec": 2.971
 },
 {
  "num": "216",
  "scene": "S38",
  "text": "\"그 사람 몸이 말한 것이지요.\"",
  "sec": 4.771
 },
 {
  "num": "217",
  "scene": "S38",
  "text": "\"소인은 그저 삼십 년을 씻겼을 뿐입니다.\"",
  "sec": 3.971
 },
 {
  "num": "218",
  "scene": "S38",
  "text": "\"그 삼십 년이 아니었으면 소인도 그냥 지나쳤을 겁니다.\"",
  "sec": 6.091
 },
 {
  "num": "219",
  "scene": "S39",
  "text": "사또가 그러면 원하는 것을 말하라 했어요.",
  "sec": 4.371
 },
 {
  "num": "220",
  "scene": "S39",
  "text": "덕배가 한참을 있다가 입을 열었습니다.",
  "sec": 5.451
 },
 {
  "num": "221",
  "scene": "S39",
  "text": "\"그 사람을 한 번만 더 염하게 해 주십시오.\"",
  "sec": 5.811
 },
 {
  "num": "222",
  "scene": "S39",
  "text": "사또가 되물었어요.",
  "sec": 2.211
 },
 {
  "num": "223",
  "scene": "S39",
  "text": "\"이미 염을 하지 않았느냐.\"",
  "sec": 3.571
 },
 {
  "num": "224",
  "scene": "S39",
  "text": "덕배가 고개를 들었습니다.",
  "sec": 2.971
 },
 {
  "num": "225",
  "scene": "S40",
  "text": "\"억울하게 간 사람은 염을 두 번 합니다.\"",
  "sec": 4.651
 },
 {
  "num": "226",
  "scene": "S40",
  "text": "\"한 번은 몸을 씻기고, 한 번은 이름을 씻깁니다.\"",
  "sec": 6.011
 },
 {
  "num": "227",
  "scene": "S40",
  "text": "\"그 사람은 죽어서 제 죽음을 제가 말했습니다.\"",
  "sec": 5.331
 },
 {
  "num": "228",
  "scene": "S40",
  "text": "\"그만하면 다시 씻겨 보낼 만하지요.\"",
  "sec": 4.051
 },
 {
  "num": "229",
  "scene": "S40",
  "text": "사또가 한참을 말을 못 했어요.",
  "sec": 3.811
 },
 {
  "num": "230",
  "scene": "S41",
  "text": "그래서 덕배가 그 사람을 다시 씻겼습니다.",
  "sec": 6.851
 },
 {
  "num": "231",
  "scene": "S41",
  "text": "이번에는 돈을 받지 않았어요.",
  "sec": 3.171
 },
 {
  "num": "232",
  "scene": "S41",
  "text": "손톱 밑까지 다 씻겼습니다.",
  "sec": 3.731
 },
 {
  "num": "233",
  "scene": "S41",
  "text": "그러고는 새 옷을 입혀 관에 뉘었지요.",
  "sec": 4.251
 },
 {
  "num": "234",
  "scene": "S41",
  "text": "염을 마치고 덕배가 한마디 했답니다.",
  "sec": 3.811
 },
 {
  "num": "235",
  "scene": "S41",
  "text": "\"잘 가시오. 할 말은 다 했으니.\"",
  "sec": 4.011
 },
 {
  "num": "236",
  "scene": "S42",
  "text": "그 뒤로 고을에서 덕배를 부르는 말이 달라졌습니다.",
  "sec": 6.291
 },
 {
  "num": "237",
  "scene": "S42",
  "text": "전에는 \"염쟁이 불러라\" 했는데요.",
  "sec": 3.691
 },
 {
  "num": "238",
  "scene": "S42",
  "text": "그 뒤로는 \"덕배 어른 오시라 해라\" 했답니다.",
  "sec": 5.091
 },
 {
  "num": "239",
  "scene": "S42",
  "text": "엽전도 손에 쥐여 주었고요.",
  "sec": 3.171
 },
 {
  "num": "240",
  "scene": "S42",
  "text": "바닥에 놓고 가는 사람이 없어졌어요.",
  "sec": 4.171
 },
 {
  "num": "241",
  "scene": "S42",
  "text": "덕배는 그게 제일 좋았다고 합니다.",
  "sec": 3.611
 },
 {
  "num": "242",
  "scene": "S43",
  "text": "수철이가 몸이 낫고 나서 덕배를 찾아왔습니다.",
  "sec": 4.851
 },
 {
  "num": "243",
  "scene": "S43",
  "text": "일을 배우겠다고 했어요.",
  "sec": 2.971
 },
 {
  "num": "244",
  "scene": "S43",
  "text": "덕배가 말렸습니다.",
  "sec": 2.771
 },
 {
  "num": "245",
  "scene": "S43",
  "text": "\"이 일은 배우면 평생 그 소리를 듣는다.\"",
  "sec": 6.051
 },
 {
  "num": "246",
  "scene": "S43",
  "text": "수철이가 그랬답니다.",
  "sec": 2.531
 },
 {
  "num": "247",
  "scene": "S43",
  "text": "\"어른 덕에 산 목숨인데, 그 소리쯤이야 못 듣겠습니까.\"",
  "sec": 5.891
 },
 {
  "num": "248",
  "scene": "S43",
  "text": "그래서 둘이 같이 다녔다고 해요.",
  "sec": 3.691
 },
 {
  "num": "249",
  "scene": "S44",
  "text": "덕배는 예순이 넘도록 그 일을 했습니다.",
  "sec": 4.491
 },
 {
  "num": "250",
  "scene": "S44",
  "text": "마지막에는 수철이가 덕배를 씻겼다고 하지요.",
  "sec": 5.291
 },
 {
  "num": "251",
  "scene": "S44",
  "text": "제 손으로 스승을 보낸 겁니다.",
  "sec": 3.571
 },
 {
  "num": "252",
  "scene": "S44",
  "text": "그 고을에서는 그 뒤로 이런 말이 돌았답니다.",
  "sec": 5.171
 },
 {
  "num": "253",
  "scene": "S44",
  "text": "\"죽은 사람 앞에서는 거짓말을 못 한다.\"",
  "sec": 4.451
 },
 {
  "num": "254",
  "scene": "S45",
  "text": "허허, 어떻습니까.",
  "sec": 3.011
 },
 {
  "num": "255",
  "scene": "S45",
  "text": "고을 사람 수십이 다 본 것을, 아무도 못 봤지요.",
  "sec": 5.291
 },
 {
  "num": "256",
  "scene": "S45",
  "text": "주막에서 멱살 잡은 건 다들 봤는데 말이오.",
  "sec": 4.891
 },
 {
  "num": "257",
  "scene": "S45",
  "text": "정작 그 사람이 어떻게 갔는지는 아무도 안 봤습니다.",
  "sec": 4.371
 },
 {
  "num": "258",
  "scene": "S46",
  "text": "그런데 말이오.",
  "sec": 1.691
 },
 {
  "num": "259",
  "scene": "S46",
  "text": "덕배는 그걸 어떻게 알았겠습니까.",
  "sec": 3.931
 },
 {
  "num": "260",
  "scene": "S46",
  "text": "삼십 년을 주검만 씻겼으니 안 겁니다.",
  "sec": 4.491
 },
 {
  "num": "261",
  "scene": "S46",
  "text": "남들이 제일 꺼리는 그 일을 말이지요.",
  "sec": 4.051
 },
 {
  "num": "262",
  "scene": "S46",
  "text": "사람을 천하게 보면 그 사람이 아는 것까지 천해 보이는 모양입니다.",
  "sec": 7.411
 },
 {
  "num": "263",
  "scene": "S46",
  "text": "아는 것에 무슨 귀천이 있겠습니까.",
  "sec": 3.851
 },
 {
  "num": "264",
  "scene": "S47",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 4.571
 },
 {
  "num": "265",
  "scene": "S47",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 6.411
 }
]