[
 {
  "num": "001",
  "scene": "S01",
  "text": "고을 한복판에서 상여가 멈춰 섰습니다.",
  "sec": 5.371
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "앞에서 울던 여인이 울음을 뚝 그쳤거든요.",
  "sec": 4.931
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "돈을 받고 대신 울어 주는 여인이었지요.",
  "sec": 5.131
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "그 여인이 울음을 그치자, 온 상여가 따라 멈췄답니다.",
  "sec": 5.611
 },
 {
  "num": "005",
  "scene": "S02",
  "text": "\"이 상여, 여기서 멈추셔야겠습니다.\"",
  "sec": 4.771
 },
 {
  "num": "006",
  "scene": "S02",
  "text": "천한 곡비의 한마디에 양반댁 상여가 멈춰 선 것이었어요.",
  "sec": 6.611
 },
 {
  "num": "007",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 6.691
 },
 {
  "num": "008",
  "scene": "S03",
  "text": "오늘도 먼 길 오셨으니, 편히 앉아 들어들 보시게.",
  "sec": 5.851
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 5.491
 },
 {
  "num": "010",
  "scene": "S05",
  "text": "옛날 옛적, 전라도 어느 고을에 곱단이라는 여인이 있었습니다.",
  "sec": 7.331
 },
 {
  "num": "011",
  "scene": "S05",
  "text": "곱단이는 곡비였어요.",
  "sec": 3.771
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "곡비란 남의 초상집에 불려 가, 돈을 받고 대신 울어 주는 사람이었지요.",
  "sec": 7.771
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "양반댁 초상에 곡소리가 끊기면 집안 체면이 깎이던 시절이었거든요.",
  "sec": 7.531
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "그래서 울음도 사고파는 것이 되었답니다.",
  "sec": 5.211
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "양반댁일수록 곡소리가 길어야 효자 소리를 들었거든요.",
  "sec": 6.571
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "그러니 울어 줄 사람을 돈 주고 부르는 일이 흔했습니다.",
  "sec": 5.851
 },
 {
  "num": "017",
  "scene": "S06",
  "text": "곱단이는 초상 소식이 들리면 그 마을로 걸어갔어요.",
  "sec": 5.771
 },
 {
  "num": "018",
  "scene": "S06",
  "text": "십 리든 이십 리든 걸어갔지요.",
  "sec": 4.891
 },
 {
  "num": "019",
  "scene": "S06",
  "text": "울어 주고 받는 삯은 엽전 몇 닢이었습니다.",
  "sec": 5.051
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "그거면 며칠 밥은 먹었으니까요.",
  "sec": 3.771
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "비가 오면 머리에 멍석을 쓰고 걸었어요.",
  "sec": 4.851
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "초상은 날을 골라 나는 게 아니니까요.",
  "sec": 4.011
 },
 {
  "num": "023",
  "scene": "S07",
  "text": "그런데 곱단이는 상갓집에서 사람 대접을 받지 못했어요.",
  "sec": 6.371
 },
 {
  "num": "024",
  "scene": "S07",
  "text": "울음이 끝나면 마당 끝으로 물러나 혼자 밥을 먹었습니다.",
  "sec": 6.131
 },
 {
  "num": "025",
  "scene": "S07",
  "text": "\"울음 파는 여편네\"라고들 불렀지요.",
  "sec": 3.531
 },
 {
  "num": "026",
  "scene": "S07",
  "text": "곡소리가 필요할 땐 부르고, 끝나면 내보내는 사람이었어요.",
  "sec": 6.211
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "안방은커녕 마루에도 올라가 본 적이 없었지요.",
  "sec": 4.411
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "곱단이는 그런 대접에 섭섭해하지도 않았어요. 스무 해나 되었으니까요.",
  "sec": 7.051
 },
 {
  "num": "029",
  "scene": "S08",
  "text": "삯을 줄 때도 손에 쥐여 주지 않고 마루에 던져 주었어요.",
  "sec": 6.371
 },
 {
  "num": "030",
  "scene": "S08",
  "text": "곱단이는 그걸 주워 담고 절을 하고 나왔습니다.",
  "sec": 5.251
 },
 {
  "num": "031",
  "scene": "S08",
  "text": "스무 해를 그렇게 살았지요.",
  "sec": 3.211
 },
 {
  "num": "032",
  "scene": "S08",
  "text": "그래도 곱단이를 찾는 집은 끊이지 않았습니다.",
  "sec": 4.691
 },
 {
  "num": "033",
  "scene": "S08",
  "text": "곱단이가 울면 마당에 있던 사람들이 다 따라 울었거든요.",
  "sec": 6.531
 },
 {
  "num": "034",
  "scene": "S09",
  "text": "곱단이가 울어 준 초상이 몇이었는지는 저도 모릅니다.",
  "sec": 6.131
 },
 {
  "num": "035",
  "scene": "S09",
  "text": "아마 곱단이 자신도 몰랐을 거예요.",
  "sec": 4.371
 },
 {
  "num": "036",
  "scene": "S09",
  "text": "다만 울 때마다 제 설움을 얹어 울었다고 합니다.",
  "sec": 5.091
 },
 {
  "num": "037",
  "scene": "S09",
  "text": "남의 초상에 제 설움을 얹는 건 곡비들이 다 하던 일이었어요.",
  "sec": 6.851
 },
 {
  "num": "038",
  "scene": "S09",
  "text": "그래야 울음이 나오니까요.",
  "sec": 3.211
 },
 {
  "num": "039",
  "scene": "S10",
  "text": "곱단이는 열일곱에 시집을 갔어요.",
  "sec": 4.491
 },
 {
  "num": "040",
  "scene": "S10",
  "text": "그런데 혼인한 지 사흘 만에 신랑이 물에 빠져 죽었습니다.",
  "sec": 6.131
 },
 {
  "num": "041",
  "scene": "S10",
  "text": "그 시절 사흘 신부는 울 자격도 없다 했어요.",
  "sec": 4.491
 },
 {
  "num": "042",
  "scene": "S10",
  "text": "시집에서는 부정 탄다고 곱단이를 내보냈고요.",
  "sec": 4.691
 },
 {
  "num": "043",
  "scene": "S10",
  "text": "친정에서도 받아 주지 않았습니다.",
  "sec": 3.571
 },
 {
  "num": "044",
  "scene": "S10",
  "text": "갈 데가 없어 마을 뒤 헛간에서 겨울을 났다고 해요.",
  "sec": 5.011
 },
 {
  "num": "045",
  "scene": "S10",
  "text": "그때 이웃 노파가 곱단이를 초상집에 데려간 것이 시작이었습니다.",
  "sec": 7.491
 },
 {
  "num": "046",
  "scene": "S10",
  "text": "\"울 줄은 알지? 울면 밥은 준다.\" 그 말이었어요.",
  "sec": 5.851
 },
 {
  "num": "047",
  "scene": "S11",
  "text": "그러니까 곱단이는 제 울음을 한 번도 제대로 울어 보지 못한 사람이었어요.",
  "sec": 7.011
 },
 {
  "num": "048",
  "scene": "S11",
  "text": "남의 울음을 울며 스무 해를 산 겁니다.",
  "sec": 5.171
 },
 {
  "num": "049",
  "scene": "S11",
  "text": "그렇게 오래 울다 보니, 곱단이는 울음을 알게 되었지요.",
  "sec": 5.531
 },
 {
  "num": "050",
  "scene": "S11",
  "text": "어떤 울음이 진짜고 어떤 울음이 빈 울음인지를요.",
  "sec": 4.691
 },
 {
  "num": "051",
  "scene": "S11",
  "text": "진짜 우는 사람은 숨이 자꾸 끊어지고 말이 뭉개집니다.",
  "sec": 6.611
 },
 {
  "num": "052",
  "scene": "S11",
  "text": "빈 울음은 소리만 크고 고르지요.",
  "sec": 4.171
 },
 {
  "num": "053",
  "scene": "S11",
  "text": "곱단이는 마당에 들어서면 그것부터 들렸다고 해요.",
  "sec": 6.091
 },
 {
  "num": "054",
  "scene": "S12",
  "text": "그해 가을, 고을에서 제일 큰 박 진사댁에 초상이 났습니다.",
  "sec": 7.411
 },
 {
  "num": "055",
  "scene": "S12",
  "text": "박 진사는 여든을 바라보던 노인이었어요.",
  "sec": 4.771
 },
 {
  "num": "056",
  "scene": "S12",
  "text": "아들이 셋, 손주가 여럿인 큰 집이었지요.",
  "sec": 5.251
 },
 {
  "num": "057",
  "scene": "S12",
  "text": "그런데 그 집에는 늦둥이 딸이 하나 더 있었습니다. 열두 살 연이였어요.",
  "sec": 7.971
 },
 {
  "num": "058",
  "scene": "S12",
  "text": "연이 어미는 연이를 낳고 이태 만에 세상을 떴어요.",
  "sec": 7.011
 },
 {
  "num": "059",
  "scene": "S12",
  "text": "그러니 연이는 그 큰 집에서 혼자였습니다.",
  "sec": 5.611
 },
 {
  "num": "060",
  "scene": "S13",
  "text": "초상이 나기 전날 새벽이었어요.",
  "sec": 3.371
 },
 {
  "num": "061",
  "scene": "S13",
  "text": "곱단이는 이웃 마을 초상을 마치고 돌아가던 길이었습니다.",
  "sec": 5.811
 },
 {
  "num": "062",
  "scene": "S13",
  "text": "목이 말라 박 진사댁 뒷문으로 물을 얻으러 들어갔지요.",
  "sec": 6.011
 },
 {
  "num": "063",
  "scene": "S13",
  "text": "온 집안이 잠들어 있는 시각이었어요.",
  "sec": 4.771
 },
 {
  "num": "064",
  "scene": "S13",
  "text": "초상 치를 일이 가까운 집은 며칠씩 밤을 새우거든요.",
  "sec": 6.171
 },
 {
  "num": "065",
  "scene": "S13",
  "text": "그래서 그 새벽엔 다들 곯아떨어져 있었습니다.",
  "sec": 5.331
 },
 {
  "num": "066",
  "scene": "S14",
  "text": "그런데 안채 쪽에서 가느다란 소리가 들렸어요.",
  "sec": 5.771
 },
 {
  "num": "067",
  "scene": "S14",
  "text": "곱단이가 가만히 들여다보니 노인이 홀로 누워 있었습니다.",
  "sec": 6.411
 },
 {
  "num": "068",
  "scene": "S14",
  "text": "박 진사였어요. 숨이 얕고 손이 떨리고 있었지요.",
  "sec": 6.051
 },
 {
  "num": "069",
  "scene": "S14",
  "text": "곁에는 아무도 없었습니다. 다들 잠든 새벽이었으니까요.",
  "sec": 7.171
 },
 {
  "num": "070",
  "scene": "S14",
  "text": "아들이 셋이나 되는 집이었는데도요.",
  "sec": 3.531
 },
 {
  "num": "071",
  "scene": "S14",
  "text": "곱단이는 잠깐 망설였어요. 남의 집 안채였으니까요.",
  "sec": 6.851
 },
 {
  "num": "072",
  "scene": "S15",
  "text": "곱단이가 다가가 손을 잡았어요. 그게 사람이 할 일이었으니까요.",
  "sec": 6.691
 },
 {
  "num": "073",
  "scene": "S15",
  "text": "노인이 곱단이 손목을 붙들고 무어라 중얼거렸습니다.",
  "sec": 6.291
 },
 {
  "num": "074",
  "scene": "S15",
  "text": "\"뒤란… 감나무 아래…\"",
  "sec": 2.851
 },
 {
  "num": "075",
  "scene": "S15",
  "text": "\"연이 것이니… 연이한테…\"",
  "sec": 3.891
 },
 {
  "num": "076",
  "scene": "S15",
  "text": "그러고는 손에서 힘이 풀렸어요.",
  "sec": 3.651
 },
 {
  "num": "077",
  "scene": "S15",
  "text": "곱단이는 그 손을 한참 놓지 못했습니다.",
  "sec": 5.371
 },
 {
  "num": "078",
  "scene": "S15",
  "text": "사람이 가는 자리를 스무 해나 지켜봤어도, 그건 늘 처음 같았거든요.",
  "sec": 7.651
 },
 {
  "num": "079",
  "scene": "S16",
  "text": "곱단이는 그 자리에 한참을 앉아 있었어요.",
  "sec": 4.891
 },
 {
  "num": "080",
  "scene": "S16",
  "text": "그러다 사람을 깨우러 나갔지요.",
  "sec": 3.731
 },
 {
  "num": "081",
  "scene": "S16",
  "text": "곧 온 집안에 불이 켜지고 곡소리가 터졌습니다.",
  "sec": 5.491
 },
 {
  "num": "082",
  "scene": "S16",
  "text": "아무도 곱단이한테 어찌 된 일이냐 묻지 않았어요.",
  "sec": 5.051
 },
 {
  "num": "083",
  "scene": "S16",
  "text": "곡비가 그 자리에 있었다는 것도 곧 잊혔고요.",
  "sec": 4.651
 },
 {
  "num": "084",
  "scene": "S17",
  "text": "박 진사댁 초상은 사흘 동안 컸어요.",
  "sec": 5.931
 },
 {
  "num": "085",
  "scene": "S17",
  "text": "고을 사람이 다 왔고, 곡비도 여럿 불려 왔지요.",
  "sec": 6.171
 },
 {
  "num": "086",
  "scene": "S17",
  "text": "곱단이도 그중 하나였습니다.",
  "sec": 5.131
 },
 {
  "num": "087",
  "scene": "S17",
  "text": "그런데 곱단이는 울면서 자꾸 한쪽을 보았어요.",
  "sec": 6.851
 },
 {
  "num": "088",
  "scene": "S17",
  "text": "곡을 하면서도 귀는 마당 전체를 듣고 있었습니다.",
  "sec": 6.851
 },
 {
  "num": "089",
  "scene": "S17",
  "text": "그게 곡비의 버릇이었어요.",
  "sec": 3.731
 },
 {
  "num": "090",
  "scene": "S18",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 4.091
 },
 {
  "num": "091",
  "scene": "S18",
  "text": "울음을 스무 해 들은 사람이 무엇을 들었겠습니까.",
  "sec": 5.411
 },
 {
  "num": "092",
  "scene": "S19",
  "text": "큰아들의 곡소리가 제일 컸습니다.",
  "sec": 4.331
 },
 {
  "num": "093",
  "scene": "S19",
  "text": "그런데 곱단이 귀에는 그게 이상하게 들렸어요.",
  "sec": 5.331
 },
 {
  "num": "094",
  "scene": "S19",
  "text": "소리는 큰데 숨이 고르더랍니다.",
  "sec": 4.571
 },
 {
  "num": "095",
  "scene": "S19",
  "text": "진짜 우는 사람은 숨이 자꾸 끊기거든요.",
  "sec": 5.171
 },
 {
  "num": "096",
  "scene": "S19",
  "text": "곱단이는 그 소리를 스무 해 동안 하루도 안 빼고 들었습니다.",
  "sec": 6.131
 },
 {
  "num": "097",
  "scene": "S19",
  "text": "귀가 그렇게 만들어진 사람이었지요.",
  "sec": 3.971
 },
 {
  "num": "098",
  "scene": "S20",
  "text": "반대로 마당 구석에는 소리 없이 우는 아이가 있었어요.",
  "sec": 6.291
 },
 {
  "num": "099",
  "scene": "S20",
  "text": "늦둥이 딸 연이였습니다.",
  "sec": 3.771
 },
 {
  "num": "100",
  "scene": "S20",
  "text": "곱단이는 그 아이 울음이 진짜인 걸 단번에 알았지요.",
  "sec": 5.731
 },
 {
  "num": "101",
  "scene": "S20",
  "text": "울음을 파는 사람이라 울음은 잘 알았으니까요.",
  "sec": 4.611
 },
 {
  "num": "102",
  "scene": "S20",
  "text": "아무도 그 아이를 들여다보지 않았어요.",
  "sec": 3.971
 },
 {
  "num": "103",
  "scene": "S20",
  "text": "상주도 아니고 아들도 아닌 계집아이였으니까요.",
  "sec": 5.491
 },
 {
  "num": "104",
  "scene": "S21",
  "text": "삼우제가 끝나자 큰아들이 문중 어른들을 불렀어요.",
  "sec": 5.251
 },
 {
  "num": "105",
  "scene": "S21",
  "text": "\"아버님 유언은 없었습니다. 그러니 살림은 장자가 맡는 것이 법이지요.\"",
  "sec": 8.291
 },
 {
  "num": "106",
  "scene": "S21",
  "text": "어른들이 고개를 끄덕였습니다. 그 시절엔 그게 당연한 일이었거든요.",
  "sec": 6.611
 },
 {
  "num": "107",
  "scene": "S21",
  "text": "그런데 큰아들이 한마디를 더 붙였어요.",
  "sec": 4.651
 },
 {
  "num": "108",
  "scene": "S21",
  "text": "\"연이는 절에 맡길까 합니다. 계집아이 하나 건사할 형편이 아니라서요.\"",
  "sec": 7.651
 },
 {
  "num": "109",
  "scene": "S21",
  "text": "절에 맡긴다는 건 그 시절엔 거저 주는 것이나 마찬가지였어요.",
  "sec": 6.331
 },
 {
  "num": "110",
  "scene": "S21",
  "text": "어른들은 잠깐 말이 없다가 그러라고 했습니다.",
  "sec": 4.971
 },
 {
  "num": "111",
  "scene": "S22",
  "text": "연이는 그 말에 아무 말도 못 했어요.",
  "sec": 4.211
 },
 {
  "num": "112",
  "scene": "S22",
  "text": "열두 살이었고, 편들어 줄 어미도 없었으니까요.",
  "sec": 5.491
 },
 {
  "num": "113",
  "scene": "S22",
  "text": "다음 날 아침에 절에서 사람이 오기로 했습니다.",
  "sec": 4.411
 },
 {
  "num": "114",
  "scene": "S22",
  "text": "연이는 밤새 보따리를 끌어안고 앉아 있었지요.",
  "sec": 5.931
 },
 {
  "num": "115",
  "scene": "S22",
  "text": "마당 끝에서 그걸 본 사람이 하나 있었어요.",
  "sec": 5.291
 },
 {
  "num": "116",
  "scene": "S22",
  "text": "삯을 받고 떠나려던 곱단이였습니다.",
  "sec": 4.451
 },
 {
  "num": "117",
  "scene": "S23",
  "text": "그때 마당 끝에 있던 곱단이가 앞으로 나섰어요.",
  "sec": 4.811
 },
 {
  "num": "118",
  "scene": "S23",
  "text": "\"소인이 아뢸 말씀이 있습니다.\"",
  "sec": 4.171
 },
 {
  "num": "119",
  "scene": "S23",
  "text": "\"돌아가시던 새벽에 소인이 진사 어른 손을 잡고 있었습니다.\"",
  "sec": 6.051
 },
 {
  "num": "120",
  "scene": "S23",
  "text": "\"뒤란 감나무 아래에 연이 아씨 것을 두셨다 하셨습니다.\"",
  "sec": 5.771
 },
 {
  "num": "121",
  "scene": "S23",
  "text": "마당에 있던 사람들이 다 곱단이를 쳐다봤어요.",
  "sec": 4.371
 },
 {
  "num": "122",
  "scene": "S23",
  "text": "곡비가 양반댁 마당 가운데로 나선 건 처음 있는 일이었거든요.",
  "sec": 6.891
 },
 {
  "num": "123",
  "scene": "S24",
  "text": "마당이 조용해졌다가 곧 웃음이 터졌어요.",
  "sec": 5.971
 },
 {
  "num": "124",
  "scene": "S24",
  "text": "\"울음 파는 여편네가 무슨 소리냐.\"",
  "sec": 3.611
 },
 {
  "num": "125",
  "scene": "S24",
  "text": "\"삯을 더 받고 싶어 지어낸 말이겠지.\"",
  "sec": 4.371
 },
 {
  "num": "126",
  "scene": "S24",
  "text": "큰아들은 아예 곱단이를 내쫓으라고 했습니다.",
  "sec": 4.811
 },
 {
  "num": "127",
  "scene": "S24",
  "text": "\"당장 내보내라. 초상집에서 무슨 행패냐.\"",
  "sec": 4.811
 },
 {
  "num": "128",
  "scene": "S24",
  "text": "하인 둘이 곱단이 팔을 잡았습니다.",
  "sec": 4.291
 },
 {
  "num": "129",
  "scene": "S25",
  "text": "그런데 곱단이가 물러서지 않았습니다. 탁!",
  "sec": 6.051
 },
 {
  "num": "130",
  "scene": "S26",
  "text": "\"그러면 저 감나무 아래 땅을 파 보십시오.\"",
  "sec": 4.771
 },
 {
  "num": "131",
  "scene": "S26",
  "text": "\"거기서 아무것도 안 나오면 소인을 관아에 넘기십시오.\"",
  "sec": 6.691
 },
 {
  "num": "132",
  "scene": "S26",
  "text": "\"거짓말한 죄로 매를 맞겠습니다.\"",
  "sec": 3.611
 },
 {
  "num": "133",
  "scene": "S26",
  "text": "곱단이는 동네 사람들을 불러 모았어요. 사람이 많아야 했으니까요.",
  "sec": 6.931
 },
 {
  "num": "134",
  "scene": "S26",
  "text": "구경 온 사람이 마당에 가득 찼어요.",
  "sec": 4.691
 },
 {
  "num": "135",
  "scene": "S26",
  "text": "그렇게 되면 큰아들도 안 팔 수가 없었지요.",
  "sec": 4.891
 },
 {
  "num": "136",
  "scene": "S27",
  "text": "뒤란 감나무 아래를 파기 시작했어요.",
  "sec": 3.971
 },
 {
  "num": "137",
  "scene": "S27",
  "text": "한 자쯤 파 내려가자 삽 끝에 무언가 딱 걸렸습니다.",
  "sec": 7.011
 },
 {
  "num": "138",
  "scene": "S27",
  "text": "흙을 걷어 내니 항아리 어깨가 드러났지요.",
  "sec": 4.731
 },
 {
  "num": "139",
  "scene": "S27",
  "text": "마당에 있던 사람들이 모두 목을 뺐습니다.",
  "sec": 4.971
 },
 {
  "num": "140",
  "scene": "S27",
  "text": "항아리는 어른 두 팔로 안을 만한 크기였어요.",
  "sec": 4.971
 },
 {
  "num": "141",
  "scene": "S27",
  "text": "뚜껑을 기름종이로 꼭 싸매 놓은 것이었습니다.",
  "sec": 5.011
 },
 {
  "num": "142",
  "scene": "S28",
  "text": "항아리 안에는 기름종이로 싼 문서 한 장이 들어 있었어요.",
  "sec": 5.451
 },
 {
  "num": "143",
  "scene": "S28",
  "text": "그리고 은비녀와 작은 나무함이 함께 있었습니다.",
  "sec": 5.451
 },
 {
  "num": "144",
  "scene": "S28",
  "text": "문서는 논 열 마지기를 연이 앞으로 떼어 둔다는 것이었지요.",
  "sec": 6.171
 },
 {
  "num": "145",
  "scene": "S28",
  "text": "관아에도 같은 것이 올라가 있었고요.",
  "sec": 3.691
 },
 {
  "num": "146",
  "scene": "S28",
  "text": "말로만 한 유언이 아니라 문서로 남긴 것이었지요.",
  "sec": 5.051
 },
 {
  "num": "147",
  "scene": "S28",
  "text": "그러니 아무도 뒤집을 수 없었습니다.",
  "sec": 4.011
 },
 {
  "num": "148",
  "scene": "S29",
  "text": "문중 어른들의 얼굴이 굳었어요.",
  "sec": 3.891
 },
 {
  "num": "149",
  "scene": "S29",
  "text": "박 진사가 삼 년 전에 미리 떼어 둔 것이었습니다.",
  "sec": 6.691
 },
 {
  "num": "150",
  "scene": "S29",
  "text": "늦둥이 딸이 혼자 남을 것을 알고 준비해 둔 것이었지요.",
  "sec": 5.531
 },
 {
  "num": "151",
  "scene": "S29",
  "text": "\"이걸 어찌 아무도 몰랐단 말인가.\"",
  "sec": 4.611
 },
 {
  "num": "152",
  "scene": "S29",
  "text": "박 진사가 그 말을 전한 사람이 하필 곡비였으니까요.",
  "sec": 6.171
 },
 {
  "num": "153",
  "scene": "S29",
  "text": "식구들은 아무도 그 새벽에 깨어 있지 않았고요.",
  "sec": 4.531
 },
 {
  "num": "154",
  "scene": "S30",
  "text": "큰아들은 아무 말도 하지 못했어요.",
  "sec": 3.531
 },
 {
  "num": "155",
  "scene": "S30",
  "text": "아버지가 죽던 새벽에 그 곁을 지킨 사람이 누구였는지,",
  "sec": 5.851
 },
 {
  "num": "156",
  "scene": "S30",
  "text": "마당에 있던 사람들이 다 알아 버렸으니까요.",
  "sec": 4.531
 },
 {
  "num": "157",
  "scene": "S30",
  "text": "아들 셋이 잠든 새벽에 손을 잡아 준 사람은 곡비였습니다.",
  "sec": 7.371
 },
 {
  "num": "158",
  "scene": "S30",
  "text": "그 말이 고을에 퍼지는 데는 하루도 안 걸렸어요.",
  "sec": 5.171
 },
 {
  "num": "159",
  "scene": "S31",
  "text": "허허, 여기서 끝났으면 그저 시원한 이야기지요.",
  "sec": 5.011
 },
 {
  "num": "160",
  "scene": "S31",
  "text": "그런데 이 이야기는 여기서부터가 다릅니다.",
  "sec": 6.771
 },
 {
  "num": "161",
  "scene": "S32",
  "text": "연이는 절에 가지 않았어요.",
  "sec": 3.691
 },
 {
  "num": "162",
  "scene": "S32",
  "text": "논 열 마지기가 연이 앞으로 돌아갔고, 문중에서 후견을 맡았지요.",
  "sec": 6.771
 },
 {
  "num": "163",
  "scene": "S32",
  "text": "연이가 곱단이 앞에 무릎을 꿇으려 하자 곱단이가 붙들었습니다.",
  "sec": 7.171
 },
 {
  "num": "164",
  "scene": "S32",
  "text": "\"아씨, 소인한테 그러시면 안 됩니다.\"",
  "sec": 4.531
 },
 {
  "num": "165",
  "scene": "S32",
  "text": "\"소인은 그저 들은 말을 옮겼을 뿐입니다.\"",
  "sec": 4.331
 },
 {
  "num": "166",
  "scene": "S32",
  "text": "연이는 곱단이 손을 놓지 않았어요.",
  "sec": 4.451
 },
 {
  "num": "167",
  "scene": "S33",
  "text": "문중에서 곱단이에게 사례를 하겠다고 했어요.",
  "sec": 4.691
 },
 {
  "num": "168",
  "scene": "S33",
  "text": "논 한 마지기를 떼어 주겠다고도 했지요.",
  "sec": 4.211
 },
 {
  "num": "169",
  "scene": "S33",
  "text": "곱단이는 받지 않았습니다.",
  "sec": 2.891
 },
 {
  "num": "170",
  "scene": "S33",
  "text": "\"소인은 울어 드리고 삯을 받는 사람입니다. 그날 삯은 이미 받았습니다.\"",
  "sec": 9.971
 },
 {
  "num": "171",
  "scene": "S33",
  "text": "\"진사 어른이 제 손을 잡아 주셨거든요. 그게 삯입니다.\"",
  "sec": 6.571
 },
 {
  "num": "172",
  "scene": "S33",
  "text": "문중 어른들은 아무 말도 하지 못했습니다.",
  "sec": 4.851
 },
 {
  "num": "173",
  "scene": "S34",
  "text": "곱단이는 그 뒤로도 곡비를 그만두지 않았어요.",
  "sec": 5.491
 },
 {
  "num": "174",
  "scene": "S34",
  "text": "다만 그날 이후로 곱단이 울음이 달라졌다고들 했습니다.",
  "sec": 6.891
 },
 {
  "num": "175",
  "scene": "S34",
  "text": "전에는 소리가 컸는데, 이제는 듣는 사람이 따라 울었다고요.",
  "sec": 6.731
 },
 {
  "num": "176",
  "scene": "S34",
  "text": "제 울음을 한 번 울어 본 사람이라 그렇다고들 했어요.",
  "sec": 4.531
 },
 {
  "num": "177",
  "scene": "S35",
  "text": "그날 밤 곱단이는 주막 방에 혼자 앉아 울었어요.",
  "sec": 6.411
 },
 {
  "num": "178",
  "scene": "S35",
  "text": "남의 울음이 아니라 제 울음이었습니다.",
  "sec": 4.171
 },
 {
  "num": "179",
  "scene": "S35",
  "text": "사흘 만에 잃은 제 신랑 생각이 났거든요.",
  "sec": 4.931
 },
 {
  "num": "180",
  "scene": "S35",
  "text": "스무 해 만에 처음으로 제 것을 운 겁니다.",
  "sec": 5.931
 },
 {
  "num": "181",
  "scene": "S35",
  "text": "남의 울음을 울어 주다 제 울음을 잊고 산 세월이었지요.",
  "sec": 6.091
 },
 {
  "num": "182",
  "scene": "S35",
  "text": "그날 밤 곱단이는 목이 쉬도록 울었다고 합니다.",
  "sec": 5.531
 },
 {
  "num": "183",
  "scene": "S36",
  "text": "곱단이는 다음 날 아침 다시 길을 나섰어요.",
  "sec": 5.051
 },
 {
  "num": "184",
  "scene": "S36",
  "text": "어느 마을에 초상이 났다는 소식을 들었거든요.",
  "sec": 4.331
 },
 {
  "num": "185",
  "scene": "S37",
  "text": "그런데 그 뒤로 곱단이한테는 삯을 받지 않는 날이 생겼어요.",
  "sec": 8.011
 },
 {
  "num": "186",
  "scene": "S37",
  "text": "아이가 죽은 집, 상주가 없는 집에는 그냥 갔습니다.",
  "sec": 6.411
 },
 {
  "num": "187",
  "scene": "S37",
  "text": "\"이런 집은 울어 줄 사람이 없어서 내가 가야 해.\"",
  "sec": 6.411
 },
 {
  "num": "188",
  "scene": "S37",
  "text": "그런 날은 밤새 울다 새벽에 혼자 나왔다고 해요.",
  "sec": 5.731
 },
 {
  "num": "189",
  "scene": "S37",
  "text": "삯 대신 밥 한 그릇을 받고 나온 날도 많았고요.",
  "sec": 5.051
 },
 {
  "num": "190",
  "scene": "S38",
  "text": "세월이 흘러 연이가 스물이 넘었을 때였어요.",
  "sec": 4.691
 },
 {
  "num": "191",
  "scene": "S38",
  "text": "연이가 곱단이를 찾아왔습니다.",
  "sec": 3.531
 },
 {
  "num": "192",
  "scene": "S38",
  "text": "\"아주머니, 제 혼례에 와 주십시오.\"",
  "sec": 4.171
 },
 {
  "num": "193",
  "scene": "S38",
  "text": "\"울어 달라는 게 아니라, 앉아 계셔 달라고요.\"",
  "sec": 4.291
 },
 {
  "num": "194",
  "scene": "S38",
  "text": "곱단이는 그날 처음으로 잔칫집 마루에 올라앉았답니다.",
  "sec": 5.851
 },
 {
  "num": "195",
  "scene": "S38",
  "text": "연이가 곱단이를 제 어미 자리에 앉혔거든요.",
  "sec": 5.451
 },
 {
  "num": "196",
  "scene": "S38",
  "text": "그날 곱단이는 울지 않으려고 부채로 얼굴을 가렸다고 해요.",
  "sec": 6.211
 },
 {
  "num": "197",
  "scene": "S39",
  "text": "곱단이는 예순이 넘도록 초상집을 다녔다고 합니다.",
  "sec": 5.371
 },
 {
  "num": "198",
  "scene": "S39",
  "text": "고을 사람들은 그때쯤 곱단이를 이렇게 불렀어요.",
  "sec": 6.291
 },
 {
  "num": "199",
  "scene": "S39",
  "text": "\"울음 파는 여편네\"가 아니라, \"곱단이 아주머니\"라고요.",
  "sec": 6.091
 },
 {
  "num": "200",
  "scene": "S40",
  "text": "허허, 어떻습니까. 울음을 판다고 손가락질받던 사람이, 남의 집 아이를 살렸지요.",
  "sec": 8.411
 },
 {
  "num": "201",
  "scene": "S40",
  "text": "울음에도 진짜와 가짜가 있습니다. 오래 운 사람은 그걸 압니다.",
  "sec": 7.611
 },
 {
  "num": "202",
  "scene": "S40",
  "text": "그러니 우는 사람을 함부로 웃지 마시게. 그 울음값을 아는 건 울어 본 사람뿐이올시다.",
  "sec": 10.011
 },
 {
  "num": "203",
  "scene": "S41",
  "text": "그런데 말이오. 그 연이가 나중에 제 재산으로 곡비들 쉴 집을 지었다지 않습니까.",
  "sec": 7.411
 },
 {
  "num": "204",
  "scene": "S41",
  "text": "초상집 다니던 여인들이 늙으면 거기서 지냈다지요. 허허, 그 이야기는 다음에 또 해 드리리다.",
  "sec": 9.131
 },
 {
  "num": "205",
  "scene": "S42",
