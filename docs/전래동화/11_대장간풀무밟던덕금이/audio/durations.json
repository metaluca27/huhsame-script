[
 {
  "num": "001",
  "scene": "S01",
  "text": "관아 마당에 부러진 농기구가 산처럼 쌓였습니다.",
  "sec": 5.331
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "낫은 날이 뚝 부러지고, 호미는 자루에서 빠졌지요.",
  "sec": 6.451
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "백 자루가 봄 논갈이 한 번에 다 그 꼴이 났어요.",
  "sec": 6.211
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "그런데 그걸 풀어낸 사람이, 망치 한 번 잡아 본 적 없는 여인이었답니다.",
  "sec": 6.691
 },
 {
  "num": "005",
  "scene": "S02",
  "text": "\"이 부러진 자리를 좀 보십시오.\"",
  "sec": 4.291
 },
 {
  "num": "006",
  "scene": "S02",
  "text": "고을 사람들이 여자가 무슨 쇠를 아느냐고 비웃던 참이었어요.",
  "sec": 7.531
 },
 {
  "num": "007",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 6.491
 },
 {
  "num": "008",
  "scene": "S03",
  "text": "오늘도 먼 길 오셨으니, 편히 앉아 들어들 보시게.",
  "sec": 5.851
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 5.971
 },
 {
  "num": "010",
  "scene": "S05",
  "text": "옛날 옛적, 강원도 어느 고을에 덕금이라는 여인이 있었습니다.",
  "sec": 7.371
 },
 {
  "num": "011",
  "scene": "S05",
  "text": "덕금이는 대장간에서 풀무를 밟았어요.",
  "sec": 4.971
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "풀무란 화덕에 바람을 넣어 불을 올리는 물건이었지요.",
  "sec": 5.411
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "발로 널을 밟으면 바람이 들어가고, 바람이 들어가면 불이 세집니다.",
  "sec": 7.411
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "쇠를 두드리는 건 망치지만, 쇠를 달구는 건 풀무였어요.",
  "sec": 7.291
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "그러니 대장간 일의 절반은 풀무에서 났던 겁니다.",
  "sec": 5.091
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "풀무 널은 어른 키만큼 길었어요.",
  "sec": 5.091
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "하루 종일 밟으면 종아리가 돌덩이처럼 뭉쳤습니다.",
  "sec": 5.731
 },
 {
  "num": "018",
  "scene": "S06",
  "text": "덕금이는 열아홉에 대장장이한테 시집을 갔어요.",
  "sec": 6.291
 },
 {
  "num": "019",
  "scene": "S06",
  "text": "시집오던 날부터 풀무를 밟았지요.",
  "sec": 4.451
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "남편이 망치를 들면 덕금이가 불을 올렸습니다.",
  "sec": 5.091
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "부부가 한 호흡이라야 쇠가 제대로 붙었거든요.",
  "sec": 5.411
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "그렇게 일곱 해를 살았어요.",
  "sec": 3.331
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "남편은 덕금이한테 불 보는 법을 가르쳐 주었어요.",
  "sec": 5.291
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "\"쇠는 제 색으로 말을 한다. 귀로 듣지 말고 눈으로 들어라.\"",
  "sec": 7.571
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "그 말을 덕금이는 평생 잊지 않았습니다.",
  "sec": 6.291
 },
 {
  "num": "026",
  "scene": "S07",
  "text": "그런데 덕금이가 스물여섯 되던 해에 남편이 죽었습니다.",
  "sec": 6.571
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "쇳물이 튀어 눈을 다친 뒤로 시름시름 앓다 간 것이었어요.",
  "sec": 7.371
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "그날부터 대장간 화덕이 꺼졌지요.",
  "sec": 3.851
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "아이도 없었고, 기댈 데도 없었습니다.",
  "sec": 4.531
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "스물여섯에 혼자가 된 겁니다.",
  "sec": 3.251
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "화덕은 사흘 만에 재까지 식어 버렸어요.",
  "sec": 4.931
 },
 {
  "num": "032",
  "scene": "S08",
  "text": "시집 식구들이 대장간을 팔라고 했어요.",
  "sec": 4.571
 },
 {
  "num": "033",
  "scene": "S08",
  "text": "\"여자가 대장간을 어찌 끌고 가겠느냐.\"",
  "sec": 4.251
 },
 {
  "num": "034",
  "scene": "S08",
  "text": "그도 그럴 것이, 여자는 망치를 잡을 수 없던 시절이었습니다.",
  "sec": 5.931
 },
 {
  "num": "035",
  "scene": "S08",
  "text": "쇠를 두드리는 건 남자 일이라고 정해져 있었으니까요.",
  "sec": 5.211
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "그런데 덕금이가 이렇게 말했어요.",
  "sec": 3.931
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "\"망치는 못 잡습니다. 그래도 화덕 불은 제가 봅니다.\"",
  "sec": 6.091
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "시집 식구들은 어이가 없어 웃었어요.",
  "sec": 4.611
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "\"불을 본다고 쇠가 되느냐.\"",
  "sec": 3.851
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "덕금이는 더 말하지 않고 그날로 화덕에 숯을 넣었습니다.",
  "sec": 5.611
 },
 {
  "num": "041",
  "scene": "S09",
  "text": "덕금이는 대장간을 팔지 않았어요.",
  "sec": 4.051
 },
 {
  "num": "042",
  "scene": "S09",
  "text": "대신 이웃 고을에서 젊은 야장 하나를 들였습니다.",
  "sec": 4.731
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "망치는 그 사람이 잡고, 풀무는 덕금이가 밟았지요.",
  "sec": 5.571
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "그렇게 화덕에 다시 불이 올랐답니다.",
  "sec": 3.931
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "삯은 절반씩 나누기로 했어요.",
  "sec": 3.931
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "망치 든 사람과 풀무 밟는 사람이 같은 몫이라는 건, 그 시절엔 드문 일이었지요.",
  "sec": 7.971
 },
 {
  "num": "047",
  "scene": "S10",
  "text": "고을 사람들은 처음엔 그 대장간 물건을 안 샀어요.",
  "sec": 5.211
 },
 {
  "num": "048",
  "scene": "S10",
  "text": "\"여자가 낀 대장간 쇠가 성하겠나\" 했지요.",
  "sec": 4.691
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "그런데 한 해 두 해 지나면서 말이 바뀌었습니다.",
  "sec": 5.131
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "덕금이네 낫은 삼 년을 써도 날이 안 나갔거든요.",
  "sec": 5.771
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "이웃 고을에서까지 사러 오는 사람이 생겼어요.",
  "sec": 3.891
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "\"덕금이네 낫은 밭에서 안 부러진다\"는 말이 돌았거든요.",
  "sec": 6.451
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "야장은 세 번 바뀌었는데 대장간 이름은 그대로였습니다.",
  "sec": 6.531
 },
 {
  "num": "054",
  "scene": "S11",
  "text": "덕금이한테는 남들이 모르는 눈이 하나 있었어요.",
  "sec": 5.211
 },
 {
  "num": "055",
  "scene": "S11",
  "text": "불빛만 보고 쇠가 얼마나 달았는지 아는 눈이었지요.",
  "sec": 5.571
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "쇠는 달수록 빛이 바뀝니다.",
  "sec": 4.131
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "처음엔 검붉고, 더 달면 주황이 되고, 더 달면 노래지고, 끝에는 하얘져요.",
  "sec": 9.171
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "붉은 불에서 두드리면 겉만 붙고 속은 안 붙습니다.",
  "sec": 5.491
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "노란 불까지 기다려야 쇠와 쇠가 한 몸이 되지요.",
  "sec": 5.051
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "덕금이는 그걸 삼십 년 풀무를 밟으며 눈에 익혔던 겁니다.",
  "sec": 5.931
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "불빛이 조금만 달라져도 덕금이는 발을 멈췄어요.",
  "sec": 6.131
 },
 {
  "num": "062",
  "scene": "S11",
  "text": "\"아직 아니야. 한 번 더.\" 하고 널을 다시 밟았지요.",
  "sec": 6.851
 },
 {
  "num": "063",
  "scene": "S11",
  "text": "그 기다림이 낫 한 자루의 수명을 삼 년씩 늘렸습니다.",
  "sec": 6.571
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "그래도 고을에서는 늘 이런 말이 따라다녔어요.",
  "sec": 4.731
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "\"저 집은 여편네가 불을 본다며.\"",
  "sec": 4.251
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "\"여자가 쇠를 뭘 알겠나. 옆에 야장이 잘하는 게지.\"",
  "sec": 5.531
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "덕금이는 그 말에 대꾸한 적이 한 번도 없었습니다.",
  "sec": 4.731
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "대꾸할 시간에 풀무를 한 번 더 밟았지요.",
  "sec": 4.211
 },
 {
  "num": "069",
  "scene": "S12",
  "text": "말로 이기는 건 덕금이 일이 아니었으니까요.",
  "sec": 4.891
 },
 {
  "num": "070",
  "scene": "S12",
  "text": "쇠는 말을 안 듣고 불만 듣는다는 걸 알았던 겁니다.",
  "sec": 6.011
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "그해 겨울, 관아에서 명이 내려왔어요.",
  "sec": 5.051
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "봄 논갈이에 쓸 농기구 백 자루를 새로 맞추라는 것이었습니다.",
  "sec": 6.371
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "고을 대장간들이 다 모였지요.",
  "sec": 4.011
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "값도 값이지만 관아 일을 맡으면 이름이 나는 법이었거든요.",
  "sec": 6.091
 },
 {
  "num": "075",
  "scene": "S13",
  "text": "고을 대장간이 다섯이었는데 다들 눈에 불을 켰어요.",
  "sec": 6.131
 },
 {
  "num": "076",
  "scene": "S13",
  "text": "덕금이네도 갔지만 아무도 여자 쪽을 거들떠보지 않았습니다.",
  "sec": 6.651
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "그 일을 봉수라는 대장장이가 맡았어요.",
  "sec": 4.051
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "고을에서 제일 큰 대장간을 하던 사람이었지요.",
  "sec": 4.131
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "일꾼이 셋이고 화덕이 둘이라, 덕금이네와는 규모가 달랐습니다.",
  "sec": 7.051
 },
 {
  "num": "080",
  "scene": "S14",
  "text": "관아에서도 당연히 그쪽에 맡겼고요.",
  "sec": 4.211
 },
 {
  "num": "081",
  "scene": "S14",
  "text": "덕금이네는 쇠만 조금 대 주기로 했어요.",
  "sec": 5.171
 },
 {
  "num": "082",
  "scene": "S14",
  "text": "쓰다 남은 무쇠 스무 덩이를 값도 받지 않고 내주었지요.",
  "sec": 5.931
 },
 {
  "num": "083",
  "scene": "S14",
  "text": "같은 고을 대장간끼리 흔히 그러던 일이었습니다.",
  "sec": 4.851
 },
 {
  "num": "084",
  "scene": "S15",
  "text": "그런데 기한이 너무 짧았어요.",
  "sec": 3.571
 },
 {
  "num": "085",
  "scene": "S15",
  "text": "석 달 걸릴 일을 한 달 반에 내라 한 것이었습니다.",
  "sec": 5.211
 },
 {
  "num": "086",
  "scene": "S15",
  "text": "봉수는 밤낮없이 두드렸지요.",
  "sec": 3.811
 },
 {
  "num": "087",
  "scene": "S15",
  "text": "그러다 보니 불이 오르기를 다 기다리지 못했어요.",
  "sec": 4.691
 },
 {
  "num": "088",
  "scene": "S15",
  "text": "쇠가 아직 검붉을 때 망치를 댄 겁니다.",
  "sec": 5.251
 },
 {
  "num": "089",
  "scene": "S15",
  "text": "겉보기에는 멀쩡한 낫이 되었고요.",
  "sec": 4.171
 },
 {
  "num": "090",
  "scene": "S15",
  "text": "봉수도 그게 께름칙했어요.",
  "sec": 3.371
 },
 {
  "num": "091",
  "scene": "S15",
  "text": "그래도 기한을 어기면 관아에 끌려가는 건 자기였으니까요.",
  "sec": 5.971
 },
 {
  "num": "092",
  "scene": "S15",
  "text": "\"한 해만 버텨 주면 된다\" 하고 넘긴 겁니다.",
  "sec": 4.771
 },
 {
  "num": "093",
  "scene": "S16",
  "text": "이듬해 봄, 고을 사람들이 그 농기구를 받아 논으로 나갔어요.",
  "sec": 6.451
 },
 {
  "num": "094",
  "scene": "S16",
  "text": "그런데 첫날부터 일이 났습니다.",
  "sec": 4.571
 },
 {
  "num": "095",
  "scene": "S16",
  "text": "호미 날이 자루에서 쑥 빠지고, 낫이 밑동에서 뚝 부러졌지요.",
  "sec": 8.931
 },
 {
  "num": "096",
  "scene": "S16",
  "text": "하나둘이 아니었어요. 백 자루가 거의 다 그랬습니다.",
  "sec": 5.891
 },
 {
  "num": "097",
  "scene": "S16",
  "text": "봄 논갈이가 통째로 멈춰 버렸어요.",
  "sec": 3.691
 },
 {
  "num": "098",
  "scene": "S16",
  "text": "그 시절 봄 열흘을 놓치면 한 해 농사가 날아갔습니다.",
  "sec": 5.291
 },
 {
  "num": "099",
  "scene": "S16",
  "text": "고을 사람들 얼굴이 새파랗게 질렸지요.",
  "sec": 4.171
 },
 {
  "num": "100",
  "scene": "S17",
  "text": "농부들이 부러진 농기구를 지고 관아로 몰려갔어요.",
  "sec": 5.091
 },
 {
  "num": "101",
  "scene": "S17",
  "text": "마당에 그걸 우르르 쏟아 놓았지요.",
  "sec": 3.331
 },
 {
  "num": "102",
  "scene": "S17",
  "text": "\"이걸로 무슨 농사를 짓습니까!\"",
  "sec": 3.211
 },
 {
  "num": "103",
  "scene": "S17",
  "text": "관아 물건이 이 꼴이 났으니 그냥 넘어갈 일이 아니었어요.",
  "sec": 6.371
 },
 {
  "num": "104",
  "scene": "S17",
  "text": "사또는 대장장이들을 전부 불러들였습니다.",
  "sec": 4.571
 },
 {
  "num": "105",
  "scene": "S17",
  "text": "관아 물건을 망친 죄는 곤장으로 끝나지 않았어요.",
  "sec": 5.211
 },
 {
  "num": "106",
  "scene": "S17",
  "text": "대장간 문을 닫게 하는 일도 흔했습니다.",
  "sec": 4.571
 },
 {
  "num": "107",
  "scene": "S18",
  "text": "대장장이들이 관아 마당에 불려 왔어요.",
  "sec": 4.171
 },
 {
  "num": "108",
  "scene": "S18",
  "text": "관아 물건을 망친 죄는 가볍지 않았습니다.",
  "sec": 4.971
 },
 {
  "num": "109",
  "scene": "S18",
  "text": "곤장을 맞고 장사를 못 하게 될 수도 있었지요.",
  "sec": 4.611
 },
 {
  "num": "110",
  "scene": "S18",
  "text": "다들 고개를 들지 못했어요.",
  "sec": 3.451
 },
 {
  "num": "111",
  "scene": "S18",
  "text": "누가 만들었는지는 이미 다 아는 일이었고요.",
  "sec": 4.491
 },
 {
  "num": "112",
  "scene": "S18",
  "text": "다만 아무도 먼저 입을 열지 않았습니다.",
  "sec": 4.651
 },
 {
  "num": "113",
  "scene": "S19",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 4.811
 },
 {
  "num": "114",
  "scene": "S19",
  "text": "일이 이렇게 되면 사람들은 꼭 누구 탓인지부터 찾지요.",
  "sec": 6.491
 },
 {
  "num": "115",
  "scene": "S19",
  "text": "그리고 제일 만만한 쪽을 찾습니다.",
  "sec": 3.731
 },
 {
  "num": "116",
  "scene": "S20",
  "text": "그때 봉수가 입을 열었어요.",
  "sec": 2.571
 },
 {
  "num": "117",
  "scene": "S20",
  "text": "\"소인이 두드린 솜씨야 고을이 다 압니다.\"",
  "sec": 4.211
 },
 {
  "num": "118",
  "scene": "S20",
  "text": "\"다만 쇠가 나빴습니다.\"",
  "sec": 2.811
 },
 {
  "num": "119",
  "scene": "S20",
  "text": "\"그 쇠, 덕금이네 대장간에서 받은 것이올시다.\"",
  "sec": 4.891
 },
 {
  "num": "120",
  "scene": "S20",
  "text": "여자가 하는 대장간이니 만만했던 겁니다.",
  "sec": 4.931
 },
 {
  "num": "121",
  "scene": "S20",
  "text": "마당에 있던 사람들이 고개를 끄덕였어요.",
  "sec": 4.291
 },
 {
  "num": "122",
  "scene": "S20",
  "text": "\"하기야 여편네가 고른 쇠니.\"",
  "sec": 3.891
 },
 {
  "num": "123",
  "scene": "S20",
  "text": "말 한마디에 죄가 그쪽으로 옮겨 가는 건 순식간이었습니다.",
  "sec": 6.731
 },
 {
  "num": "124",
  "scene": "S21",
  "text": "덕금이가 관아 마당에 불려 나왔어요.",
  "sec": 4.171
 },
 {
  "num": "125",
  "scene": "S21",
  "text": "마당에 있던 사람들이 다 쳐다봤지요.",
  "sec": 3.771
 },
 {
  "num": "126",
  "scene": "S21",
  "text": "쉰이 넘은 여인 하나가 대장장이들 앞에 선 것이었습니다.",
  "sec": 5.851
 },
 {
  "num": "127",
  "scene": "S21",
  "text": "\"쇠를 댄 것이 네가 맞느냐.\"",
  "sec": 3.571
 },
 {
  "num": "128",
  "scene": "S21",
  "text": "\"맞습니다.\" 덕금이가 대답했어요.",
  "sec": 3.931
 },
 {
  "num": "129",
  "scene": "S21",
  "text": "\"그 쇠, 제가 고르고 제가 내주었습니다.\"",
  "sec": 5.051
 },
 {
  "num": "130",
  "scene": "S21",
  "text": "변명 한마디 없는 대답에 마당이 오히려 조용해졌지요.",
  "sec": 5.931
 },
 {
  "num": "131",
  "scene": "S22",
  "text": "그런데 덕금이는 변명을 하지 않았어요.",
  "sec": 4.731
 },
 {
  "num": "132",
  "scene": "S22",
  "text": "대신 마당에 쌓인 부러진 낫 하나를 집어 들었습니다.",
  "sec": 5.171
 },
 {
  "num": "133",
  "scene": "S22",
  "text": "그리고 부러진 자리를 햇빛에 비춰 보았지요.",
  "sec": 5.211
 },
 {
  "num": "134",
  "scene": "S22",
  "text": "한참을 들여다보더니 이렇게 말했어요.",
  "sec": 4.851
 },
 {
  "num": "135",
  "scene": "S22",
  "text": "\"사또, 이 부러진 자리를 좀 보십시오.\"",
  "sec": 4.651
 },
 {
  "num": "136",
  "scene": "S22",
  "text": "덕금이는 부러진 낫을 두 손으로 받쳐 들었어요.",
  "sec": 5.251
 },
 {
  "num": "137",
  "scene": "S22",
  "text": "손끝이 떨리지도 않았습니다.",
  "sec": 3.171
 },
 {
  "num": "138",
  "scene": "S23",
  "text": "\"쇠가 제대로 달아서 붙은 자리는 은빛으로 곱습니다.\"",
  "sec": 6.131
 },
 {
  "num": "139",
  "scene": "S23",
  "text": "\"그런데 이건 보십시오. 검은 켜가 겹겹이 있지요.\"",
  "sec": 6.211
 },
 {
  "num": "140",
  "scene": "S23",
  "text": "\"이건 쇠가 나쁜 게 아닙니다.\"",
  "sec": 3.371
 },
 {
  "num": "141",
  "scene": "S23",
  "text": "\"덜 단 쇠를 두드려서 겉만 붙은 겁니다.\"",
  "sec": 4.611
 },
 {
  "num": "142",
  "scene": "S23",
  "text": "\"속은 처음부터 붙지 않았던 거예요.\"",
  "sec": 4.251
 },
 {
  "num": "143",
  "scene": "S23",
  "text": "\"쇠가 나쁘면 부러진 자리가 푸석푸석합니다.\"",
  "sec": 5.811
 },
 {
  "num": "144",
  "scene": "S23",
  "text": "\"그런데 이건 매끈하게 켜가 졌어요. 이건 불이 낮았던 탓입니다.\"",
  "sec": 8.171
 },
 {
  "num": "145",
  "scene": "S24",
  "text": "마당에서 웃음이 터졌어요.",
  "sec": 2.851
 },
 {
  "num": "146",
  "scene": "S24",
  "text": "\"여편네가 쇠 부러진 걸 보고 뭘 안다고.\"",
  "sec": 4.491
 },
 {
  "num": "147",
  "scene": "S24",
  "text": "\"풀무나 밟던 사람이 말이오.\"",
  "sec": 2.571
 },
 {
  "num": "148",
  "scene": "S24",
  "text": "봉수도 코웃음을 쳤지요.",
  "sec": 3.371
 },
 {
  "num": "149",
  "scene": "S24",
  "text": "\"쇠를 아는 건 망치를 들어 본 사람입니다.\"",
  "sec": 4.651
 },
 {
  "num": "150",
  "scene": "S24",
  "text": "\"풀무는 발로 밟는 것 아닙니까.\"",
  "sec": 3.411
 },
 {
  "num": "151",
  "scene": "S25",
  "text": "그런데 덕금이가 사또한테 이렇게 청했습니다. 탁!",
  "sec": 8.091
 },
 {
  "num": "152",
  "scene": "S26",
  "text": "\"말로는 못 믿으실 겁니다. 그러니 보여 드리겠습니다.\"",
  "sec": 5.451
 },
 {
  "num": "153",
  "scene": "S26",
  "text": "\"이 마당에 화덕 하나만 놓게 해 주십시오.\"",
  "sec": 4.251
 },
 {
  "num": "154",
  "scene": "S26",
  "text": "\"같은 쇠로 두 개를 만들어 보이겠습니다.\"",
  "sec": 5.091
 },
 {
  "num": "155",
  "scene": "S26",
  "text": "\"하나는 붉은 불에서, 하나는 노란 불에서요.\"",
  "sec": 5.411
 },
 {
  "num": "156",
  "scene": "S26",
  "text": "사또가 고개를 끄덕였어요.",
  "sec": 3.291
 },
 {
  "num": "157",
  "scene": "S26",
  "text": "잃을 게 없는 판이었으니까요.",
  "sec": 2.891
 },
 {
  "num": "158",
  "scene": "S26",
  "text": "어차피 농기구는 이미 다 부러진 뒤였습니다.",
  "sec": 5.091
 },
 {
  "num": "159",
  "scene": "S27",
  "text": "관아 마당에 화덕이 놓였어요.",
  "sec": 3.251
 },
 {
  "num": "160",
  "scene": "S27",
  "text": "덕금이네 대장간에서 풀무와 모루도 실어 왔지요.",
  "sec": 5.211
 },
 {
  "num": "161",
  "scene": "S27",
  "text": "고을 사람들이 구경하러 마당 가득 몰려들었습니다.",
  "sec": 5.851
 },
 {
  "num": "162",
  "scene": "S27",
  "text": "여자가 관아 마당에서 불을 피운다는 건 처음 있는 일이었으니까요.",
  "sec": 6.651
 },
 {
  "num": "163",
  "scene": "S27",
  "text": "장에 나왔던 사람들까지 다 모여들었어요.",
  "sec": 4.291
 },
 {
  "num": "164",
  "scene": "S27",
  "text": "담 위에 올라앉은 아이들도 있었습니다.",
  "sec": 4.091
 },
 {
  "num": "165",
  "scene": "S28",
  "text": "덕금이가 풀무 널에 발을 올렸어요.",
  "sec": 5.491
 },
 {
  "num": "166",
  "scene": "S28",
  "text": "삼십 년을 밟은 발이었습니다.",
  "sec": 3.251
 },
 {
  "num": "167",
  "scene": "S28",
  "text": "쿵, 쿵, 쿵. 널이 내려갈 때마다 화덕이 살아났지요.",
  "sec": 8.811
 },
 {
  "num": "168",
  "scene": "S28",
  "text": "검붉던 불이 주황이 되고, 주황이 노래지고,",
  "sec": 7.011
 },
 {
  "num": "169",
  "scene": "S28",
  "text": "마침내 눈이 부시게 하얘졌습니다.",
  "sec": 4.411
 },
 {
  "num": "170",
  "scene": "S28",
  "text": "구경하던 사람들이 저도 모르게 뒤로 물러섰어요.",
  "sec": 5.291
 },
 {
  "num": "171",
  "scene": "S28",
  "text": "그렇게까지 불이 오르는 걸 본 적이 없었거든요.",
  "sec": 3.691
 },
 {
  "num": "172",
  "scene": "S29",
  "text": "덕금이는 같은 쇠를 두 덩이 준비했어요.",
  "sec": 4.851
 },
 {
  "num": "173",
  "scene": "S29",
  "text": "하나는 검붉을 때 꺼냈고,",
  "sec": 4.091
 },
 {
  "num": "174",
  "scene": "S29",
  "text": "하나는 하얘질 때까지 기다렸다 꺼냈습니다.",
  "sec": 4.931
 },
 {
  "num": "175",
  "scene": "S29",
  "text": "\"보십시오. 쇠는 같습니다. 불만 다릅니다.\"",
  "sec": 5.491
 },
 {
  "num": "176",
  "scene": "S29",
  "text": "그러고는 야장에게 똑같이 두드리게 했지요.",
  "sec": 5.531
 },
 {
  "num": "177",
  "scene": "S29",
  "text": "\"같은 손으로 치셔야 합니다.\"",
  "sec": 2.371
 },
 {
  "num": "178",
  "scene": "S29",
  "text": "덕금이는 자기가 망치를 잡지 않았어요. 그게 더 분명했으니까요.",
  "sec": 7.451
 },
 {
  "num": "179",
  "scene": "S30",
  "text": "야장이 망치를 들었어요.",
  "sec": 3.451
 },
 {
  "num": "180",
  "scene": "S30",
  "text": "같은 사람이, 같은 망치로, 같은 횟수를 두드렸습니다.",
  "sec": 5.571
 },
 {
  "num": "181",
  "scene": "S30",
  "text": "치는 힘도 똑같았고요.",
  "sec": 2.891
 },
 {
  "num": "182",
  "scene": "S30",
  "text": "다른 것은 오직 불 하나였어요.",
  "sec": 4.251
 },
 {
  "num": "183",
  "scene": "S30",
  "text": "마당에 망치 소리만 울렸습니다.",
  "sec": 4.251
 },
 {
  "num": "184",
  "scene": "S30",
  "text": "아무도 말을 하지 않았어요.",
  "sec": 3.851
 },
 {
  "num": "185",
  "scene": "S31",
  "text": "낫 두 자루가 나왔어요.",
  "sec": 3.411
 },
 {
  "num": "186",
  "scene": "S31",
  "text": "겉으로 보기에는 똑같았습니다.",
  "sec": 3.771
 },
 {
  "num": "187",
  "scene": "S31",
  "text": "색도 같고 모양도 같았지요.",
  "sec": 4.211
 },
 {
  "num": "188",
  "scene": "S31",
  "text": "마당 사람들이 목을 빼고 들여다봤어요.",
  "sec": 4.171
 },
 {
  "num": "189",
  "scene": "S31",
  "text": "\"똑같아 보이는데. 뭐가 다르다는 거요?\"",
  "sec": 4.251
 },
 {
  "num": "190",
  "scene": "S31",
  "text": "덕금이는 대답하지 않고 야장에게 눈짓을 했습니다.",
  "sec": 5.891
 },
 {
  "num": "191",
  "scene": "S32",
  "text": "덕금이가 야장에게 두 자루를 차례로 내리치게 했어요.",
  "sec": 7.291
 },
 {
  "num": "192",
  "scene": "S32",
  "text": "먼저 붉은 불에서 만든 것을 쳤습니다.",
  "sec": 4.331
 },
 {
  "num": "193",
  "scene": "S32",
  "text": "\"딱!\" 소리와 함께 밑동에서 뚝 부러졌지요.",
  "sec": 5.491
 },
 {
  "num": "194",
  "scene": "S32",
  "text": "다음은 하얀 불에서 만든 것이었어요.",
  "sec": 4.251
 },
 {
  "num": "195",
  "scene": "S32",
  "text": "그건 부러지지 않고 휘기만 했습니다.",
  "sec": 4.571
 },
 {
  "num": "196",
  "scene": "S32",
  "text": "두 번을 더 쳤는데도 휘기만 할 뿐이었어요.",
  "sec": 5.011
 },
 {
  "num": "197",
  "scene": "S32",
  "text": "마당에서 누군가 \"아이고\" 하는 소리가 났습니다.",
  "sec": 5.251
 },
 {
  "num": "198",
  "scene": "S33",
  "text": "마당이 조용해졌어요.",
  "sec": 2.891
 },
 {
  "num": "199",
  "scene": "S33",
  "text": "덕금이가 두 자루를 양손에 들어 보였습니다.",
  "sec": 4.291
 },
 {
  "num": "200",
  "scene": "S33",
  "text": "\"쇠는 같았습니다. 불이 달랐습니다.\"",
  "sec": 5.251
 },
 {
  "num": "201",
  "scene": "S33",
  "text": "\"쇠가 나빴던 게 아니라, 불을 덜 올린 겁니다.\"",
  "sec": 5.371
 },
 {
  "num": "202",
  "scene": "S33",
  "text": "\"쇠는 죄가 없습니다. 기다려 주지 않은 사람이 있었을 뿐이지요.\"",
  "sec": 6.411
 },
 {
  "num": "203",
  "scene": "S34",
  "text": "허허, 여기서 이야기가 끝났으면 그저 시원한 이야기지요.",
  "sec": 6.011
 },
 {
  "num": "204",
  "scene": "S34",
  "text": "그런데 덕금이가 한마디를 더 보탰다지 않습니까.",
  "sec": 5.531
 },
 {
  "num": "205",
  "scene": "S35",
  "text": "봉수의 얼굴이 하얗게 굳었어요.",
  "sec": 4.051
 },
 {
  "num": "206",
  "scene": "S35",
  "text": "기한에 쫓겨 불을 덜 올린 걸 본인이 제일 잘 알았으니까요.",
  "sec": 6.811
 },
 {
  "num": "207",
  "scene": "S35",
  "text": "마당 사람들의 눈이 전부 그쪽으로 옮겨 갔습니다.",
  "sec": 5.331
 },
 {
  "num": "208",
  "scene": "S35",
  "text": "그런데 덕금이가 사또를 향해 이렇게 말했어요.",
  "sec": 5.251
 },
 {
  "num": "209",
  "scene": "S35",
  "text": "마당 사람들은 덕금이가 봉수를 벌하라 할 줄 알았어요.",
  "sec": 5.771
 },
 {
  "num": "210",
  "scene": "S35",
  "text": "그런데 나온 말은 정반대였습니다.",
  "sec": 4.011
 },
 {
  "num": "211",
  "scene": "S36",
  "text": "\"이 사람을 벌하지 마십시오.\"",
  "sec": 4.651
 },
 {
  "num": "212",
  "scene": "S36",
  "text": "\"석 달 걸릴 일을 한 달 반에 내라 하셨으니, 불을 못 기다린 겁니다.\"",
  "sec": 8.171
 },
 {
  "num": "213",
  "scene": "S36",
  "text": "\"대장장이가 불을 못 기다리면, 그건 대장장이 죄가 절반입니다.\"",
  "sec": 7.331
 },
 {
  "num": "214",
  "scene": "S36",
  "text": "\"나머지 절반은 기한을 그리 잡은 쪽에 있지요.\"",
  "sec": 4.171
 },
 {
  "num": "215",
  "scene": "S36",
  "text": "봉수가 그 자리에 무릎을 꿇었습니다.",
  "sec": 5.691
 },
 {
  "num": "216",
  "scene": "S36",
  "text": "제 죄를 덮어씌운 사람 앞이었는데도요.",
  "sec": 4.171
 },
 {
  "num": "217",
  "scene": "S36",
  "text": "\"내가 사람을 잘못 봤소.\" 그 한마디를 하고 한참 일어나지 못했답니다.",
  "sec": 8.411
 },
 {
  "num": "218",
  "scene": "S37",
  "text": "사또는 곤장을 치지 않았어요.",
  "sec": 3.691
 },
 {
  "num": "219",
  "scene": "S37",
  "text": "대신 농기구를 다시 만들게 하면서 기한을 넉 달로 늘렸습니다.",
  "sec": 7.251
 },
 {
  "num": "220",
  "scene": "S37",
  "text": "그리고 덕금이에게 이렇게 물었지요.",
  "sec": 4.091
 },
 {
  "num": "221",
  "scene": "S37",
  "text": "\"네가 그 일을 맡겠느냐.\"",
  "sec": 4.171
 },
 {
  "num": "222",
  "scene": "S37",
  "text": "\"망치는 제가 못 잡습니다. 대신 불은 제가 보겠습니다.\"",
  "sec": 6.131
 },
 {
  "num": "223",
  "scene": "S37",
  "text": "사또가 껄껄 웃었어요.",
  "sec": 3.011
 },
 {
  "num": "224",
  "scene": "S37",
  "text": "\"그 말은 아까도 들었다. 그럼 그리하라.\"",
  "sec": 4.971
 },
 {
  "num": "225",
  "scene": "S38",
  "text": "그해 봄 농기구는 넉 달에 걸쳐 다시 만들어졌어요.",
  "sec": 6.611
 },
 {
  "num": "226",
  "scene": "S38",
  "text": "봉수네 대장간에서 만들었고, 불은 덕금이가 봤습니다.",
  "sec": 6.811
 },
 {
  "num": "227",
  "scene": "S38",
  "text": "그 농기구는 십 년을 썼다고 해요.",
  "sec": 4.331
 },
 {
  "num": "228",
  "scene": "S38",
  "text": "그 뒤로 고을 대장간들이 큰일을 맡으면 덕금이를 불렀어요.",
  "sec": 7.411
 },
 {
  "num": "229",
  "scene": "S38",
  "text": "\"불 좀 봐 주시오\" 하고 말이지요.",
  "sec": 3.971
 },
 {
  "num": "230",
  "scene": "S38",
  "text": "삯은 망치 든 사람과 똑같이 받았습니다.",
  "sec": 4.291
 },
 {
  "num": "231",
  "scene": "S38",
  "text": "덕금이가 그렇게 정했거든요.",
  "sec": 3.451
 },
 {
  "num": "232",
  "scene": "S39",
  "text": "덕금이는 늘그막에 어린 계집아이 하나를 데려다 가르쳤어요.",
  "sec": 6.971
 },
 {
  "num": "233",
  "scene": "S39",
  "text": "동네에서 부모 잃은 아이였지요.",
  "sec": 3.491
 },
 {
  "num": "234",
  "scene": "S39",
  "text": "가르칠 때 첫마디는 늘 같았습니다.",
  "sec": 4.851
 },
 {
  "num": "235",
  "scene": "S39",
  "text": "\"불이 노래질 때까지 기다려라.\"",
  "sec": 4.011
 },
 {
  "num": "236",
  "scene": "S39",
  "text": "\"급하게 달군 쇠는 꼭 봄에 부러진다.\"",
  "sec": 4.931
 },
 {
  "num": "237",
  "scene": "S39",
  "text": "아이는 처음엔 불빛이 다 똑같아 보인다고 했어요.",
  "sec": 5.891
 },
 {
  "num": "238",
  "scene": "S39",
  "text": "덕금이는 웃으며 말했습니다. \"석 달만 밟아 봐라. 눈이 생긴다.\"",
  "sec": 6.851
 },
 {
  "num": "239",
  "scene": "S40",
  "text": "덕금이는 예순이 넘도록 그 화덕 앞에 섰다고 합니다.",
  "sec": 6.131
 },
 {
  "num": "240",
  "scene": "S40",
  "text": "고을 사람들은 그때쯤 덕금이를 이렇게 불렀어요.",
  "sec": 7.331
 },
 {
  "num": "241",
  "scene": "S40",
  "text": "\"여편네가 불 보는 집\"이 아니라, \"불 보는 어른\"이라고요.",
  "sec": 6.211
 },
 {
  "num": "242",
  "scene": "S41",
  "text": "허허, 어떻습니까. 망치 한 번 못 잡은 사람이, 망치 잡은 사람들을 다 살렸지요.",
  "sec": 8.531
 },
 {
  "num": "243",
  "scene": "S41",
  "text": "세상에는 두드리는 사람만 보입니다. 그런데 불을 올리는 사람이 없으면 쇠는 붙지 않아요.",
  "sec": 8.971
 },
 {
  "num": "244",
  "scene": "S41",
  "text": "그리고 말이오. 급하게 만든 것은 꼭 봄에 부러집니다. 사람 일도 그렇고요.",
  "sec": 8.651
 },
 {
  "num": "245",
  "scene": "S42",
  "text": "그런데 말이오. 그 아이가 자라서 고을 제일가는 야장이 되었다지 않습니까.",
  "sec": 8.731
 },
 {
  "num": "246",
  "scene": "S42",
  "text": "여자가 망치를 잡은 첫 번째였다지요. 허허, 그 이야기는 다음에 또 해 드리리다.",
  "sec": 9.411
 },
 {
  "num": "247",
  "scene": "S43",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 4.851
 },
 {
  "num": "248",
  "scene": "S43",
  "text": "다음 이야기가 궁금하시면, 엽전 대신 구독 한 번 눌러 주시게.",
  "sec": 6.331
 },
 {
  "num": "249",
  "scene": "S43",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 5.491
 }
]