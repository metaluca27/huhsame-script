[
 {
  "num": "001",
  "scene": "S01",
  "text": "그해 겨울, 온 마을이 굶었습니다.",
  "sec": 4.811
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "쌀 한 되가 소 한 마리 값이었어요.",
  "sec": 4.531
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "그런데 한 집에서 곳간이 아니라 뒤란 헛간 문이 열렸습니다.",
  "sec": 7.531
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "십 년 동안 아무도 들여다보지 않던 문이었지요.",
  "sec": 5.851
 },
 {
  "num": "005",
  "scene": "S01",
  "text": "그 집 며느리가 혼자 드나들던 자리였습니다.",
  "sec": 4.851
 },
 {
  "num": "006",
  "scene": "S02",
  "text": "시어머니가 그 안을 보고 한참을 말을 못 했어요.",
  "sec": 5.091
 },
 {
  "num": "007",
  "scene": "S02",
  "text": "십 년을 구박한 며느리의 헛간이었습니다.",
  "sec": 4.971
 },
 {
  "num": "008",
  "scene": "S02",
  "text": "그날 그 헛간이 마흔 집을 살렸어요.",
  "sec": 4.731
 },
 {
  "num": "009",
  "scene": "S02",
  "text": "먼저 그 십 년부터 들려드리지요.",
  "sec": 3.811
 },
 {
  "num": "010",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 6.931
 },
 {
  "num": "011",
  "scene": "S03",
  "text": "오늘은 밥 이야기올시다. 배부른 이야기는 아니지만요.",
  "sec": 7.091
 },
 {
  "num": "012",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 6.011
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "옛날 옛적, 황해도 어느 고을에 곡산댁이라는 며느리가 있었습니다.",
  "sec": 6.771
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "열아홉에 시집와 십 년을 그 집에서 살았지요.",
  "sec": 4.491
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "곡산댁은 손이 컸어요.",
  "sec": 3.451
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "밥을 지으면 늘 한 솥이 남았습니다.",
  "sec": 4.211
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "식구가 여섯인데 열 사람 먹을 밥을 앉혔거든요.",
  "sec": 5.491
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "남은 밥은 말려서 항아리에 넣었어요.",
  "sec": 4.731
 },
 {
  "num": "019",
  "scene": "S05",
  "text": "그걸 옛날에는 건량이라고 했습니다.",
  "sec": 3.611
 },
 {
  "num": "020",
  "scene": "S05",
  "text": "말려 두면 몇 해를 가거든요.",
  "sec": 3.651
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "시어머니는 그걸 볼 때마다 혀를 찼습니다.",
  "sec": 4.891
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "\"밥을 그리 많이 해서 어쩌자는 게냐.\"",
  "sec": 4.811
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "\"솥에 넣는 쌀이 어디서 나오는 줄은 아느냐.\"",
  "sec": 4.891
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "곡산댁은 대답하지 않았어요.",
  "sec": 3.211
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "그저 고개를 숙이고 불을 뺐습니다.",
  "sec": 4.931
 },
 {
  "num": "026",
  "scene": "S06",
  "text": "말대꾸를 하는 며느리가 아니었거든요.",
  "sec": 4.091
 },
 {
  "num": "027",
  "scene": "S06",
  "text": "그런데 이듬해에도 밥은 똑같이 한 솥이 남았어요.",
  "sec": 6.011
 },
 {
  "num": "028",
  "scene": "S06",
  "text": "시어머니 눈에는 그게 더 괘씸했지요.",
  "sec": 4.051
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "장을 담글 때는 더했어요.",
  "sec": 3.531
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "보통 집이 서너 독을 담그면 곡산댁은 스무 독을 담갔습니다.",
  "sec": 7.331
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "된장, 간장, 고추장에 젓갈까지요.",
  "sec": 5.251
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "장독대가 모자라 뒤란까지 독이 넘어갔어요.",
  "sec": 5.011
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "콩값이 그해 살림에서 제일 큰 몫이었지요.",
  "sec": 4.931
 },
 {
  "num": "034",
  "scene": "S07",
  "text": "장은 한 해 묵으면 맛이 들고, 세 해 묵으면 약이 됩니다.",
  "sec": 7.251
 },
 {
  "num": "035",
  "scene": "S07",
  "text": "곡산댁은 담근 해를 독마다 새겨 두었어요.",
  "sec": 6.091
 },
 {
  "num": "036",
  "scene": "S07",
  "text": "묵은 것부터 쓰지 않고, 새것부터 썼습니다.",
  "sec": 5.011
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "시어머니가 장독대에서 소리를 질렀습니다.",
  "sec": 5.131
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "\"이 집이 무슨 대갓집인 줄 아느냐!\"",
  "sec": 3.771
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "\"저러다 집 말아먹는다, 내가 못 살아.\"",
  "sec": 4.211
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "\"친정에서 대체 뭘 배워 온 게야.\"",
  "sec": 3.571
 },
 {
  "num": "041",
  "scene": "S08",
  "text": "그 말에 곡산댁의 어깨가 한 번 움찔했어요.",
  "sec": 5.131
 },
 {
  "num": "042",
  "scene": "S08",
  "text": "그런데도 아무 말을 하지 않았습니다.",
  "sec": 3.771
 },
 {
  "num": "043",
  "scene": "S08",
  "text": "곡산댁이 대답하지 않은 까닭이 있었어요.",
  "sec": 4.411
 },
 {
  "num": "044",
  "scene": "S08",
  "text": "그 까닭은 십 년 뒤에야 나옵니다.",
  "sec": 3.971
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "곡산댁은 해가 지고도 일했어요.",
  "sec": 4.411
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "나물을 뜯어다 말리고, 무를 썰어 말리고요.",
  "sec": 5.171
 },
 {
  "num": "047",
  "scene": "S09",
  "text": "고구마 줄기며 호박이며 가지며, 말릴 수 있는 건 다 말렸습니다.",
  "sec": 8.611
 },
 {
  "num": "048",
  "scene": "S09",
  "text": "마당에 널 자리가 없어 지붕까지 올라갔지요.",
  "sec": 4.771
 },
 {
  "num": "049",
  "scene": "S09",
  "text": "봄에는 쑥이며 냉이며, 여름에는 호박잎이며 깻잎이며요.",
  "sec": 7.491
 },
 {
  "num": "050",
  "scene": "S09",
  "text": "가을에는 무며 고구마 줄기며 토란대며.",
  "sec": 6.691
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "동네 사람들이 그 집 지붕을 보고 웃었어요.",
  "sec": 4.651
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "\"저 집은 지붕에 밥상을 차렸네.\" 하고요.",
  "sec": 4.371
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "곡산댁 귀에도 들어갔습니다.",
  "sec": 3.091
 },
 {
  "num": "054",
  "scene": "S10",
  "text": "그래도 이듬해에도 똑같이 했어요.",
  "sec": 3.571
 },
 {
  "num": "055",
  "scene": "S10",
  "text": "십 년을 한 해도 거르지 않았지요.",
  "sec": 3.811
 },
 {
  "num": "056",
  "scene": "S10",
  "text": "비가 많이 온 해에도, 풍년이 든 해에도요.",
  "sec": 5.491
 },
 {
  "num": "057",
  "scene": "S10",
  "text": "풍년에 더 많이 말렸습니다. 값이 쌀 때 쟁여야 한다고요.",
  "sec": 7.411
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "남편도 어머니 편이었어요.",
  "sec": 3.411
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "\"어머니 말씀이 틀린 게 없네. 좀 줄이게.\"",
  "sec": 5.371
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "곡산댁이 그때 딱 한 번 입을 열었습니다.",
  "sec": 4.931
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "\"서방님, 이것만은 못 줄입니다.\"",
  "sec": 4.091
 },
 {
  "num": "062",
  "scene": "S11",
  "text": "남편이 어이가 없어 웃었어요.",
  "sec": 4.011
 },
 {
  "num": "063",
  "scene": "S11",
  "text": "그러고는 더 말하지 않았습니다.",
  "sec": 3.331
 },
 {
  "num": "064",
  "scene": "S11",
  "text": "남편은 어머니와 아내 사이에서 늘 그랬어요.",
  "sec": 5.011
 },
 {
  "num": "065",
  "scene": "S11",
  "text": "말리다 지치면 그냥 입을 다무는 사람이었습니다.",
  "sec": 4.971
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "그 집에 작은며느리가 들어온 건 팔 년째 되던 해였어요.",
  "sec": 5.891
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "작은아들이 장가를 들었거든요.",
  "sec": 3.651
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "작은며느리는 곡산댁과 반대였습니다.",
  "sec": 5.171
 },
 {
  "num": "069",
  "scene": "S12",
  "text": "손이 야무지고 셈이 빨랐어요.",
  "sec": 3.891
 },
 {
  "num": "070",
  "scene": "S12",
  "text": "쌀을 되로 되어 넣고, 장작 개수까지 세었지요.",
  "sec": 6.651
 },
 {
  "num": "071",
  "scene": "S12",
  "text": "쓰는 것을 적어 두고, 달마다 셈을 맞췄어요.",
  "sec": 5.411
 },
 {
  "num": "072",
  "scene": "S12",
  "text": "그 시절 시어머니들이 제일 좋아하는 며느리였습니다.",
  "sec": 5.331
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "시어머니가 아주 좋아했어요.",
  "sec": 3.731
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "\"이제야 이 집에 사람이 하나 들어왔구나.\"",
  "sec": 4.291
 },
 {
  "num": "075",
  "scene": "S13",
  "text": "\"큰애는 십 년을 살아도 저 모양인데.\"",
  "sec": 4.371
 },
 {
  "num": "076",
  "scene": "S13",
  "text": "그 말을 곡산댁이 마당에서 들었습니다.",
  "sec": 4.971
 },
 {
  "num": "077",
  "scene": "S13",
  "text": "듣고도 그냥 지나갔어요.",
  "sec": 3.491
 },
 {
  "num": "078",
  "scene": "S13",
  "text": "서운하지 않았다면 거짓말이겠지요.",
  "sec": 4.011
 },
 {
  "num": "079",
  "scene": "S13",
  "text": "그래도 곡산댁은 그날도 나물을 널었습니다.",
  "sec": 5.291
 },
 {
  "num": "080",
  "scene": "S14",
  "text": "그해 가을, 시어머니가 곳간 열쇠를 내주었어요.",
  "sec": 5.811
 },
 {
  "num": "081",
  "scene": "S14",
  "text": "큰며느리가 아니라 작은며느리에게요.",
  "sec": 4.171
 },
 {
  "num": "082",
  "scene": "S14",
  "text": "집안 살림이 통째로 넘어간 겁니다.",
  "sec": 4.771
 },
 {
  "num": "083",
  "scene": "S14",
  "text": "곡산댁은 열쇠를 넘기고 아무 말도 하지 않았어요.",
  "sec": 5.171
 },
 {
  "num": "084",
  "scene": "S14",
  "text": "그저 고개를 한 번 숙이고 부엌으로 들어갔습니다.",
  "sec": 5.291
 },
 {
  "num": "085",
  "scene": "S14",
  "text": "동네에 소문이 났어요. 큰며느리가 살림을 뺏겼다고요.",
  "sec": 7.011
 },
 {
  "num": "086",
  "scene": "S14",
  "text": "우물가에서 그 말이 며칠을 돌았습니다.",
  "sec": 4.451
 },
 {
  "num": "087",
  "scene": "S15",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 3.891
 },
 {
  "num": "088",
  "scene": "S15",
  "text": "며느리 손이 크다고 흉보는 집, 그 시절엔 흔했지요.",
  "sec": 5.291
 },
 {
  "num": "089",
  "scene": "S15",
  "text": "쌀이 귀하던 시절이니 그럴 만도 했고요.",
  "sec": 4.051
 },
 {
  "num": "090",
  "scene": "S15",
  "text": "그런데 이 집은 조금 달랐습니다.",
  "sec": 3.931
 },
 {
  "num": "091",
  "scene": "S16",
  "text": "곡산댁은 열쇠를 잃고도 하던 걸 멈추지 않았어요.",
  "sec": 5.691
 },
 {
  "num": "092",
  "scene": "S16",
  "text": "다만 곳간에 못 넣으니 뒤란 헛간에 넣었습니다.",
  "sec": 6.491
 },
 {
  "num": "093",
  "scene": "S16",
  "text": "밤에 혼자 독을 안고 날랐지요.",
  "sec": 4.131
 },
 {
  "num": "094",
  "scene": "S16",
  "text": "아무도 안 볼 때요.",
  "sec": 3.331
 },
 {
  "num": "095",
  "scene": "S16",
  "text": "식구들은 그 헛간에 뭐가 들었는지 몰랐습니다.",
  "sec": 4.411
 },
 {
  "num": "096",
  "scene": "S16",
  "text": "관심도 없었고요.",
  "sec": 2.131
 },
 {
  "num": "097",
  "scene": "S16",
  "text": "시어머니는 그 헛간을 두고 \"쓸데없는 걸 쌓아 두는 데\"라고 했어요.",
  "sec": 7.091
 },
 {
  "num": "098",
  "scene": "S16",
  "text": "문을 열어 볼 생각조차 안 했습니다.",
  "sec": 4.091
 },
 {
  "num": "099",
  "scene": "S17",
  "text": "헛간에는 해마다 독이 늘었어요.",
  "sec": 3.971
 },
 {
  "num": "100",
  "scene": "S17",
  "text": "묵은 된장이 스무 독, 간장이 열 독.",
  "sec": 5.171
 },
 {
  "num": "101",
  "scene": "S17",
  "text": "말린 나물이 가마니로 서른 가마.",
  "sec": 4.131
 },
 {
  "num": "102",
  "scene": "S17",
  "text": "도토리 가루에 메밀가루에 말린 고구마순까지요.",
  "sec": 7.171
 },
 {
  "num": "103",
  "scene": "S17",
  "text": "십 년을 그렇게 쌓았습니다.",
  "sec": 3.731
 },
 {
  "num": "104",
  "scene": "S17",
  "text": "곡산댁은 그걸 한 번도 자랑하지 않았어요.",
  "sec": 4.451
 },
 {
  "num": "105",
  "scene": "S17",
  "text": "그저 해마다 조금씩 늘려 놓았을 뿐입니다.",
  "sec": 4.091
 },
 {
  "num": "106",
  "scene": "S18",
  "text": "그러다 그해가 왔습니다.",
  "sec": 2.971
 },
 {
  "num": "107",
  "scene": "S18",
  "text": "모내기 철에 비가 오지 않았어요.",
  "sec": 3.531
 },
 {
  "num": "108",
  "scene": "S18",
  "text": "닷새를 기다리고, 열흘을 기다리고, 한 달을 기다렸지요.",
  "sec": 7.331
 },
 {
  "num": "109",
  "scene": "S18",
  "text": "그래도 하늘이 말랐습니다.",
  "sec": 3.851
 },
 {
  "num": "110",
  "scene": "S18",
  "text": "논바닥이 거북 등처럼 갈라졌어요.",
  "sec": 3.971
 },
 {
  "num": "111",
  "scene": "S18",
  "text": "모를 심은 집은 심은 대로 말랐고, 못 심은 집은 못 심은 대로 굶었어요.",
  "sec": 9.371
 },
 {
  "num": "112",
  "scene": "S18",
  "text": "우물도 바닥이 보이기 시작했습니다.",
  "sec": 4.491
 },
 {
  "num": "113",
  "scene": "S19",
  "text": "사람들이 논둑에 나와 하늘만 봤어요.",
  "sec": 4.611
 },
 {
  "num": "114",
  "scene": "S19",
  "text": "기우제를 세 번 지냈습니다.",
  "sec": 3.211
 },
 {
  "num": "115",
  "scene": "S19",
  "text": "그래도 비는 오지 않았지요.",
  "sec": 2.971
 },
 {
  "num": "116",
  "scene": "S19",
  "text": "여름이 다 가도록 땅이 젖은 날이 없었어요.",
  "sec": 4.091
 },
 {
  "num": "117",
  "scene": "S19",
  "text": "그해 여름은 밤에도 더웠다고 합니다.",
  "sec": 4.411
 },
 {
  "num": "118",
  "scene": "S19",
  "text": "매미가 울다 말고 떨어졌다지요.",
  "sec": 3.891
 },
 {
  "num": "119",
  "scene": "S20",
  "text": "가을에 거둘 것이 없었습니다.",
  "sec": 3.611
 },
 {
  "num": "120",
  "scene": "S20",
  "text": "벼가 아예 패지를 않았거든요.",
  "sec": 4.171
 },
 {
  "num": "121",
  "scene": "S20",
  "text": "그해 이 고을에서 거둔 곡식이 예년의 열에 하나였어요.",
  "sec": 6.891
 },
 {
  "num": "122",
  "scene": "S20",
  "text": "그런 해를 옛날에는 대흉년이라고 했지요.",
  "sec": 5.011
 },
 {
  "num": "123",
  "scene": "S20",
  "text": "삼 년에 한 번은 흉년이 들던 시절이었지만, 이런 해는 드물었어요.",
  "sec": 7.051
 },
 {
  "num": "124",
  "scene": "S20",
  "text": "고을 원님이 조정에 장계를 올렸다고 합니다.",
  "sec": 4.851
 },
 {
  "num": "125",
  "scene": "S21",
  "text": "장에 쌀이 없었어요.",
  "sec": 2.691
 },
 {
  "num": "126",
  "scene": "S21",
  "text": "있어도 값이 열 배였습니다.",
  "sec": 3.411
 },
 {
  "num": "127",
  "scene": "S21",
  "text": "소를 팔아도 쌀 두 가마를 못 샀어요.",
  "sec": 3.931
 },
 {
  "num": "128",
  "scene": "S21",
  "text": "땅문서를 들고 나온 사람도 있었고요.",
  "sec": 3.851
 },
 {
  "num": "129",
  "scene": "S21",
  "text": "그렇게 겨울이 왔습니다.",
  "sec": 3.091
 },
 {
  "num": "130",
  "scene": "S21",
  "text": "겨울은 흉년에 제일 무서운 철이에요.",
  "sec": 5.171
 },
 {
  "num": "131",
  "scene": "S21",
  "text": "들에 나가도 뜯을 풀 한 포기가 없으니까요.",
  "sec": 5.491
 },
 {
  "num": "132",
  "scene": "S22",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 6.291
 },
 {
  "num": "133",
  "scene": "S23",
  "text": "작은며느리가 아끼던 곳간이 두 달 만에 비었어요.",
  "sec": 5.171
 },
 {
  "num": "134",
  "scene": "S23",
  "text": "아낀다는 건 적게 쓰는 것이지 많이 쌓는 게 아니었거든요.",
  "sec": 6.051
 },
 {
  "num": "135",
  "scene": "S23",
  "text": "쓸 것이 없는데 아낄 것도 없었습니다.",
  "sec": 4.811
 },
 {
  "num": "136",
  "scene": "S23",
  "text": "작은며느리가 곳간 문을 열어 놓고 한참을 서 있었어요.",
  "sec": 6.651
 },
 {
  "num": "137",
  "scene": "S23",
  "text": "그러고는 시어머니한테 가서 울었습니다.",
  "sec": 4.091
 },
 {
  "num": "138",
  "scene": "S23",
  "text": "\"어머니, 제가 셈을 잘못한 게 아닙니다.\"",
  "sec": 4.611
 },
 {
  "num": "139",
  "scene": "S23",
  "text": "\"애초에 들어온 것이 없었습니다.\"",
  "sec": 3.611
 },
 {
  "num": "140",
  "scene": "S23",
  "text": "시어머니도 그건 알았어요. 그래서 더 답답했지요.",
  "sec": 5.731
 },
 {
  "num": "141",
  "scene": "S24",
  "text": "마을 아이들부터 부황이 들었어요.",
  "sec": 4.811
 },
 {
  "num": "142",
  "scene": "S24",
  "text": "얼굴이 누렇게 붓는 병이지요.",
  "sec": 4.571
 },
 {
  "num": "143",
  "scene": "S24",
  "text": "굶으면 그렇게 됩니다.",
  "sec": 2.531
 },
 {
  "num": "144",
  "scene": "S24",
  "text": "그해 겨울, 이 고을에서 하루에 한 집꼴로 상여가 나갔어요.",
  "sec": 6.971
 },
 {
  "num": "145",
  "scene": "S24",
  "text": "노인이 먼저 가고, 그다음이 아이였습니다.",
  "sec": 4.611
 },
 {
  "num": "146",
  "scene": "S24",
  "text": "어른들은 제 몫을 아이에게 덜어 주고 버텼고요.",
  "sec": 5.131
 },
 {
  "num": "147",
  "scene": "S25",
  "text": "시어머니가 마루 끝에 앉아 있었어요.",
  "sec": 3.731
 },
 {
  "num": "148",
  "scene": "S25",
  "text": "예순이 넘도록 살림을 해 온 사람입니다.",
  "sec": 4.531
 },
 {
  "num": "149",
  "scene": "S25",
  "text": "그런데 아무 수가 없었어요.",
  "sec": 3.811
 },
 {
  "num": "150",
  "scene": "S25",
  "text": "쌀이 없으면 살림 솜씨가 무슨 소용이겠습니까.",
  "sec": 5.171
 },
 {
  "num": "151",
  "scene": "S25",
  "text": "시어머니가 그날 처음으로 큰며느리를 떠올렸다고 해요.",
  "sec": 5.611
 },
 {
  "num": "152",
  "scene": "S25",
  "text": "떠올리고도 부르지는 못했습니다. 무슨 낯으로요.",
  "sec": 5.811
 },
 {
  "num": "153",
  "scene": "S26",
  "text": "그때 곡산댁이 뒤란으로 갔습니다.",
  "sec": 4.211
 },
 {
  "num": "154",
  "scene": "S26",
  "text": "십 년 동안 혼자 드나들던 헛간이었어요.",
  "sec": 4.611
 },
 {
  "num": "155",
  "scene": "S26",
  "text": "그 문을 활짝 열었지요.",
  "sec": 3.011
 },
 {
  "num": "156",
  "scene": "S26",
  "text": "그러고는 시어머니를 불렀습니다.",
  "sec": 3.691
 },
 {
  "num": "157",
  "scene": "S26",
  "text": "\"어머니, 이리 좀 와 보십시오.\"",
  "sec": 3.011
 },
 {
  "num": "158",
  "scene": "S26",
  "text": "십 년 만에 며느리가 시어머니를 부른 겁니다.",
  "sec": 5.371
 },
 {
  "num": "159",
  "scene": "S26",
  "text": "그것도 뒤란으로요.",
  "sec": 3.011
 },
 {
  "num": "160",
  "scene": "S27",
  "text": "시어머니가 뒤란으로 왔어요.",
  "sec": 2.891
 },
 {
  "num": "161",
  "scene": "S27",
  "text": "그리고 헛간 안을 봤습니다.",
  "sec": 3.611
 },
 {
  "num": "162",
  "scene": "S27",
  "text": "묵은 장독이 서른 개.",
  "sec": 3.531
 },
 {
  "num": "163",
  "scene": "S27",
  "text": "말린 나물이 가마니로 서른 가마.",
  "sec": 4.051
 },
 {
  "num": "164",
  "scene": "S27",
  "text": "도토리 가루가 열 자루.",
  "sec": 3.811
 },
 {
  "num": "165",
  "scene": "S27",
  "text": "그 집 식구가 겨울을 나고도 남을 양이었어요.",
  "sec": 4.651
 },
 {
  "num": "166",
  "scene": "S27",
  "text": "남는 정도가 아니었습니다.",
  "sec": 2.811
 },
 {
  "num": "167",
  "scene": "S27",
  "text": "두 배, 세 배가 남을 양이었어요.",
  "sec": 3.771
 },
 {
  "num": "168",
  "scene": "S28",
  "text": "시어머니가 그 자리에 주저앉았어요.",
  "sec": 4.091
 },
 {
  "num": "169",
  "scene": "S28",
  "text": "\"이게… 이게 다 뭐냐.\"",
  "sec": 3.571
 },
 {
  "num": "170",
  "scene": "S28",
  "text": "곡산댁이 대답했습니다.",
  "sec": 3.211
 },
 {
  "num": "171",
  "scene": "S28",
  "text": "\"십 년 동안 모은 것입니다.\"",
  "sec": 3.291
 },
 {
  "num": "172",
  "scene": "S28",
  "text": "\"해마다 한 해 먹을 것을 덜어 두었습니다.\"",
  "sec": 3.531
 },
 {
  "num": "173",
  "scene": "S28",
  "text": "\"쓰지 않은 해는 그대로 묵혔고요.\"",
  "sec": 3.971
 },
 {
  "num": "174",
  "scene": "S29",
  "text": "허허, 그 말에 시어머니가 어찌 되었겠습니까.",
  "sec": 5.211
 },
 {
  "num": "175",
  "scene": "S30",
  "text": "곡산댁이 시어머니에게 물었어요.",
  "sec": 3.771
 },
 {
  "num": "176",
  "scene": "S30",
  "text": "\"이 마을에 몇 집이나 됩니까.\"",
  "sec": 3.691
 },
 {
  "num": "177",
  "scene": "S30",
  "text": "시어머니가 뭐라 말도 못 하고 \"마흔… 마흔 집쯤 된다\" 했습니다.",
  "sec": 7.531
 },
 {
  "num": "178",
  "scene": "S30",
  "text": "곡산댁이 고개를 끄덕였어요.",
  "sec": 3.171
 },
 {
  "num": "179",
  "scene": "S30",
  "text": "\"그럼 죽을 쑤어 냅시다. 하루 한 번씩요.\"",
  "sec": 5.331
 },
 {
  "num": "180",
  "scene": "S30",
  "text": "시어머니가 며느리 손을 잡았어요.",
  "sec": 4.171
 },
 {
  "num": "181",
  "scene": "S30",
  "text": "\"이건 네 것이다. 네가 정하거라.\"",
  "sec": 5.331
 },
 {
  "num": "182",
  "scene": "S30",
  "text": "곡산댁이 고개를 저었습니다. \"이 집 것입니다.\"",
  "sec": 5.851
 },
 {
  "num": "183",
  "scene": "S31",
  "text": "그날부터 그 집 마당에 가마솥이 걸렸습니다.",
  "sec": 5.251
 },
 {
  "num": "184",
  "scene": "S31",
  "text": "묵은 장을 풀고 말린 나물을 넣고 도토리 가루를 개어 죽을 쑤었어요.",
  "sec": 8.411
 },
 {
  "num": "185",
  "scene": "S31",
  "text": "하루 한 번, 해 질 녘에요.",
  "sec": 4.731
 },
 {
  "num": "186",
  "scene": "S31",
  "text": "마을 사람들이 그릇을 들고 줄을 섰습니다.",
  "sec": 4.291
 },
 {
  "num": "187",
  "scene": "S31",
  "text": "시어머니가 며느리 옆에서 그릇을 받아 날랐어요.",
  "sec": 6.011
 },
 {
  "num": "188",
  "scene": "S31",
  "text": "예순 넘은 노인이 며느리를 거들었지요.",
  "sec": 4.451
 },
 {
  "num": "189",
  "scene": "S31",
  "text": "작은며느리는 불을 땠어요.",
  "sec": 4.491
 },
 {
  "num": "190",
  "scene": "S31",
  "text": "세 여자가 겨우내 그 마당을 지켰습니다.",
  "sec": 4.811
 },
 {
  "num": "191",
  "scene": "S32",
  "text": "그 죽으로 겨울을 났어요.",
  "sec": 3.571
 },
 {
  "num": "192",
  "scene": "S32",
  "text": "마흔 집 중에 한 집도 굶어 죽지 않았습니다.",
  "sec": 4.491
 },
 {
  "num": "193",
  "scene": "S32",
  "text": "봄까지 딱 대었지요.",
  "sec": 3.131
 },
 {
  "num": "194",
  "scene": "S32",
  "text": "곡산댁이 십 년을 쌓은 것이 꼭 한 해를 버티는 양이었어요.",
  "sec": 6.371
 },
 {
  "num": "195",
  "scene": "S32",
  "text": "한 해를 버티면 다음 가을이 옵니다.",
  "sec": 4.971
 },
 {
  "num": "196",
  "scene": "S32",
  "text": "흉년은 그 한 해를 못 넘겨서 사람이 죽는 것이지요.",
  "sec": 5.531
 },
 {
  "num": "197",
  "scene": "S33",
  "text": "겨울이 끝나갈 무렵이었어요.",
  "sec": 2.931
 },
 {
  "num": "198",
  "scene": "S33",
  "text": "시어머니가 며느리를 방으로 불렀습니다.",
  "sec": 4.531
 },
 {
  "num": "199",
  "scene": "S33",
  "text": "그리고 며느리 앞에 고개를 숙였어요.",
  "sec": 4.691
 },
 {
  "num": "200",
  "scene": "S33",
  "text": "\"내가 십 년을 뭘 보고 살았누.\"",
  "sec": 4.331
 },
 {
  "num": "201",
  "scene": "S33",
  "text": "곡산댁이 놀라 손을 내저었습니다.",
  "sec": 4.331
 },
 {
  "num": "202",
  "scene": "S33",
  "text": "\"어머니, 이러지 마십시오.\"",
  "sec": 3.091
 },
 {
  "num": "203",
  "scene": "S33",
  "text": "시어머니가 고개를 들지 않았어요.",
  "sec": 4.931
 },
 {
  "num": "204",
  "scene": "S33",
  "text": "\"아니다. 이건 내가 해야 할 일이다.\"",
  "sec": 4.811
 },
 {
  "num": "205",
  "scene": "S34",
  "text": "그러고는 곡산댁이 처음으로 친정 이야기를 했어요.",
  "sec": 5.091
 },
 {
  "num": "206",
  "scene": "S34",
  "text": "\"제 어미가 굶어 죽었습니다.\"",
  "sec": 3.571
 },
 {
  "num": "207",
  "scene": "S34",
  "text": "\"곳간에 쌀이 없어서가 아니었어요.\"",
  "sec": 3.611
 },
 {
  "num": "208",
  "scene": "S34",
  "text": "\"봄이 오면 있는 대로 다 먹어 버린 겁니다.\"",
  "sec": 5.611
 },
 {
  "num": "209",
  "scene": "S34",
  "text": "\"가을이 오면 또 생긴다고요.\"",
  "sec": 3.171
 },
 {
  "num": "210",
  "scene": "S34",
  "text": "\"그해 가을에 비가 왔습니다. 어미는 여름에 죽었고요.\"",
  "sec": 7.491
 },
 {
  "num": "211",
  "scene": "S34",
  "text": "시어머니가 아무 말도 못 했습니다.",
  "sec": 4.411
 },
 {
  "num": "212",
  "scene": "S34",
  "text": "\"그래서 저는 늘 이듬해에 먹을 것을 먼저 덜어 둡니다.\"",
  "sec": 5.651
 },
 {
  "num": "213",
  "scene": "S34",
  "text": "\"흉이라 하시는 걸 압니다. 그래도 못 고칩니다.\"",
  "sec": 6.051
 },
 {
  "num": "214",
  "scene": "S35",
  "text": "시어머니가 곳간 열쇠를 다시 내밀었어요.",
  "sec": 5.971
 },
 {
  "num": "215",
  "scene": "S35",
  "text": "곡산댁이 그걸 도로 밀었습니다.",
  "sec": 3.651
 },
 {
  "num": "216",
  "scene": "S35",
  "text": "\"열쇠는 누가 가져도 됩니다.\"",
  "sec": 3.251
 },
 {
  "num": "217",
  "scene": "S35",
  "text": "\"저는 그냥 제 버릇대로 하겠습니다.\"",
  "sec": 4.011
 },
 {
  "num": "218",
  "scene": "S35",
  "text": "\"그 버릇이 흉인 줄은 저도 압니다.\"",
  "sec": 4.251
 },
 {
  "num": "219",
  "scene": "S35",
  "text": "시어머니가 고개를 저었어요. \"흉이 아니다. 이제 알았다.\"",
  "sec": 8.531
 },
 {
  "num": "220",
  "scene": "S35",
  "text": "그러고는 이렇게 덧붙였습니다.",
  "sec": 3.571
 },
 {
  "num": "221",
  "scene": "S35",
  "text": "\"내가 십 년을 네 밥솥만 봤구나. 네 속은 한 번을 안 봤고.\"",
  "sec": 7.971
 },
 {
  "num": "222",
  "scene": "S36",
  "text": "봄이 오고 비가 왔어요.",
  "sec": 3.411
 },
 {
  "num": "223",
  "scene": "S36",
  "text": "그해 가을에 마을 사람들이 곡식을 갚으러 왔습니다.",
  "sec": 5.491
 },
 {
  "num": "224",
  "scene": "S36",
  "text": "곡산댁이 받지 않았어요.",
  "sec": 3.291
 },
 {
  "num": "225",
  "scene": "S36",
  "text": "대신 이렇게 말했지요.",
  "sec": 3.251
 },
 {
  "num": "226",
  "scene": "S36",
  "text": "\"그 곡식으로 댁에도 한 독씩 묻어 두십시오.\"",
  "sec": 4.531
 },
 {
  "num": "227",
  "scene": "S36",
  "text": "\"다음 흉년은 제가 못 막습니다.\"",
  "sec": 4.251
 },
 {
  "num": "228",
  "scene": "S36",
  "text": "사람들이 그 말을 새겨들었어요.",
  "sec": 3.411
 },
 {
  "num": "229",
  "scene": "S36",
  "text": "한 번 굶어 본 사람은 그 말을 잊지 않거든요.",
  "sec": 5.131
 },
 {
  "num": "230",
  "scene": "S37",
  "text": "그때부터 그 마을에는 집집마다 독이 하나씩 묻혔습니다.",
  "sec": 6.531
 },
 {
  "num": "231",
  "scene": "S37",
  "text": "사람들이 그걸 곡산댁 독이라고 불렀어요.",
  "sec": 4.491
 },
 {
  "num": "232",
  "scene": "S37",
  "text": "흉년이 오든 안 오든, 한 독은 손을 대지 않았지요.",
  "sec": 6.131
 },
 {
  "num": "233",
  "scene": "S37",
  "text": "그 풍습이 삼대를 갔다고 합니다.",
  "sec": 4.211
 },
 {
  "num": "234",
  "scene": "S37",
  "text": "묻은 독을 여는 해가 삼십 년에 한 번쯤 있었다지요.",
  "sec": 5.931
 },
 {
  "num": "235",
  "scene": "S37",
  "text": "그 한 번을 위해 삼십 년을 묻어 둔 겁니다.",
  "sec": 5.051
 },
 {
  "num": "236",
  "scene": "S38",
  "text": "허허, 어떻습니까.",
  "sec": 2.891
 },
 {
  "num": "237",
  "scene": "S38",
  "text": "십 년을 흉이라 하던 것이 한 마을을 살렸지요.",
  "sec": 5.171
 },
 {
  "num": "238",
  "scene": "S38",
  "text": "사람 손이 크다는 건 욕심이 많다는 게 아니라, 무서운 걸 아는 것일 수도 있습니다.",
  "sec": 8.171
 },
 {
  "num": "239",
  "scene": "S38",
  "text": "곡산댁은 배고픔을 본 사람이었어요.",
  "sec": 5.211
 },
 {
  "num": "240",
  "scene": "S38",
  "text": "본 사람은 잊지를 못합니다.",
  "sec": 3.651
 },
 {
  "num": "241",
  "scene": "S39",
  "text": "그런데 말이오. 그 집 작은며느리는 그 뒤로 어찌 되었겠습니까.",
  "sec": 6.371
 },
 {
  "num": "242",
  "scene": "S39",
  "text": "형님한테 장 담그는 법을 배웠다지 않습니까. 허허, 그 이야기는 다음에 또 해 드리리다.",
  "sec": 9.251
 },
 {
  "num": "243",
  "scene": "S40",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 5.211
 },
 {
  "num": "244",
  "scene": "S40",
  "text": "다음 이야기가 궁금하시거든, 엽전 대신 구독 한 번 눌러 주시게.",
  "sec": 6.811
 },
 {
  "num": "245",
  "scene": "S40",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 5.451
 }
]