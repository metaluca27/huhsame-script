 },
 {
  "num": "076",
  "scene": "S14",
  "text": "행랑채 쪽에서 났어요.",
  "sec": 2.331
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "밤중이라 집안이 다 뒤집혔습니다.",
  "sec": 3.891
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "사람들이 아이부터 안고 뛰었지요.",
  "sec": 4.371
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "그 아수라장에서 아이 둘이 한 방에 모였습니다.",
