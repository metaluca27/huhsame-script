 },
 {
  "num": "090",
  "scene": "S17",
  "text": "혀를 들어 봤어요.",
  "sec": 2.171
 },
 {
  "num": "091",
  "scene": "S17",
  "text": "혀 밑이 길었습니다.",
  "sec": 2.731
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "다른 아이였어요.",
  "sec": 2.331
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "그러면 안방 아이는 어디 갔겠습니까.",
  "sec": 4.171
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "행랑채로 간 겁니다.",
  "sec": 2.451
 },
 {
  "num": "095",
  "scene": "S18",
  "text": "섭이네가 그길로 행랑채에 갔습니다.",
