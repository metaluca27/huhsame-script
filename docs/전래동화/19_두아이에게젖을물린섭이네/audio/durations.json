 },
 {
  "num": "081",
  "scene": "S14",
  "text": "넉 달배기는 얼굴이 다 비슷합니다.",
  "sec": 4.491
 },
 {
  "num": "082",
  "scene": "S15",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 4.491
 },
 {
  "num": "083",
  "scene": "S16",
  "text": "이튿날 아침이었어요.",
  "sec": 2.171
 },
 {
  "num": "084",
  "scene": "S16",
  "text": "섭이네가 안방 아이한테 젖을 물렸습니다.",
  "sec": 5.411
 },
 {
  "num": "085",
  "scene": "S16",
  "text": "그런데 그 아이가 왼쪽을 물었어요.",
  "sec": 5.131
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "섭이네 손이 멈췄습니다.",
  "sec": 3.291
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "어제까지 못 물던 쪽이었거든요.",
  "sec": 3.411
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "하룻밤 사이에 되는 일이 아닙니다.",
  "sec": 3.851
 },
 {
  "num": "089",
  "scene": "S17",
  "text": "섭이네가 아이 입을 열어 봤습니다.",
