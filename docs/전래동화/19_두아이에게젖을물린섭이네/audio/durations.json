[
 {
  "num": "001",
  "scene": "S01",
  "text": "열다섯 해를 입 다물던 젖어미가, 젖 빠는 버릇 하나로 두 아이의 자리를 바로잡았습니다.",
  "sec": 9.011
 },
 {
  "num": "002",
  "scene": "S02",
  "text": "그 집 아이 둘에게 젖을 물린 사람은 그 여인 하나뿐이었지요.",
  "sec": 7.451
 },
 {
  "num": "003",
  "scene": "S02",
  "text": "\"도련님은 왼쪽 젖을 못 뭅니다.\"",
  "sec": 4.291
 },
 {
  "num": "004",
  "scene": "S03",
  "text": "허허, 허허서방이올시다. 그 젖어미 이야기, 부채 한 번 치고 들려드리리다. 탁!",
  "sec": 8.891
 },
 {
  "num": "005",
  "scene": "S04",
  "text": "그 여인 이름은 섭이네, 경상도 어느 고을 대감댁에서 젖어미로 살던 사람이었습니다.",
  "sec": 8.931
 },
 {
  "num": "006",
  "scene": "S04",
  "text": "젖어미라는 게 무엇인가 하면요.",
  "sec": 3.291
 },
 {
  "num": "007",
  "scene": "S04",
  "text": "남의 집 아이한테 제 젖을 먹이는 일입니다.",
  "sec": 5.291
 },
 {
  "num": "008",
  "scene": "S04",
  "text": "양반집에서는 마님이 직접 젖을 안 먹였거든요.",
  "sec": 5.411
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "몸이 상한다고도 했고, 품위가 아니라고도 했지요.",
  "sec": 5.011
 },
 {
  "num": "010",
  "scene": "S04",
  "text": "그래서 젖이 도는 여인을 집에 들였습니다.",
  "sec": 4.891
 },
 {
  "num": "011",
  "scene": "S04",
  "text": "섭이네가 스물셋에 그 집에 들어갔어요.",
  "sec": 4.891
 },
 {
  "num": "012",
  "scene": "S04",
  "text": "품삯은 쌀 두 말에 무명 한 필이었습니다.",
  "sec": 6.371
 },
 {
  "num": "013",
  "scene": "S04",
  "text": "그게 한 해 치였어요.",
  "sec": 2.851
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "그런데 젖어미가 되려면 조건이 하나 있었습니다.",
  "sec": 5.331
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "제 아이를 막 낳았어야 해요.",
  "sec": 3.611
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "그래야 젖이 도니까요.",
  "sec": 2.811
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "섭이네도 그랬습니다.",
  "sec": 2.651
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "제 아들을 낳은 지 보름 만에 그 집에 들어갔어요.",
  "sec": 5.171
 },
 {
  "num": "019",
  "scene": "S05",
  "text": "그러면 제 아이는 어찌 되겠습니까.",
  "sec": 4.411
 },
 {
  "num": "020",
  "scene": "S05",
  "text": "친정어미한테 맡기고 미음으로 키웠습니다.",
  "sec": 4.771
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "그 시절 젖어미는 다 그랬어요.",
  "sec": 3.931
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "남의 아이를 먹이느라 제 아이를 굶기는 겁니다.",
  "sec": 4.731
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "섭이네 아들은 돌을 못 넘겼습니다.",
  "sec": 5.491
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "섭이네는 그 이야기를 평생 한 번도 입에 올리지 않았어요.",
  "sec": 5.891
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "대신 대감댁 아이를 제 아이처럼 안았지요.",
  "sec": 5.291
 },
 {
  "num": "026",
  "scene": "S06",
  "text": "그것 말고 할 수 있는 게 없었으니까요.",
  "sec": 4.491
 },
 {
  "num": "027",
  "scene": "S06",
  "text": "그 시절 젖어미는 사람 수에 들지도 않았습니다.",
  "sec": 4.731
 },
 {
  "num": "028",
  "scene": "S06",
  "text": "밥상도 부엌에서 혼자 받았고요.",
  "sec": 3.971
 },
 {
  "num": "029",
  "scene": "S06",
  "text": "아이가 커서 말을 배우면 제일 먼저 가르치는 게 있었어요.",
  "sec": 6.131
 },
 {
  "num": "030",
  "scene": "S06",
  "text": "젖어미한테 말을 놓는 법이었습니다.",
  "sec": 4.251
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "그런데 젖을 물리면 아는 게 생깁니다.",
  "sec": 4.691
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "아이마다 빠는 힘이 다르거든요.",
  "sec": 3.411
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "급한 아이는 몇 모금에 다 먹고 잠이 듭니다.",
  "sec": 6.211
 },
 {
  "num": "034",
  "scene": "S07",
  "text": "느린 아이는 한참을 물고 쉬었다 또 뭅니다.",
  "sec": 5.371
 },
 {
  "num": "035",
  "scene": "S07",
  "text": "자다가도 젖만 대면 무는 아이가 있고요.",
  "sec": 3.891
 },
 {
  "num": "036",
  "scene": "S07",
  "text": "깨워야 겨우 무는 아이도 있어요.",
  "sec": 3.571
 },
 {
  "num": "037",
  "scene": "S07",
  "text": "그게 평생 안 바뀝니다.",
  "sec": 3.371
 },
 {
  "num": "038",
  "scene": "S07",
  "text": "스무 해를 물려 보면 그게 눈이 아니라 손에 익어요.",
  "sec": 5.611
 },
 {
  "num": "039",
  "scene": "S07",
  "text": "안아 들기만 해도 어느 아이인지 압니다.",
  "sec": 4.811
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "그리고 좌우가 있습니다.",
  "sec": 2.891
 },
 {
  "num": "041",
  "scene": "S08",
  "text": "아이마다 잘 무는 쪽이 따로 있어요.",
  "sec": 3.931
 },
 {
  "num": "042",
  "scene": "S08",
  "text": "목을 돌리는 버릇이 한쪽으로 굳거든요.",
  "sec": 4.131
 },
 {
  "num": "043",
  "scene": "S08",
  "text": "한쪽만 자꾸 물면 그쪽 젖만 줄어듭니다.",
  "sec": 5.251
 },
 {
  "num": "044",
  "scene": "S08",
  "text": "젖어미는 그래서 양쪽을 번갈아 물립니다.",
  "sec": 5.411
 },
 {
  "num": "045",
  "scene": "S08",
  "text": "그런데 아무리 번갈아 물려도 끝내 한쪽을 못 무는 아이가 있어요.",
  "sec": 5.731
 },
 {
  "num": "046",
  "scene": "S08",
  "text": "그건 버릇이 아니라 몸이 그런 겁니다.",
  "sec": 4.411
 },
 {
  "num": "047",
  "scene": "S09",
  "text": "허허, 여기가 중요하오.",
  "sec": 3.731
 },
 {
  "num": "048",
  "scene": "S09",
  "text": "그 몸이 그런 게 무엇이었겠습니까.",
  "sec": 4.051
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "대감댁 도련님은 혀 밑이 짧았습니다.",
  "sec": 4.331
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "혀를 아래에 붙들어 매는 힘줄이 있는데요.",
  "sec": 4.571
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "그게 남보다 짧게 붙은 아이가 있어요.",
  "sec": 4.291
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "그러면 혀가 잘 안 올라갑니다.",
  "sec": 3.851
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "젖을 물 때 혀로 받쳐야 하는데 그게 안 되는 겁니다.",
  "sec": 5.651
 },
 {
  "num": "054",
  "scene": "S10",
  "text": "그래서 한쪽은 아예 못 물었어요.",
  "sec": 3.811
 },
 {
  "num": "055",
  "scene": "S10",
  "text": "섭이네가 반년을 애를 먹었습니다.",
  "sec": 4.531
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "그걸 아는 사람은 섭이네뿐이었습니다.",
  "sec": 4.331
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "마님은 젖을 물린 적이 없으니 모르지요.",
  "sec": 4.651
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "유모 말고 누가 알겠습니까.",
  "sec": 3.131
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "그 시절에는 의원도 그런 걸 보지 않았어요.",
  "sec": 5.531
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "아이가 젖을 덜 먹으면 젖어미 탓을 했지요.",
  "sec": 4.651
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "섭이네가 그 소리를 제일 많이 들었습니다.",
  "sec": 4.971
 },
 {
  "num": "062",
  "scene": "S12",
  "text": "그해 가을이었어요.",
  "sec": 2.771
 },
 {
  "num": "063",
  "scene": "S12",
  "text": "그 집에서 아이가 둘 태어났습니다.",
  "sec": 4.051
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "하나는 안방에서, 마님이 낳았고요.",
  "sec": 4.451
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "하나는 행랑채에서, 종살이하던 여인이 낳았습니다.",
  "sec": 5.771
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "같은 날 밤이었어요.",
  "sec": 2.251
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "그런 일이 드물지는 않았습니다.",
  "sec": 4.171
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "큰 집에는 사람이 많았으니까요.",
  "sec": 4.211
 },
 {
  "num": "069",
  "scene": "S13",
  "text": "섭이네가 두 아이를 다 맡았습니다.",
  "sec": 4.411
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "행랑채 여인이 사흘 만에 죽었거든요.",
  "sec": 4.411
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "그러니 젖을 물릴 사람이 섭이네뿐이었어요.",
  "sec": 4.771
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "한쪽은 안방으로, 한쪽은 행랑채로 오가며 먹였습니다.",
  "sec": 6.331
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "밤이면 둘을 다 데리고 잤어요.",
  "sec": 3.651
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "그게 넉 달이었습니다.",
  "sec": 3.611
 },
 {
  "num": "075",
  "scene": "S14",
  "text": "그러다 그해 겨울에 불이 났습니다.",
