  "num": "118",
  "scene": "S21",
  "text": "안방 아이는 글을 배웠고요.",
  "sec": 3.571
 },
 {
  "num": "119",
  "scene": "S21",
  "text": "행랑채 아이는 물을 길었습니다.",
  "sec": 3.971
 },
 {
  "num": "120",
  "scene": "S21",
  "text": "같은 마당에서 자랐는데 말이지요.",
  "sec": 3.491
 },
 {
  "num": "121",
  "scene": "S21",
  "text": "하나는 마루 위에, 하나는 마루 아래에 있었습니다.",
  "sec": 5.491
 },
 {
  "num": "122",
  "scene": "S22",
  "text": "안방 아이는 이름이 치수였어요.",
  "sec": 3.771
 },
 {
  "num": "123",
  "scene": "S22",
  "text": "글을 일찍 뗐습니다.",
  "sec": 4.331
 },
 {
  "num": "124",
  "scene": "S22",
  "text": "열다섯에 벌써 책을 읽었지요.",
  "sec": 3.651
 },
 {
  "num": "125",
  "scene": "S22",
  "text": "몸이 약해서 바깥출입은 잘 안 했어요.",
  "sec": 4.851
 },
 {
  "num": "126",
  "scene": "S22",
  "text": "밥을 먹을 때도 혀가 자꾸 걸렸습니다.",
  "sec": 4.611
 },
 {
  "num": "127",
  "scene": "S22",
  "text": "말이 조금 어눌했어요.",
  "sec": 2.971
 },
 {
  "num": "128",
  "scene": "S22",
  "text": "집에서는 타고난 것이라고들 했습니다.",
  "sec": 3.571
 },
 {
  "num": "129",
  "scene": "S23",
  "text": "행랑채 아이는 덕이라 했습니다.",
  "sec": 3.691
 },
 {
  "num": "130",
  "scene": "S23",
  "text": "열다섯에 벌써 물지게를 졌어요.",
  "sec": 4.291
 },
 {
  "num": "131",
  "scene": "S23",
  "text": "몸이 단단하고 말이 또렷했습니다.",
  "sec": 4.291
 },
 {
  "num": "132",
  "scene": "S23",
  "text": "글은 한 자도 몰랐지요.",
  "sec": 3.171
 },
 {
  "num": "133",
  "scene": "S23",
  "text": "배울 일이 없었으니까요.",
  "sec": 2.971
 },
 {
  "num": "134",
  "scene": "S23",
  "text": "섭이네는 그 아이를 볼 때마다 가슴이 내려앉았습니다.",
  "sec": 7.011
 },
 {
  "num": "135",
  "scene": "S23",
  "text": "덕이가 지게를 지고 지나갈 때요.",
  "sec": 3.251
 },
 {
  "num": "136",
  "scene": "S23",
  "text": "그 어깨가 마님을 닮았거든요.",
  "sec": 3.971
 },
 {
  "num": "137",
  "scene": "S23",
  "text": "아무도 그걸 못 봤습니다.",
  "sec": 3.211
 },
 {
  "num": "138",
  "scene": "S24",
  "text": "섭이네가 몇 번이나 말하려고 했어요.",
  "sec": 4.811
 },
 {
  "num": "139",
  "scene": "S24",
  "text": "마님 앞에서 입을 떼려다 돌아섰습니다.",
  "sec": 4.291
 },
 {
  "num": "140",
  "scene": "S24",
  "text": "말해 봐야 제가 죽고요.",
  "sec": 3.931
 },
 {
  "num": "141",
  "scene": "S24",
  "text": "덕이도 거짓말쟁이가 됩니다.",
  "sec": 3.291
 },
 {
  "num": "142",
  "scene": "S24",
  "text": "치수는 제 자리를 잃고요.",
  "sec": 2.971
 },
 {
  "num": "143",
  "scene": "S24",
  "text": "아무도 안 좋아지는 일이었어요.",
  "sec": 3.331
 },
 {
  "num": "144",
  "scene": "S24",
  "text": "그래서 또 삼켰습니다.",
  "sec": 3.371
 },
 {
  "num": "145",
  "scene": "S25",
  "text": "그해 봄이었습니다.",
  "sec": 2.771
 },
 {
  "num": "146",
  "scene": "S25",
  "text": "마님 패물이 없어졌어요.",
  "sec": 3.091
 },
 {
  "num": "147",
  "scene": "S25",
  "text": "금비녀와 가락지였습니다.",
  "sec": 3.131
 },
 {
  "num": "148",
  "scene": "S25",
  "text": "혼수로 가져온 것이라 값이 컸지요.",
  "sec": 3.851
 },
 {
  "num": "149",
  "scene": "S25",
  "text": "집안이 발칵 뒤집혔습니다.",
  "sec": 3.291
 },
 {
  "num": "150",
  "scene": "S25",
  "text": "사람들을 하나씩 불러 물었어요.",
  "sec": 4.371
 },
 {
  "num": "151",
  "scene": "S26",
  "text": "그러다 덕이 잠자리에서 가락지가 나왔습니다.",
  "sec": 4.931
 },
 {
  "num": "152",
  "scene": "S26",
  "text": "덕이가 아니라고 했어요.",
  "sec": 2.931
 },
 {
  "num": "153",
  "scene": "S26",
  "text": "그런데 아무도 안 들었습니다.",
  "sec": 3.691
 },
 {
  "num": "154",
  "scene": "S26",
  "text": "종살이하는 아이 말을 누가 듣겠습니까.",
  "sec": 4.011
 },
 {
  "num": "155",
  "scene": "S26",
  "text": "그날로 광에 갇혔어요.",
  "sec": 3.771
 },
 {
  "num": "156",
  "scene": "S26",
  "text": "이튿날 관아로 넘기기로 했습니다.",
  "sec": 3.771
 },
 {
  "num": "157",
  "scene": "S26",
  "text": "그 시절 종이 주인 물건에 손을 대면요.",
  "sec": 3.651
 },
 {
  "num": "158",
  "scene": "S26",
  "text": "곤장 백 대였습니다.",
  "sec": 3.211
 },
 {
  "num": "159",
  "scene": "S26",
  "text": "열다섯 살이 백 대를 맞으면 살아나기 어렵지요.",
  "sec": 5.451
 },
 {
  "num": "160",
  "scene": "S27",
  "text": "집안 사람들이 수군거렸어요.",
  "sec": 3.851
 },
 {
  "num": "161",
  "scene": "S27",
  "text": "\"행랑채 것들이 다 그렇지.\"",
  "sec": 3.411
 },
 {
  "num": "162",
  "scene": "S27",
  "text": "\"피는 못 속인다더니.\"",
  "sec": 2.371
 },
 {
  "num": "163",
  "scene": "S27",
  "text": "섭이네가 그 말을 들었습니다.",
  "sec": 3.531
 },
 {
  "num": "164",
  "scene": "S27",
  "text": "피는 못 속인다는 그 말을요.",
  "sec": 3.611
 },
 {
  "num": "165",
  "scene": "S27",
  "text": "그 자리에 한참을 서 있었어요.",
  "sec": 3.131
 },
 {
  "num": "166",
  "scene": "S28",
  "text": "그날 밤 섭이네가 부엌에 앉아 있었습니다.",
  "sec": 5.811
 },
 {
  "num": "167",
  "scene": "S28",
  "text": "불씨가 다 사그라들도록요.",
  "sec": 3.371
 },
 {
  "num": "168",
  "scene": "S28",
  "text": "열다섯 해를 삼킨 말이 있었지요.",
  "sec": 3.731
 },
 {
  "num": "169",
  "scene": "S28",
  "text": "그 말을 지금 안 하면요.",
  "sec": 2.571
 },
 {
  "num": "170",
  "scene": "S28",
  "text": "덕이는 도둑으로 끌려가고요.",
  "sec": 3.931
 },
 {
  "num": "171",
  "scene": "S28",
  "text": "섭이네는 그걸 보고 살아야 합니다.",
  "sec": 3.811
 },
 {
  "num": "172",
  "scene": "S28",
  "text": "그러느니 죽는 게 낫다 싶었어요.",
  "sec": 4.451
 },
 {
  "num": "173",
  "scene": "S29",
  "text": "이튿날 새벽에 섭이네가 마님 앞에 엎드렸습니다.",
  "sec": 5.251
 },
 {
  "num": "174",
  "scene": "S29",
  "text": "\"마님, 아뢸 것이 있습니다.\"",
  "sec": 3.491
 },
 {
  "num": "175",
  "scene": "S29",
  "text": "\"열다섯 해를 묵힌 것입니다.\"",
  "sec": 3.411
 },
 {
  "num": "176",
  "scene": "S29",
  "text": "마님이 무슨 소리냐고 했어요.",
  "sec": 3.491
 },
 {
  "num": "177",
  "scene": "S29",
  "text": "섭이네가 말했습니다.",
  "sec": 3.051
 },
 {
  "num": "178",
  "scene": "S29",
  "text": "\"덕이가 바로 마님께서 낳으신 아드님입니다.\"",
  "sec": 4.811
 },
 {
  "num": "179",
  "scene": "S30",
  "text": "마님이 한참을 말을 못 했어요.",
  "sec": 3.011
 },
 {
  "num": "180",
  "scene": "S30",
  "text": "그러고는 무슨 수작이냐고 소리를 질렀습니다.",
  "sec": 5.491
 },
 {
  "num": "181",
  "scene": "S30",
  "text": "섭이네를 끌어내라고 했지요.",
  "sec": 3.331
 },
 {
  "num": "182",
  "scene": "S30",
  "text": "섭이네가 엎드린 채로 말했습니다.",
  "sec": 4.291
 },
 {
  "num": "183",
  "scene": "S30",
  "text": "\"혀를 보시면 압니다.\"",
  "sec": 2.611
 },
 {
  "num": "184",
  "scene": "S31",
  "text": "\"도련님은 혀 밑이 짧습니다.\"",
  "sec": 4.011
 },
 {
  "num": "185",
  "scene": "S31",
  "text": "\"젖을 물 때 왼쪽을 못 물었습니다.\"",
  "sec": 4.131
 },
 {
  "num": "186",
  "scene": "S31",
  "text": "\"반년을 그랬습니다.\"",
  "sec": 2.411
 },
 {
  "num": "187",
  "scene": "S31",
  "text": "\"그건 자라서도 안 고쳐집니다.\"",
  "sec": 2.931
 },
 {
  "num": "188",
  "scene": "S31",
  "text": "\"지금도 혀를 윗입술에 못 대실 겁니다.\"",
  "sec": 4.491
 },
 {
  "num": "189",
  "scene": "S31",
  "text": "\"말이 어눌한 것도 그 때문입니다.\"",
  "sec": 4.211
 },
 {
  "num": "190",
  "scene": "S32",
  "text": "\"그런데 덕이는 혀가 깁니다.\"",
  "sec": 4.171
 },
 {
  "num": "191",
  "scene": "S32",
  "text": "\"왼쪽 오른쪽을 가리지 않고 물었습니다.\"",
  "sec": 4.371
 },
 {
  "num": "192",
  "scene": "S32",
  "text": "\"불난 이튿날 아침에 안방 아이가 왼쪽을 물었습니다.\"",
  "sec": 5.531
 },
 {
  "num": "193",
  "scene": "S32",
  "text": "\"하룻밤 사이에 되는 일이 아닙니다.\"",
  "sec": 3.931
 },
 {
  "num": "194",
  "scene": "S32",
  "text": "\"그날 아이가 바뀐 것입니다.\"",
  "sec": 3.731
 },
 {
  "num": "195",
  "scene": "S32",
  "text": "\"소인이 바꾼 게 아니라, 그 난리에 바뀐 것입니다.\"",
  "sec": 5.091
 },
 {
  "num": "196",
  "scene": "S33",
  "text": "허허, 마님이 그 말을 믿었겠습니까.",
  "sec": 4.011
 },
 {
  "num": "197",
  "scene": "S33",
  "text": "믿고 안 믿고를 떠나서 말이오.",
  "sec": 3.131
 },
 {
  "num": "198",
  "scene": "S33",
  "text": "확인할 방법이 하나 있었지요.",
  "sec": 3.531
 },
 {
  "num": "199",
  "scene": "S34",
  "text": "마님이 치수를 불렀습니다.",
  "sec": 2.971
 },
 {
  "num": "200",
  "scene": "S34",
  "text": "혀를 내밀어 보라고 했어요.",
  "sec": 2.891
 },
 {
  "num": "201",
  "scene": "S34",
  "text": "치수가 혀를 내밀었습니다.",
  "sec": 3.451
 },
 {
  "num": "202",
  "scene": "S34",
  "text": "윗입술에 닿지 않았어요.",
  "sec": 3.091
 },
 {
  "num": "203",
  "scene": "S34",
  "text": "마님이 몇 번을 더 시켰습니다.",
  "sec": 3.851
 },
 {
  "num": "204",
  "scene": "S34",
  "text": "번번이 닿지 않았지요.",
  "sec": 3.011
 },
 {
  "num": "205",
  "scene": "S35",
  "text": "그다음에 덕이를 광에서 꺼내 왔습니다.",
  "sec": 5.091
 },
 {
  "num": "206",
  "scene": "S35",
  "text": "같은 것을 시켰어요.",
  "sec": 2.531
 },
 {
  "num": "207",
  "scene": "S35",
  "text": "덕이 혀가 윗입술을 넘어갔습니다.",
  "sec": 4.411
 },
 {
  "num": "208",
  "scene": "S35",
  "text": "마님이 그 자리에 주저앉았어요.",
  "sec": 4.331
 },
 {
  "num": "209",
  "scene": "S35",
  "text": "열다섯 해 동안 제 아들이라 부른 아이가요.",
  "sec": 3.931
 },
 {
  "num": "210",
  "scene": "S35",
  "text": "제 아들이 아니었던 겁니다.",
  "sec": 3.891
 },
 {
  "num": "211",
  "scene": "S36",
  "text": "일이 커졌으니 관아로 갔습니다.",
  "sec": 3.811
 },
 {
  "num": "212",
  "scene": "S36",
  "text": "사또 앞에서 섭이네가 같은 말을 했어요.",
  "sec": 4.971
 },
 {
  "num": "213",
  "scene": "S36",
  "text": "아전들이 코웃음을 쳤습니다.",
  "sec": 3.291
 },
 {
  "num": "214",
  "scene": "S36",
  "text": "\"젖 먹이던 종년의 말을 믿으시겠습니까.\"",
  "sec": 4.291
 },
 {
  "num": "215",
  "scene": "S36",
  "text": "사또가 눈을 들었어요.",
  "sec": 3.171
 },
 {
  "num": "216",
  "scene": "S36",
  "text": "\"저 사람이 그 아이 둘에게 젖을 먹였다면, 내가 모르는 것을 알 것이다.\"",
  "sec": 9.811
 },
 {
  "num": "217",
  "scene": "S37",
  "text": "사또가 그날 밤 그 집에 있던 사람들을 불렀습니다.",
  "sec": 5.091
 },
 {
  "num": "218",
  "scene": "S37",
  "text": "산파가 나와서 말했어요.",
  "sec": 3.491
 },
 {
  "num": "219",
  "scene": "S37",
  "text": "안방 아이가 혀 밑이 짧아 애를 먹였다고요.",
  "sec": 4.731
 },
 {
  "num": "220",
  "scene": "S37",
  "text": "제가 받은 아이라 기억한다고 했습니다.",
  "sec": 3.811
 },
 {
  "num": "221",
  "scene": "S37",
  "text": "그 말이 섭이네 말과 꼭 맞았어요.",
  "sec": 4.131
 },
 {
  "num": "222",
  "scene": "S37",
  "text": "그 자리에서 결판이 났습니다.",
  "sec": 3.531
 },
 {
  "num": "223",
  "scene": "S38",
  "text": "덕이가 도둑 누명을 벗었습니다.",
  "sec": 3.971
 },
 {
  "num": "224",
  "scene": "S38",
  "text": "가락지는 그 집 조카가 넣어 둔 것이었어요.",
  "sec": 4.491
 },
 {
  "num": "225",
  "scene": "S38",
  "text": "노름빚에 몰려 패물에 손을 댔다가요.",
  "sec": 4.011
 },
 {
  "num": "226",
  "scene": "S38",
  "text": "들통날까 봐 덕이 자리에 밀어 넣은 겁니다.",
  "sec": 4.011
 },
 {
  "num": "227",
  "scene": "S38",
  "text": "열다섯 해 종살이한 아이가 그 집 아들이 됐습니다.",
  "sec": 6.011
 },
 {
  "num": "228",
  "scene": "S38",
  "text": "그런데 그 아이가 웃지를 않았어요.",
  "sec": 4.811
 },
 {
  "num": "229",
  "scene": "S39",
  "text": "치수는 어찌 됐겠습니까.",
  "sec": 3.051
 },
 {
  "num": "230",
  "scene": "S39",
  "text": "하루아침에 종의 자식이 된 겁니다.",
  "sec": 4.011
 },
 {
  "num": "231",
  "scene": "S39",
  "text": "열다섯 해를 도련님으로 산 아이가요.",
  "sec": 4.171
 },
 {
  "num": "232",
  "scene": "S39",
  "text": "마님이 그 아이를 안고 울었습니다.",
  "sec": 4.091
 },
 {
  "num": "233",
  "scene": "S39",
  "text": "내보낼 수가 없었어요.",
  "sec": 2.811
 },
 {
  "num": "234",
  "scene": "S39",
  "text": "제 손으로 열다섯 해를 키웠으니까요.",
  "sec": 3.931
 },
 {
  "num": "235",
  "scene": "S40",
  "text": "마님이 섭이네를 불렀습니다.",
  "sec": 3.491
 },
 {
  "num": "236",
  "scene": "S40",
  "text": "무엇을 원하느냐고 물었어요.",
  "sec": 3.571
 },
 {
  "num": "237",
  "scene": "S40",
  "text": "상을 내리겠다고 했습니다.",
  "sec": 3.291
 },
 {
  "num": "238",
  "scene": "S40",
  "text": "섭이네가 엎드린 채로 말했어요.",
  "sec": 4.091
 },
 {
  "num": "239",
  "scene": "S40",
  "text": "\"소인은 받을 것이 없습니다.\"",
  "sec": 3.571
 },
 {
  "num": "240",
  "scene": "S40",
  "text": "\"다만 한 가지만 청하겠습니다.\"",
  "sec": 3.531
 },
 {
  "num": "241",
  "scene": "S41",
  "text": "\"두 아이를 형제로 두어 주십시오.\"",
  "sec": 4.611
 },
 {
  "num": "242",
  "scene": "S41",
  "text": "마님이 되물었습니다.",
  "sec": 2.451
 },
 {
  "num": "243",
  "scene": "S41",
  "text": "섭이네가 말했어요.",
  "sec": 2.811
 },
 {
  "num": "244",
  "scene": "S41",
  "text": "\"소인이 두 아이에게 같은 젖을 먹였습니다.\"",
  "sec": 4.811
 },
 {
  "num": "245",
  "scene": "S41",
  "text": "\"한 젖을 먹었으면 형제입니다.\"",
  "sec": 3.851
 },
 {
  "num": "246",
  "scene": "S41",
  "text": "\"그러니 한 상에서 밥을 먹게 해 주십시오.\"",
  "sec": 4.771
 },
 {
  "num": "247",
  "scene": "S42",
  "text": "마님이 그렇게 했습니다.",
  "sec": 3.451
 },
 {
  "num": "248",
  "scene": "S42",
  "text": "치수를 아들로 그냥 두었어요.",
  "sec": 3.851
 },
 {
  "num": "249",
  "scene": "S42",
  "text": "덕이도 아들이 됐고요.",
  "sec": 3.051
 },
 {
  "num": "250",
  "scene": "S42",
  "text": "둘이 한 상에서 밥을 먹었습니다.",
  "sec": 4.811
 },
 {
  "num": "251",
  "scene": "S42",
  "text": "처음에는 둘 다 수저를 못 들었다고 해요.",
  "sec": 4.611
 },
 {
  "num": "252",
  "scene": "S42",
  "text": "그러다 한 해쯤 지나니 형 아우 하더랍니다.",
  "sec": 4.771
 },
 {
  "num": "253",
  "scene": "S42",
  "text": "덕이가 글을 배우기 시작했고요.",
  "sec": 3.651
 },
 {
  "num": "254",
  "scene": "S42",
  "text": "치수가 덕이한테 물 긷는 법을 배웠답니다.",
  "sec": 5.051
 },
 {
  "num": "255",
  "scene": "S42",
  "text": "둘 다 열다섯이었으니 늦지 않았지요.",
  "sec": 4.731
 },
 {
  "num": "256",
  "scene": "S43",
  "text": "섭이네는 그 집에서 계속 살았습니다.",
  "sec": 4.931
 },
 {
  "num": "257",
  "scene": "S43",
  "text": "부엌일도 그대로 했어요.",
  "sec": 3.531
 },
 {
  "num": "258",
  "scene": "S43",
  "text": "달라진 게 하나 있다면요.",
  "sec": 2.651
 },
 {
  "num": "259",
  "scene": "S43",
  "text": "두 아이가 아침마다 와서 인사를 했답니다.",
  "sec": 4.531
 },
 {
  "num": "260",
  "scene": "S43",
  "text": "\"어머니, 안녕히 주무셨습니까.\"",
  "sec": 3.131
 },
 {
  "num": "261",
  "scene": "S43",
  "text": "젖어미한테 어머니라고 한 겁니다.",
  "sec": 3.331
 },
 {
  "num": "262",
  "scene": "S43",
  "text": "그 고을에서 그런 일은 처음이었어요.",
  "sec": 4.451
 },
 {
  "num": "263",
  "scene": "S44",
  "text": "섭이네가 일흔까지 살았다고 합니다.",
  "sec": 4.411
 },
 {
  "num": "264",
  "scene": "S44",
  "text": "두 아들이 상을 치렀어요.",
  "sec": 3.171
 },
 {
  "num": "265",
  "scene": "S44",
  "text": "묘비에 젖어미라 쓰지 않고 어머니라 썼답니다.",
  "sec": 4.971
 },
 {
  "num": "266",
  "scene": "S44",
  "text": "그 고을에서는 그 뒤로 이런 말이 돌았지요.",
  "sec": 5.371
 },
 {
  "num": "267",
  "scene": "S44",
  "text": "\"한 젖을 먹었으면 형제다.\"",
  "sec": 4.051
 },
 {
  "num": "268",
  "scene": "S45",
  "text": "허허, 어떻습니까.",
  "sec": 2.731
 },
 {
  "num": "269",
  "scene": "S45",
  "text": "집안 사람 수십이 열다섯 해를 몰랐지요.",
  "sec": 5.091
 },
 {
  "num": "270",
  "scene": "S45",
  "text": "날마다 한 상에서 밥을 먹으면서 말이오.",
  "sec": 4.251
 },
 {
  "num": "271",
  "scene": "S45",
  "text": "정작 아는 사람은 부엌에 있었습니다.",
  "sec": 3.371
 },
 {
  "num": "272",
  "scene": "S46",
  "text": "그런데 말이오.",
  "sec": 2.051
 },
 {
  "num": "273",
  "scene": "S46",
  "text": "섭이네는 그걸 어떻게 알았겠습니까.",
  "sec": 3.851
 },
 {
  "num": "274",
  "scene": "S46",
  "text": "젖을 물렸으니 안 겁니다.",
  "sec": 3.651
 },
 {
  "num": "275",
  "scene": "S46",
  "text": "남들이 품위가 아니라고 안 하던 그 일을요.",
  "sec": 4.931
 },
 {
  "num": "276",
  "scene": "S46",
  "text": "제 아이를 굶겨 가며 한 그 일을 말이지요.",
  "sec": 4.091
 },
 {
  "num": "277",
  "scene": "S46",
  "text": "사람을 낮춰 보면 그 사람이 아는 것까지 낮아 보이는 모양입니다.",
  "sec": 5.851
 },
 {
  "num": "278",
  "scene": "S46",
  "text": "아는 것에 무슨 귀천이 있겠습니까.",
  "sec": 4.251
 },
 {
  "num": "279",
  "scene": "S47",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 5.171
 },
 {
  "num": "280",
  "scene": "S47",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 5.091
 }
]