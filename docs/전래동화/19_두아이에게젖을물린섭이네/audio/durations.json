 },
 {
  "num": "098",
  "scene": "S18",
  "text": "혀 밑이 짧았어요.",
  "sec": 2.971
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "그 아이가 대감댁 도련님이었습니다.",
