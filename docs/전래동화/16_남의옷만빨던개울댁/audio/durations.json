[
 {
  "num": "001",
  "scene": "S01",
  "text": "관아 마당에 빨래하는 여인 하나가 섰습니다.",
  "sec": 4.171
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "손에는 빨랫감 한 벌이 들려 있었어요.",
  "sec": 5.051
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "그러고는 이렇게 말했지요.",
  "sec": 2.971
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "\"아이 옷을 보십시오. 흙이 없습니다.\"",
  "sec": 4.931
 },
 {
  "num": "005",
  "scene": "S01",
  "text": "마당에 있던 사람들이 다 돌아봤어요.",
  "sec": 3.771
 },
 {
  "num": "006",
  "scene": "S01",
  "text": "빨래하는 여인이 관아에서 입을 연 건 처음이었거든요.",
  "sec": 5.611
 },
 {
  "num": "007",
  "scene": "S02",
  "text": "삼십 년을 남의 빨래만 한 여인이었습니다.",
  "sec": 4.371
 },
 {
  "num": "008",
  "scene": "S02",
  "text": "그 말 한마디가 도둑을 바꿔 놓았어요.",
  "sec": 4.891
 },
 {
  "num": "009",
  "scene": "S02",
  "text": "그 여인을 사람들은 개울댁이라 불렀습니다.",
  "sec": 6.131
 },
 {
  "num": "010",
  "scene": "S02",
  "text": "먼저 그 삼십 년부터 들려드리지요.",
  "sec": 4.611
 },
 {
  "num": "011",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 5.611
 },
 {
  "num": "012",
  "scene": "S03",
  "text": "오늘은 빨래 이야기올시다. 때 빼는 이야기지요.",
  "sec": 5.491
 },
 {
  "num": "013",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 6.211
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "옛날 옛적, 경상도 어느 고을에 개울댁이라는 여인이 있었습니다.",
  "sec": 6.851
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "개울가에 산다고 다들 그리 불렀어요.",
  "sec": 4.371
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "하는 일은 빨래였습니다.",
  "sec": 3.051
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "남의 집 빨래를 받아다 해 주고 품삯을 받았지요.",
  "sec": 5.371
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "열일곱에 시작해 삼십 년을 했어요.",
  "sec": 4.091
 },
 {
  "num": "019",
  "scene": "S05",
  "text": "그 고을 사람 절반의 옷이 그 손을 거쳤습니다.",
  "sec": 6.291
 },
 {
  "num": "020",
  "scene": "S05",
  "text": "양반집 비단도, 머슴 삼베도요.",
  "sec": 4.251
 },
 {
  "num": "021",
  "scene": "S05",
  "text": "죽은 사람 수의까지 빨아 본 손이었지요.",
  "sec": 4.251
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "그 시절 빨래하는 사람은 품삯이 제일 쌌어요.",
  "sec": 5.971
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "남의 때를 만지는 일이라고요.",
  "sec": 3.291
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "삯을 받을 때도 마당에서 받았지 방에는 못 들어갔습니다.",
  "sec": 6.771
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "개울댁은 그런 대접에 익숙했어요.",
  "sec": 5.011
 },
 {
  "num": "026",
  "scene": "S06",
  "text": "따지는 법도 없었고요.",
  "sec": 2.291
 },
 {
  "num": "027",
  "scene": "S06",
  "text": "\"빨래하는 사람은 입이 없어야 한다.\"",
  "sec": 3.811
 },
 {
  "num": "028",
  "scene": "S06",
  "text": "제 어미한테 그렇게 배웠다고 합니다.",
  "sec": 4.411
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "그런데 빨래를 하다 보면 보이는 게 있습니다.",
  "sec": 5.411
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "옷은 그 사람이 어디서 뭘 했는지를 다 적어 둡니다.",
  "sec": 6.611
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "땀 자국이 깊으면 앓는 사람이고요.",
  "sec": 4.211
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "소매 끝이 안 닳았으면 들일을 안 하는 사람입니다.",
  "sec": 5.451
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "밑단이 젖었다 마른 자국이 있으면 밤길을 다닌 사람이지요.",
  "sec": 6.291
 },
 {
  "num": "034",
  "scene": "S07",
  "text": "이슬은 아침에 마르면서 얼룩을 남기거든요.",
  "sec": 4.771
 },
 {
  "num": "035",
  "scene": "S07",
  "text": "낮에 묻은 물자국과는 결이 다릅니다.",
  "sec": 4.171
 },
 {
  "num": "036",
  "scene": "S07",
  "text": "삼십 년을 보면 그게 눈에 들어옵니다.",
  "sec": 4.571
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "개울댁은 그걸 다 알았어요.",
  "sec": 4.131
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "누가 아픈지, 누가 밤에 나다니는지요.",
  "sec": 5.411
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "그런데 입은 한 번도 안 열었습니다.",
  "sec": 4.771
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "빨래하는 사람이 남의 집 말을 옮기면 그걸로 끝이거든요.",
  "sec": 5.131
 },
 {
  "num": "041",
  "scene": "S08",
  "text": "삼십 년을 그렇게 다물었어요.",
  "sec": 4.091
 },
 {
  "num": "042",
  "scene": "S08",
  "text": "어느 집 안방 사정도, 어느 집 바깥양반 버릇도요.",
  "sec": 5.131
 },
 {
  "num": "043",
  "scene": "S08",
  "text": "개울댁이 입을 열었으면 고을이 몇 번은 뒤집혔을 겁니다.",
  "sec": 5.411
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "개울댁은 해 뜨기 전에 나가 해 지고 들어왔어요.",
  "sec": 5.651
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "겨울에도 그랬습니다.",
  "sec": 3.211
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "얼음을 깨고 빨래를 했지요.",
  "sec": 3.291
 },
 {
  "num": "047",
  "scene": "S09",
  "text": "손이 터져 피가 나도 그 손으로 또 빨았어요.",
  "sec": 5.491
 },
 {
  "num": "048",
  "scene": "S09",
  "text": "겨울 빨래는 그래서 품삯을 더 받았습니다.",
  "sec": 5.051
 },
 {
  "num": "049",
  "scene": "S09",
  "text": "그래 봐야 남정네 품삯 반값이었지만요.",
  "sec": 4.931
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "그 고을에 정 대감댁이라는 집이 있었습니다.",
  "sec": 4.971
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "고을에서 제일 큰 집이었어요.",
  "sec": 3.811
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "개울댁은 그 집 빨래도 받아 했습니다.",
  "sec": 4.731
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "그 집 옷이 제일 많고 제일 까다로웠지요.",
  "sec": 4.771
 },
 {
  "num": "054",
  "scene": "S10",
  "text": "비단은 방망이로 두드리면 안 되거든요.",
  "sec": 4.331
 },
 {
  "num": "055",
  "scene": "S10",
  "text": "손으로 조물조물 누르고 그늘에 말려야 합니다.",
  "sec": 4.571
 },
 {
  "num": "056",
  "scene": "S10",
  "text": "그걸 할 줄 아는 사람이 고을에 개울댁뿐이었어요.",
  "sec": 5.571
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "그 집에 부엌데기로 들어온 아이가 하나 있었어요.",
  "sec": 4.931
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "열세 살 난 계집아이였습니다.",
  "sec": 3.571
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "이름은 삼순이라 했지요.",
  "sec": 2.971
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "부모가 없어 얻어먹고 사는 아이였어요.",
  "sec": 3.611
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "말수가 없고 일만 했습니다.",
  "sec": 3.851
 },
 {
  "num": "062",
  "scene": "S11",
  "text": "새벽에 제일 먼저 일어나 불을 지폈지요.",
  "sec": 5.091
 },
 {
  "num": "063",
  "scene": "S11",
  "text": "그 집에서 제일 어린 사람이 제일 먼저 일어나던 시절입니다.",
  "sec": 6.411
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "그해 가을이었어요.",
  "sec": 3.131
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "대감댁 안방에서 패물이 없어졌습니다.",
  "sec": 5.011
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "금가락지 두 개에 은비녀 셋이었어요.",
  "sec": 4.811
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "대감 부인이 시집올 때 가져온 것이었지요.",
  "sec": 4.531
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "집안이 발칵 뒤집혔습니다.",
  "sec": 3.611
 },
 {
  "num": "069",
  "scene": "S12",
  "text": "대감 부인이 그날 저녁에야 알았어요.",
  "sec": 4.411
 },
 {
  "num": "070",
  "scene": "S12",
  "text": "경대 서랍을 열었는데 비어 있었다고 합니다.",
  "sec": 5.131
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "온 집안을 뒤졌어요.",
  "sec": 2.931
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "종들 방부터 뒤졌지요.",
  "sec": 3.291
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "그런데 뒤란 담 밑에서 댕기가 하나 나왔습니다.",
  "sec": 7.331
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "삼순이 댕기였어요.",
  "sec": 2.851
 },
 {
  "num": "075",
  "scene": "S13",
  "text": "빨간 댕기 한 짝이 흙에 반쯤 묻혀 있었지요.",
  "sec": 6.531
 },
 {
  "num": "076",
  "scene": "S13",
  "text": "그걸 본 집사가 바로 소리를 질렀습니다.",
  "sec": 4.251
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "그걸로 끝이었습니다.",
  "sec": 2.931
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "삼순이가 잡혔어요.",
  "sec": 3.531
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "\"담을 넘어 달아나려다 떨어뜨린 게지.\"",
  "sec": 3.571
 },
 {
  "num": "080",
  "scene": "S14",
  "text": "아이는 아니라고 했습니다.",
  "sec": 3.211
 },
 {
  "num": "081",
  "scene": "S14",
  "text": "울면서 아니라고 했지요.",
  "sec": 3.011
 },
 {
  "num": "082",
  "scene": "S14",
  "text": "그런데 아무도 안 들었어요.",
  "sec": 3.651
 },
 {
  "num": "083",
  "scene": "S14",
  "text": "부모 없는 아이 말을 누가 듣겠습니까.",
  "sec": 4.451
 },
 {
  "num": "084",
  "scene": "S14",
  "text": "그날로 광에 갇혔다가 관아로 넘어갔습니다.",
  "sec": 6.611
 },
 {
  "num": "085",
  "scene": "S15",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 5.011
 },
 {
  "num": "086",
  "scene": "S15",
  "text": "없는 집 아이한테 누명 씌우기가 그 시절엔 제일 쉬웠지요.",
  "sec": 5.891
 },
 {
  "num": "087",
  "scene": "S15",
  "text": "댕기 한 짝이면 충분했으니까요.",
  "sec": 3.731
 },
 {
  "num": "088",
  "scene": "S15",
  "text": "그런데 그 댕기가 거기 왜 있었겠습니까.",
  "sec": 4.691
 },
 {
  "num": "089",
  "scene": "S16",
  "text": "그 소문이 개울댁 귀에도 들어왔어요.",
  "sec": 4.891
 },
 {
  "num": "090",
  "scene": "S16",
  "text": "마침 그날 대감댁 빨래가 와 있었습니다.",
  "sec": 4.771
 },
 {
  "num": "091",
  "scene": "S16",
  "text": "그 속에 삼순이 옷도 섞여 있었지요.",
  "sec": 4.771
 },
 {
  "num": "092",
  "scene": "S16",
  "text": "개울댁이 그 옷을 집어 들었어요.",
  "sec": 4.251
 },
 {
  "num": "093",
  "scene": "S16",
  "text": "아이가 잡혀가기 전날 벗어 놓은 옷이었습니다.",
  "sec": 5.331
 },
 {
  "num": "094",
  "scene": "S16",
  "text": "빨래 바구니에 그대로 들어 있었지요.",
  "sec": 4.011
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "무릎을 봤습니다.",
  "sec": 2.291
 },
 {
  "num": "096",
  "scene": "S17",
  "text": "깨끗했어요.",
  "sec": 2.331
 },
 {
  "num": "097",
  "scene": "S17",
  "text": "흙이 한 톨도 없었습니다.",
  "sec": 3.011
 },
 {
  "num": "098",
  "scene": "S17",
  "text": "개울댁은 그 자리에 한참 앉아 있었어요.",
  "sec": 4.291
 },
 {
  "num": "099",
  "scene": "S17",
  "text": "손에 든 옷을 몇 번이나 뒤집어 봤습니다.",
  "sec": 4.931
 },
 {
  "num": "100",
  "scene": "S17",
  "text": "앞도 뒤도 소매도요. 흙은 어디에도 없었어요.",
  "sec": 6.011
 },
 {
  "num": "101",
  "scene": "S18",
  "text": "담을 넘은 사람 옷은 반드시 무릎에 흙이 묻습니다.",
  "sec": 6.611
 },
 {
  "num": "102",
  "scene": "S18",
  "text": "담벼락을 차고 오르니까요.",
  "sec": 2.571
 },
 {
  "num": "103",
  "scene": "S18",
  "text": "아무리 조심해도 무릎과 신코에는 남아요.",
  "sec": 5.011
 },
 {
  "num": "104",
  "scene": "S18",
  "text": "삼십 년을 빨면서 그걸 수없이 봤습니다.",
  "sec": 5.171
 },
 {
  "num": "105",
  "scene": "S18",
  "text": "그런데 그 아이 옷은 깨끗했어요.",
  "sec": 5.451
 },
 {
  "num": "106",
  "scene": "S18",
  "text": "담을 넘지 않았다는 뜻입니다.",
  "sec": 3.211
 },
 {
  "num": "107",
  "scene": "S18",
  "text": "그러면 그 댕기는 누가 거기 떨어뜨렸겠습니까.",
  "sec": 4.611
 },
 {
  "num": "108",
  "scene": "S19",
  "text": "개울댁이 다음 날 대감댁 빨래를 다시 받으러 갔어요.",
  "sec": 5.971
 },
 {
  "num": "109",
  "scene": "S19",
  "text": "평소에는 받아만 오고 말았지요.",
  "sec": 3.051
 },
 {
  "num": "110",
  "scene": "S19",
  "text": "그날은 빨랫감을 마당에서 하나씩 들춰 봤습니다.",
  "sec": 6.451
 },
 {
  "num": "111",
  "scene": "S19",
  "text": "집사가 뭐 하느냐고 물었어요.",
  "sec": 3.371
 },
 {
  "num": "112",
  "scene": "S19",
  "text": "\"때가 심한 것부터 담그려고요.\" 했지요.",
  "sec": 4.051
 },
 {
  "num": "113",
  "scene": "S19",
  "text": "집사가 별말 없이 지나갔어요.",
  "sec": 3.891
 },
 {
  "num": "114",
  "scene": "S19",
  "text": "빨래하는 여인이 빨랫감을 들춰 보는 걸 누가 이상하게 보겠습니까.",
  "sec": 7.051
 },
 {
  "num": "115",
  "scene": "S20",
  "text": "그러다 한 벌에서 손이 멎었습니다.",
  "sec": 3.731
 },
 {
  "num": "116",
  "scene": "S20",
  "text": "소매에 푸른 것이 묻어 있었어요.",
  "sec": 3.971
 },
 {
  "num": "117",
  "scene": "S20",
  "text": "흙도 아니고 풀물도 아니었습니다.",
  "sec": 4.011
 },
 {
  "num": "118",
  "scene": "S20",
  "text": "기와에 낀 이끼였어요.",
  "sec": 2.691
 },
 {
  "num": "119",
  "scene": "S20",
  "text": "지붕을 탄 사람 옷에만 묻는 것이지요.",
  "sec": 4.051
 },
 {
  "num": "120",
  "scene": "S20",
  "text": "기와 사이에 낀 이끼는 마르면 가루가 됩니다.",
  "sec": 5.291
 },
 {
  "num": "121",
  "scene": "S20",
  "text": "옷에 묻으면 푸른 자국이 길게 남아요.",
  "sec": 4.811
 },
 {
  "num": "122",
  "scene": "S20",
  "text": "빨아도 두 번은 해야 지워집니다.",
  "sec": 4.171
 },
 {
  "num": "123",
  "scene": "S21",
  "text": "개울댁이 지붕을 올려다봤어요.",
  "sec": 3.651
 },
 {
  "num": "124",
  "scene": "S21",
  "text": "안채 지붕에서 뒤란 광으로 바로 내려올 수 있었습니다.",
  "sec": 5.931
 },
 {
  "num": "125",
  "scene": "S21",
  "text": "담을 넘을 까닭이 없는 사람이었어요.",
  "sec": 3.571
 },
 {
  "num": "126",
  "scene": "S21",
  "text": "집 안에 있던 사람이니까요.",
  "sec": 2.771
 },
 {
  "num": "127",
  "scene": "S21",
  "text": "그 옷이 누구 것인지도 알았습니다.",
  "sec": 4.291
 },
 {
  "num": "128",
  "scene": "S21",
  "text": "삼십 년을 빨았는데 모를 리가 없지요.",
  "sec": 4.091
 },
 {
  "num": "129",
  "scene": "S21",
  "text": "솔기 꿰맨 자리, 단 접은 품이 집집마다 다르거든요.",
  "sec": 7.811
 },
 {
  "num": "130",
  "scene": "S21",
  "text": "개울댁은 옷만 보고도 누구 것인지 알았습니다.",
  "sec": 4.851
 },
 {
  "num": "131",
  "scene": "S22",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 5.011
 },
 {
  "num": "132",
  "scene": "S23",
  "text": "개울댁이 관아로 갔습니다.",
  "sec": 3.251
 },
 {
  "num": "133",
  "scene": "S23",
  "text": "빨래하는 여인이 관아에 발을 들이는 일은 없었어요.",
  "sec": 5.491
 },
 {
  "num": "134",
  "scene": "S23",
  "text": "문지기가 막았지요.",
  "sec": 2.811
 },
 {
  "num": "135",
  "scene": "S23",
  "text": "개울댁이 말했습니다.",
  "sec": 2.891
 },
 {
  "num": "136",
  "scene": "S23",
  "text": "\"도둑 든 집 빨래를 하는 사람입니다. 드릴 말씀이 있습니다.\"",
  "sec": 5.611
 },
 {
  "num": "137",
  "scene": "S23",
  "text": "문지기가 한참을 망설이다 안에 들였어요.",
  "sec": 5.371
 },
 {
  "num": "138",
  "scene": "S23",
  "text": "개울댁은 그때까지 관아 문턱을 넘어 본 적이 없었습니다.",
  "sec": 7.371
 },
 {
  "num": "139",
  "scene": "S24",
  "text": "사또 앞에 엎드려 아이 옷을 들어 보였어요.",
  "sec": 4.651
 },
 {
  "num": "140",
  "scene": "S24",
  "text": "\"아이 옷을 보십시오. 흙이 없습니다.\"",
  "sec": 4.771
 },
 {
  "num": "141",
  "scene": "S24",
  "text": "\"담을 넘은 사람은 반드시 무릎에 흙이 묻습니다.\"",
  "sec": 5.891
 },
 {
  "num": "142",
  "scene": "S24",
  "text": "\"소인이 삼십 년을 빨래했습니다. 그것만은 압니다.\"",
  "sec": 5.571
 },
 {
  "num": "143",
  "scene": "S24",
  "text": "\"담벼락을 차고 오르면 무릎에 흙이 박힙니다.\"",
  "sec": 5.171
 },
 {
  "num": "144",
  "scene": "S24",
  "text": "\"털어도 안 지고 빨아야 지는 자국입니다.\"",
  "sec": 4.451
 },
 {
  "num": "145",
  "scene": "S24",
  "text": "\"이 옷에는 그게 없습니다.\"",
  "sec": 3.451
 },
 {
  "num": "146",
  "scene": "S25",
  "text": "사또가 물었어요.",
  "sec": 2.331
 },
 {
  "num": "147",
  "scene": "S25",
  "text": "\"그러면 누가 가져갔다는 말이냐.\"",
  "sec": 3.691
 },
 {
  "num": "148",
  "scene": "S25",
  "text": "개울댁이 다른 옷 한 벌을 꺼냈습니다.",
  "sec": 4.731
 },
 {
  "num": "149",
  "scene": "S25",
  "text": "소매가 위로 오게 펴 놓았지요.",
  "sec": 3.491
 },
 {
  "num": "150",
  "scene": "S25",
  "text": "그 집 빨랫감에서 가져온 옷이었습니다.",
  "sec": 3.331
 },
 {
  "num": "151",
  "scene": "S25",
  "text": "그날 아침에 받아 온 것이었지요.",
  "sec": 3.851
 },
 {
  "num": "152",
  "scene": "S26",
  "text": "\"여기 푸른 것이 보이십니까.\"",
  "sec": 3.451
 },
 {
  "num": "153",
  "scene": "S26",
  "text": "\"기와 이끼입니다.\"",
  "sec": 2.491
 },
 {
  "num": "154",
  "scene": "S26",
  "text": "\"지붕에 올라간 사람 소매에만 묻습니다.\"",
  "sec": 4.131
 },
 {
  "num": "155",
  "scene": "S26",
  "text": "\"담을 넘은 자국은 무릎에, 지붕을 탄 자국은 소매에 남습니다.\"",
  "sec": 7.371
 },
 {
  "num": "156",
  "scene": "S26",
  "text": "사또가 그 소매를 한참 들여다봤어요.",
  "sec": 4.731
 },
 {
  "num": "157",
  "scene": "S26",
  "text": "그러고는 아전을 불렀습니다.",
  "sec": 4.331
 },
 {
  "num": "158",
  "scene": "S26",
  "text": "\"이 옷이 누구 옷인지 알아 오너라.\"",
  "sec": 5.211
 },
 {
  "num": "159",
  "scene": "S27",
  "text": "그 옷은 대감댁 조카 것이었습니다.",
  "sec": 5.411
 },
 {
  "num": "160",
  "scene": "S27",
  "text": "한양에서 내려와 몇 달 묵고 있던 사람이었어요.",
  "sec": 6.691
 },
 {
  "num": "161",
  "scene": "S27",
  "text": "노름빚이 있다는 말이 돌던 사람이지요.",
  "sec": 3.731
 },
 {
  "num": "162",
  "scene": "S27",
  "text": "사또가 그 조카를 불러들였습니다.",
  "sec": 3.731
 },
 {
  "num": "163",
  "scene": "S27",
  "text": "조카는 펄쩍 뛰었어요.",
  "sec": 3.291
 },
 {
  "num": "164",
  "scene": "S27",
  "text": "\"빨래나 하는 아낙의 말을 믿으시겠습니까.\"",
  "sec": 5.011
 },
 {
  "num": "165",
  "scene": "S27",
  "text": "그 말에 사또가 눈을 들었습니다.",
  "sec": 4.011
 },
 {
  "num": "166",
  "scene": "S27",
  "text": "\"믿고 안 믿고는 내가 정한다.\"",
  "sec": 4.171
 },
 {
  "num": "167",
  "scene": "S28",
  "text": "그런데 그 방 마루 밑에서 보따리가 나왔어요.",
  "sec": 5.291
 },
 {
  "num": "168",
  "scene": "S28",
  "text": "금가락지 두 개에 은비녀 셋이었습니다.",
  "sec": 4.731
 },
 {
  "num": "169",
  "scene": "S28",
  "text": "하나도 축나지 않고 그대로였지요.",
  "sec": 4.731
 },
 {
  "num": "170",
  "scene": "S28",
  "text": "아직 팔지 못한 것이었어요.",
  "sec": 3.211
 },
 {
  "num": "171",
  "scene": "S28",
  "text": "한양 장에 내다 팔 작정이었다고 합니다.",
  "sec": 4.491
 },
 {
  "num": "172",
  "scene": "S28",
  "text": "고을에서 팔면 바로 들통이 나니까요.",
  "sec": 3.931
 },
 {
  "num": "173",
  "scene": "S29",
  "text": "허허, 그래서 삼순이는 어찌 되었겠습니까.",
  "sec": 5.491
 },
 {
  "num": "174",
  "scene": "S30",
  "text": "삼순이가 풀려났어요.",
  "sec": 2.571
 },
 {
  "num": "175",
  "scene": "S30",
  "text": "문밖에 개울댁이 서 있었습니다.",
  "sec": 3.371
 },
 {
  "num": "176",
  "scene": "S30",
  "text": "아이가 개울댁을 보고 울음을 터뜨렸어요.",
  "sec": 4.691
 },
 {
  "num": "177",
  "scene": "S30",
  "text": "개울댁은 아무 말도 안 하고 손만 잡아 줬습니다.",
  "sec": 5.251
 },
 {
  "num": "178",
  "scene": "S30",
  "text": "아이 손이 얼음장 같았다고 해요.",
  "sec": 3.891
 },
 {
  "num": "179",
  "scene": "S30",
  "text": "광에서 사흘을 떨었으니 그럴 만도 했지요.",
  "sec": 4.611
 },
 {
  "num": "180",
  "scene": "S31",
  "text": "며칠 뒤 대감 부인이 개울댁을 찾아왔어요.",
  "sec": 5.011
 },
 {
  "num": "181",
  "scene": "S31",
  "text": "양반 부인이 빨래하는 여인을 찾아온 겁니다.",
  "sec": 5.131
 },
 {
  "num": "182",
  "scene": "S31",
  "text": "그러고는 고개를 숙였습니다.",
  "sec": 3.371
 },
 {
  "num": "183",
  "scene": "S31",
  "text": "\"내가 그 아이를 도둑으로 몰 뻔했소.\"",
  "sec": 5.291
 },
 {
  "num": "184",
  "scene": "S31",
  "text": "개울댁이 놀라 손을 내저었어요.",
  "sec": 3.931
 },
 {
  "num": "185",
  "scene": "S31",
  "text": "\"마님, 이러시면 소인이 죽습니다.\"",
  "sec": 5.651
 },
 {
  "num": "186",
  "scene": "S31",
  "text": "부인이 고개를 더 숙였습니다.",
  "sec": 3.931
 },
 {
  "num": "187",
  "scene": "S32",
  "text": "사례를 보내왔어요.",
  "sec": 2.251
 },
 {
  "num": "188",
  "scene": "S32",
  "text": "엽전 꾸러미가 제법 묵직했습니다.",
  "sec": 4.491
 },
 {
  "num": "189",
  "scene": "S32",
  "text": "개울댁이 받지 않았어요.",
  "sec": 3.491
 },
 {
  "num": "190",
  "scene": "S32",
  "text": "\"소인은 빨래를 봤을 뿐입니다.\"",
  "sec": 4.171
 },
 {
  "num": "191",
  "scene": "S32",
  "text": "\"옷이 말한 것이지 소인이 말한 게 아닙니다.\"",
  "sec": 4.211
 },
 {
  "num": "192",
  "scene": "S32",
  "text": "\"소인은 그저 삼십 년을 빨았을 뿐입니다.\"",
  "sec": 5.011
 },
 {
  "num": "193",
  "scene": "S32",
  "text": "\"그 삼십 년이 아니었으면 소인도 못 봤을 겁니다.\"",
  "sec": 5.211
 },
 {
  "num": "194",
  "scene": "S33",
  "text": "대신 한 가지만 청했어요.",
  "sec": 3.371
 },
 {
  "num": "195",
  "scene": "S33",
  "text": "\"개울가에 돌판을 하나만 놓아 주십시오.\"",
  "sec": 4.091
 },
 {
  "num": "196",
  "scene": "S33",
  "text": "\"빨래를 두드릴 자리가 없어 다들 바위를 찾아 헤맵니다.\"",
  "sec": 5.371
 },
 {
  "num": "197",
  "scene": "S33",
  "text": "\"겨울에는 미끄러져 다치는 사람도 있고요.\"",
  "sec": 4.131
 },
 {
  "num": "198",
  "scene": "S33",
  "text": "\"삼십 년을 그 자리에서 빨래했는데 아무도 그걸 묻지 않았습니다.\"",
  "sec": 5.851
 },
 {
  "num": "199",
  "scene": "S33",
  "text": "부인이 그 말에 한참을 말을 못 했어요.",
  "sec": 4.851
 },
 {
  "num": "200",
  "scene": "S33",
  "text": "엽전 꾸러미보다 돌판 하나가 어려운 청이 아니었는데 말이지요.",
  "sec": 6.771
 },
 {
  "num": "201",
  "scene": "S34",
  "text": "이듬해 봄에 개울가에 돌판이 놓였습니다.",
  "sec": 4.811
 },
 {
  "num": "202",
  "scene": "S34",
  "text": "넓적한 돌을 다듬어 줄줄이 깔았어요.",
  "sec": 4.171
 },
 {
  "num": "203",
  "scene": "S34",
  "text": "여인들이 나란히 앉아 빨래를 하게 되었지요.",
  "sec": 4.691
 },
 {
  "num": "204",
  "scene": "S34",
  "text": "그 자리를 사람들이 개울댁 자리라고 불렀습니다.",
  "sec": 6.771
 },
 {
  "num": "205",
  "scene": "S34",
  "text": "여름에는 그 위에 발을 담그고 쉬었고요.",
  "sec": 4.891
 },
 {
  "num": "206",
  "scene": "S34",
  "text": "겨울에는 미끄러지는 사람이 없어졌습니다.",
  "sec": 4.491
 },
 {
  "num": "207",
  "scene": "S35",
  "text": "삼순이는 그 뒤로 개울댁을 따라다녔어요.",
  "sec": 4.291
 },
 {
  "num": "208",
  "scene": "S35",
  "text": "대감댁을 나와 빨래를 배웠지요.",
  "sec": 3.851
 },
 {
  "num": "209",
  "scene": "S35",
  "text": "사람들이 왜 그러느냐 물으면 이렇게 답했답니다.",
  "sec": 5.451
 },
 {
  "num": "210",
  "scene": "S35",
  "text": "\"이 어른은 제 옷을 봐 주신 분입니다.\"",
  "sec": 4.971
 },
 {
  "num": "211",
  "scene": "S35",
  "text": "아무도 안 본 것을 한 사람이 봤으니까요.",
  "sec": 4.891
 },
 {
  "num": "212",
  "scene": "S35",
  "text": "그것도 제일 낮은 자리에 앉아 있던 사람이요.",
  "sec": 4.451
 },
 {
  "num": "213",
  "scene": "S36",
  "text": "개울댁은 예순이 넘도록 빨래를 했다고 합니다.",
  "sec": 5.211
 },
 {
  "num": "214",
  "scene": "S36",
  "text": "눈이 어두워진 뒤에도 손으로 때를 찾았다지요.",
  "sec": 4.491
 },
 {
  "num": "215",
  "scene": "S36",
  "text": "삼순이가 곁에서 거들었고요.",
  "sec": 3.571
 },
 {
  "num": "216",
  "scene": "S37",
  "text": "그 고을에서는 그 뒤로 이런 말이 돌았답니다.",
  "sec": 4.931
 },
 {
  "num": "217",
  "scene": "S37",
  "text": "\"옷은 거짓말을 안 한다.\"",
  "sec": 3.051
 },
 {
  "num": "218",
  "scene": "S37",
  "text": "빨래하는 사람 앞에서는 숨길 게 없다는 뜻이었지요.",
  "sec": 5.571
 },
 {
  "num": "219",
  "scene": "S37",
  "text": "그 말이 고을에 돌고부터는 밤나들이가 줄었다고 합니다. 허허.",
  "sec": 7.371
 },
 {
  "num": "220",
  "scene": "S38",
  "text": "허허, 어떻습니까.",
  "sec": 3.131
 },
 {
  "num": "221",
  "scene": "S38",
  "text": "눈 밝은 사람 수십이 못 본 것을, 빨래하는 손 하나가 봤지요.",
  "sec": 8.211
 },
 {
  "num": "222",
  "scene": "S38",
  "text": "남의 때를 만지는 일이라고 천대받던 그 손이 말이올시다.",
  "sec": 5.491
 },
 {
  "num": "223",
  "scene": "S38",
  "text": "사람을 천하게 보면 그 사람이 아는 것도 함께 천해 보이는 모양입니다.",
  "sec": 8.171
 },
 {
  "num": "224",
  "scene": "S38",
  "text": "아는 것에 무슨 귀천이 있겠습니까.",
  "sec": 4.771
 },
 {
  "num": "225",
  "scene": "S39",
  "text": "그런데 말이오. 그 대감댁 조카는 그 뒤로 어찌 되었겠습니까.",
  "sec": 8.171
 },
 {
  "num": "226",
