[
 {
  "num": "001",
  "scene": "S01",
  "text": "관아 마당에 수레꾼 하나가 불려 왔습니다.",
  "sec": 4.331
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "그러고는 땅바닥을 가리켰어요.",
  "sec": 3.851
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "\"나갈 때는 가벼웠고, 들어올 때가 무거웠습니다.\"",
  "sec": 6.451
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "그 한마디에 도둑이 바뀌었지요.",
  "sec": 3.931
 },
 {
  "num": "005",
  "scene": "S01",
  "text": "마당에 있던 아전들이 다 돌아봤어요.",
  "sec": 4.211
 },
 {
  "num": "006",
  "scene": "S01",
  "text": "수레꾼이 관아에서 입을 연 건 처음이었거든요.",
  "sec": 4.731
 },
 {
  "num": "007",
  "scene": "S02",
  "text": "삼십 년을 남의 수레만 몬 사람이었습니다.",
  "sec": 4.651
 },
 {
  "num": "008",
  "scene": "S02",
  "text": "그 사람 이름이 만수였어요.",
  "sec": 3.651
 },
 {
  "num": "009",
  "scene": "S02",
  "text": "먼저 그 삼십 년부터 들려드리지요.",
  "sec": 3.571
 },
 {
  "num": "010",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 5.571
 },
 {
  "num": "011",
  "scene": "S03",
  "text": "오늘은 바퀴 자국 이야기올시다.",
  "sec": 3.491
 },
 {
  "num": "012",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 5.411
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "옛날 옛적, 전라도 어느 고을에 만수라는 사람이 있었습니다.",
  "sec": 6.451
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "수레꾼이었어요.",
  "sec": 2.211
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "남의 짐을 수레에 싣고 날라 주는 사람이지요.",
  "sec": 5.211
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "열여섯에 아비를 따라 시작해 삼십 년을 몰았습니다.",
  "sec": 5.371
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "소 한 마리와 수레 한 대가 전 재산이었어요.",
  "sec": 5.691
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "소 이름은 먹쇠라 했습니다.",
  "sec": 3.371
 },
 {
  "num": "019",
  "scene": "S05",
  "text": "열두 해를 같이 다닌 소였지요.",
  "sec": 3.811
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "수레꾼은 품삯이 싸고 일이 고됐어요.",
  "sec": 5.091
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "짐은 제가 싣고 제가 내려야 했거든요.",
  "sec": 4.531
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "비가 오면 바퀴가 빠져 하루를 길에서 보냈고요.",
  "sec": 5.331
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "그래도 만수는 한 번도 짐을 축낸 적이 없었습니다.",
  "sec": 5.971
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "그래서 고을에서 짐을 맡길 때는 만수를 찾았어요.",
  "sec": 5.131
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "쌀 한 되가 비면 제 돈으로 채워 넣었거든요.",
  "sec": 5.091
 },
 {
  "num": "026",
  "scene": "S06",
  "text": "그걸 삼십 년 했으니 누가 안 믿겠습니까.",
  "sec": 4.531
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "수레를 삼십 년 몰면 땅이 보입니다.",
  "sec": 4.731
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "짐을 실은 수레는 바퀴가 깊이 박혀요.",
  "sec": 5.251
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "빈 수레는 자국이 얕고 흙이 덜 뭉개집니다.",
  "sec": 5.771
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "오르막에서는 바퀴가 미끄러져 자국이 길게 끌리고요.",
  "sec": 5.611
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "내리막에서는 짧게 찍히지요.",
  "sec": 3.571
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "땅이 마르면 자국이 얕고 비가 오면 깊어집니다.",
  "sec": 7.171
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "그래서 자국만 보고는 안 되고 그날 날씨를 같이 셈해야 해요.",
  "sec": 6.531
 },
 {
  "num": "034",
  "scene": "S07",
  "text": "삼십 년을 보면 그게 몸에 붙습니다.",
  "sec": 4.291
 },
 {
  "num": "035",
  "scene": "S08",
  "text": "만수는 그걸로 많은 걸 알았어요.",
  "sec": 4.331
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "어느 수레가 언제 지나갔는지요.",
  "sec": 4.811
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "짐을 싣고 갔는지 빈 채로 갔는지도요.",
  "sec": 5.171
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "소가 끌었는지 사람이 끌었는지까지 알았습니다.",
  "sec": 4.811
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "소는 발굽 자국이 바퀴 사이에 남거든요.",
  "sec": 5.251
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "사람이 끌면 발자국이 바퀴 바깥에 남고요.",
  "sec": 5.611
 },
 {
  "num": "041",
  "scene": "S08",
  "text": "만수는 그걸로 어느 집 수레인지도 맞혔습니다.",
  "sec": 4.651
 },
 {
  "num": "042",
  "scene": "S09",
  "text": "만수는 밤길도 많이 다녔어요.",
  "sec": 4.811
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "짐이 급하면 밤에도 몰아야 했거든요.",
  "sec": 4.331
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "별을 보고 길을 가늠했지요.",
  "sec": 4.091
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "그렇게 삼십 년을 다녔습니다.",
  "sec": 3.171
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "그 고을 길이란 길은 발바닥으로 다 외웠어요.",
  "sec": 5.811
 },
 {
  "num": "047",
  "scene": "S09",
  "text": "어디가 패였는지, 어디가 미끄러운지까지요.",
  "sec": 4.451
 },
 {
  "num": "048",
  "scene": "S10",
  "text": "그해 가을이었어요.",
  "sec": 2.811
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "고을 관아 창고에서 곡식이 없어졌습니다.",
  "sec": 4.851
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "환곡으로 거둬 둔 벼 백 석이었어요.",
  "sec": 4.171
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "백성한테 봄에 꿔 주고 가을에 거둔 곡식이지요.",
  "sec": 5.611
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "그게 하룻밤 사이에 사라진 겁니다.",
  "sec": 4.451
 },
 {
  "num": "053",
  "scene": "S10",
  "text": "벼 백 석이면 수레로 열 번은 날라야 하는 양이에요.",
  "sec": 6.451
 },
 {
  "num": "054",
  "scene": "S10",
  "text": "하룻밤에 그걸 옮겼다는 게 말이 안 됐지요.",
  "sec": 5.211
 },
 {
  "num": "055",
  "scene": "S11",
  "text": "창고지기가 잡혔어요.",
  "sec": 2.731
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "예순이 넘은 노인이었습니다.",
  "sec": 3.731
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "삼십 년을 그 창고를 지킨 사람이었어요.",
  "sec": 4.091
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "열쇠를 가진 사람이 그뿐이었거든요.",
  "sec": 4.171
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "노인은 아무것도 모른다고 했습니다.",
  "sec": 3.811
 },
 {
  "num": "060",
  "scene": "S11",
  "text": "아침에 와 보니 창고가 비어 있었다고요.",
  "sec": 3.691
 },
 {
  "num": "061",
  "scene": "S11",
  "text": "자물쇠는 잠긴 그대로였고요.",
  "sec": 4.011
 },
 {
  "num": "062",
  "scene": "S12",
  "text": "아전이 소리를 질렀어요.",
  "sec": 2.771
 },
 {
  "num": "063",
  "scene": "S12",
  "text": "\"열쇠를 쥔 네가 모르면 누가 안단 말이냐.\"",
  "sec": 5.171
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "노인은 대답을 못 했습니다.",
  "sec": 3.611
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "사실 할 말이 없었어요.",
  "sec": 3.251
 },
 {
  "num": "066",
  "scene": "S12",
  "text": "문은 부서지지 않았고 자물쇠도 멀쩡했거든요.",
  "sec": 6.131
 },
 {
  "num": "067",
  "scene": "S12",
  "text": "그러니 열쇠 가진 사람 말고는 의심할 데가 없었습니다.",
  "sec": 5.611
 },
 {
  "num": "068",
  "scene": "S12",
  "text": "적어도 겉보기에는요.",
  "sec": 3.571
 },
 {
  "num": "069",
  "scene": "S13",
  "text": "고을에 말이 돌았어요.",
  "sec": 3.411
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "창고지기가 늙어서 욕심이 났다고요.",
  "sec": 3.771
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "손자 장가 밑천을 대려 했다는 말까지 나왔습니다.",
  "sec": 4.851
 },
 {
  "num": "072",
  "scene": "S13",
  "text": "그런데 그 노인은 아들도 손자도 없었어요.",
  "sec": 7.411
 },
 {
  "num": "073",
  "scene": "S13",
  "text": "아무도 그건 알아보지 않았지요.",
  "sec": 3.651
 },
 {
  "num": "074",
  "scene": "S13",
  "text": "한번 말이 돌면 그게 사실이 되던 시절입니다.",
  "sec": 4.891
 },
 {
  "num": "075",
  "scene": "S13",
  "text": "없는 집 노인 말을 누가 듣겠습니까.",
  "sec": 3.851
 },
 {
  "num": "076",
  "scene": "S14",
  "text": "사흘 만에 노인이 오라에 묶였습니다.",
  "sec": 4.371
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "곤장을 맞고 옥에 갇혔어요.",
  "sec": 3.811
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "나이가 많아 그대로 두면 죽을 판이었지요.",
  "sec": 5.411
 },
 {
  "num": "079",
  "scene": "S14",
  "text": "그래도 아무도 나서지 않았습니다.",
  "sec": 3.931
 },
 {
  "num": "080",
  "scene": "S14",
  "text": "관아 일에 끼어들어 좋을 게 없으니까요.",
  "sec": 4.171
 },
 {
  "num": "081",
  "scene": "S14",
  "text": "다들 입을 다물고 제 일만 했습니다.",
  "sec": 5.531
 },
 {
  "num": "082",
  "scene": "S15",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 5.691
 },
 {
  "num": "083",
  "scene": "S15",
  "text": "그 벼 백 석이 걸어서 나갔겠습니까.",
  "sec": 4.531
 },
 {
  "num": "084",
  "scene": "S15",
  "text": "누군가는 실어 날랐을 텐데 말이지요.",
  "sec": 4.131
 },
 {
  "num": "085",
  "scene": "S15",
  "text": "그걸 본 사람이 아무도 없었다는 게 이상하지 않습니까.",
  "sec": 6.691
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "그 무렵 만수가 관아 앞을 지나갔어요.",
  "sec": 5.651
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "빈 수레를 끌고 가던 길이었습니다.",
  "sec": 4.411
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "그런데 땅을 보고 걸음이 멎었어요.",
  "sec": 4.571
 },
 {
  "num": "089",
  "scene": "S16",
  "text": "관아 문 앞에 수레 자국이 있었거든요.",
  "sec": 3.851
 },
 {
  "num": "090",
  "scene": "S16",
  "text": "비가 온 지 이틀째라 자국이 또렷했습니다.",
  "sec": 4.891
 },
 {
  "num": "091",
  "scene": "S16",
  "text": "마른 땅이었으면 못 봤을 겁니다.",
  "sec": 4.091
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "만수가 쪼그리고 앉아 자국을 들여다봤습니다.",
  "sec": 5.451
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "나가는 자국과 들어오는 자국이 나란히 있었어요.",
  "sec": 7.011
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "그런데 이상했습니다.",
  "sec": 3.011
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "나가는 자국이 깊고 들어오는 자국이 얕아야 정상이거든요.",
  "sec": 6.771
 },
 {
  "num": "096",
  "scene": "S17",
  "text": "짐을 싣고 나가서 빈 채로 돌아오니까요.",
  "sec": 4.051
 },
 {
  "num": "097",
  "scene": "S17",
  "text": "그게 수레의 이치입니다.",
  "sec": 3.531
 },
 {
  "num": "098",
  "scene": "S17",
  "text": "삼십 년 동안 한 번도 틀린 적이 없는 이치지요.",
  "sec": 5.411
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "그런데 거꾸로였어요.",
  "sec": 3.051
 },
 {
  "num": "100",
  "scene": "S18",
  "text": "나가는 자국이 얕고 들어오는 자국이 깊었습니다.",
  "sec": 6.491
 },
 {
  "num": "101",
  "scene": "S18",
  "text": "빈 수레가 들어왔다가 짐을 싣고 나간 게 아니라요.",
  "sec": 5.291
 },
 {
  "num": "102",
  "scene": "S18",
  "text": "짐 없이 나갔다가 뭔가를 싣고 들어온 겁니다.",
  "sec": 5.211
 },
 {
  "num": "103",
  "scene": "S18",
  "text": "만수는 한참을 그 자리에 앉아 있었어요.",
  "sec": 3.571
 },
 {
  "num": "104",
  "scene": "S18",
  "text": "몇 번이나 자국을 다시 짚어 봤습니다.",
  "sec": 4.251
 },
 {
  "num": "105",
  "scene": "S18",
  "text": "볼수록 분명했어요.",
  "sec": 3.091
 },
 {
  "num": "106",
  "scene": "S19",
  "text": "그게 무슨 뜻인지 만수는 알았어요.",
  "sec": 5.051
 },
 {
  "num": "107",
  "scene": "S19",
  "text": "곡식이 밖으로 나간 게 아니라는 뜻이었습니다.",
  "sec": 5.251
 },
 {
  "num": "108",
  "scene": "S19",
  "text": "관아 안 어딘가로 옮겨졌다는 뜻이었지요.",
  "sec": 5.771
 },
 {
  "num": "109",
  "scene": "S19",
  "text": "그런데 말을 못 했어요.",
  "sec": 3.691
 },
 {
  "num": "110",
  "scene": "S19",
  "text": "수레꾼이 아전을 의심했다가는 그날로 끝이거든요.",
  "sec": 5.691
 },
 {
  "num": "111",
  "scene": "S19",
  "text": "짐을 맡길 사람이 하나도 없어집니다.",
  "sec": 4.851
 },
 {
  "num": "112",
  "scene": "S19",
  "text": "소 한 마리와 수레 한 대가 전 재산인데 말이지요.",
  "sec": 5.251
 },
 {
  "num": "113",
  "scene": "S20",
  "text": "그날 밤 만수가 잠을 못 잤습니다.",
  "sec": 4.371
 },
 {
  "num": "114",
  "scene": "S20",
  "text": "옥에 갇힌 노인이 자꾸 생각났거든요.",
  "sec": 4.691
 },
 {
  "num": "115",
  "scene": "S20",
  "text": "그 노인한테 삯을 받고 짐을 날라 준 적이 여러 번이었어요.",
  "sec": 5.851
 },
 {
  "num": "116",
  "scene": "S20",
  "text": "셈이 틀린 적이 한 번도 없던 사람이었습니다.",
  "sec": 4.851
 },
 {
  "num": "117",
  "scene": "S20",
  "text": "그런 사람이 백 석을 빼돌렸겠습니까.",
  "sec": 4.451
 },
 {
  "num": "118",
  "scene": "S20",
  "text": "게다가 노인 혼자서는 백 석을 옮기지도 못합니다.",
  "sec": 7.051
 },
 {
  "num": "119",
  "scene": "S20",
  "text": "수레가 있어야 하고 사람이 여럿 있어야 하지요.",
  "sec": 5.131
 },
 {
  "num": "120",
  "scene": "S21",
  "text": "이튿날 만수가 그 자국을 따라가 봤어요.",
  "sec": 4.451
 },
 {
  "num": "121",
  "scene": "S21",
  "text": "자국은 관아 담을 따라 뒤쪽으로 돌았습니다.",
  "sec": 5.891
 },
 {
  "num": "122",
  "scene": "S21",
  "text": "그러고는 뒷문으로 들어가 있었어요.",
  "sec": 3.251
 },
 {
  "num": "123",
  "scene": "S21",
  "text": "뒷문은 아전이 드나드는 문이었지요.",
  "sec": 3.891
 },
 {
  "num": "124",
  "scene": "S21",
  "text": "백성은 앞문으로만 드나들던 시절이었어요.",
  "sec": 4.331
 },
 {
  "num": "125",
  "scene": "S21",
  "text": "뒷문으로 수레가 들어갔다는 건 그 자체로 말이 됐습니다.",
  "sec": 5.931
 },
 {
  "num": "126",
  "scene": "S22",
  "text": "자, 여기서 부채 한 번 칩시다. 탁!",
  "sec": 5.851
 },
 {
  "num": "127",
  "scene": "S23",
  "text": "만수가 사또를 뵙겠다고 했어요.",
  "sec": 4.971
 },
 {
  "num": "128",
  "scene": "S23",
  "text": "문지기가 웃었습니다.",
  "sec": 2.891
 },
 {
  "num": "129",
  "scene": "S23",
  "text": "\"수레꾼이 사또를 만나 무엇 하게.\"",
  "sec": 4.251
 },
 {
  "num": "130",
  "scene": "S23",
  "text": "만수가 말했어요.",
  "sec": 2.611
 },
 {
  "num": "131",
  "scene": "S23",
  "text": "\"곡식이 어디로 갔는지 아뢸 것이 있습니다.\"",
  "sec": 4.971
 },
 {
  "num": "132",
  "scene": "S23",
  "text": "문지기가 한참을 망설이다 안에 들였어요.",
  "sec": 5.291
 },
 {
  "num": "133",
  "scene": "S23",
  "text": "만수는 그때까지 관아 문턱을 넘어 본 적이 없었습니다.",
  "sec": 6.451
 },
 {
  "num": "134",
  "scene": "S24",
  "text": "사또 앞에 엎드려 만수가 말했습니다.",
  "sec": 3.891
 },
 {
  "num": "135",
  "scene": "S24",
  "text": "\"사또, 땅을 한 번만 보아 주십시오.\"",
  "sec": 4.411
 },
 {
  "num": "136",
  "scene": "S24",
  "text": "\"관아 문 앞에 수레 자국이 있습니다.\"",
  "sec": 4.051
 },
 {
  "num": "137",
  "scene": "S24",
  "text": "\"나갈 때는 가벼웠고, 들어올 때가 무거웠습니다.\"",
  "sec": 5.571
 },
 {
  "num": "138",
  "scene": "S24",
  "text": "사또가 눈을 들었어요.",
  "sec": 3.331
 },
 {
  "num": "139",
  "scene": "S24",
  "text": "그런 말을 하는 사람은 처음이었거든요.",
  "sec": 3.651
 },
 {
  "num": "140",
  "scene": "S25",
  "text": "사또가 물었어요.",
  "sec": 3.051
 },
 {
  "num": "141",
  "scene": "S25",
  "text": "\"그게 무슨 소리냐.\"",
  "sec": 3.091
 },
 {
  "num": "142",
  "scene": "S25",
  "text": "만수가 대답했습니다.",
  "sec": 2.571
 },
 {
  "num": "143",
  "scene": "S25",
  "text": "\"짐을 실어 나갔으면 나가는 자국이 깊어야 합니다.\"",
  "sec": 5.371
 },
 {
  "num": "144",
  "scene": "S25",
  "text": "\"그런데 들어오는 자국이 깊습니다.\"",
  "sec": 4.051
 },
 {
  "num": "145",
  "scene": "S25",
  "text": "\"바퀴가 땅에 박힌 깊이가 손가락 두 마디는 차이가 납니다.\"",
  "sec": 5.851
 },
 {
  "num": "146",
  "scene": "S25",
  "text": "\"비 온 뒤라 자국이 또렷하니 지금 보시면 압니다.\"",
  "sec": 5.771
 },
 {
  "num": "147",
  "scene": "S26",
  "text": "\"곡식은 밖으로 나가지 않았습니다.\"",
  "sec": 4.691
 },
 {
  "num": "148",
  "scene": "S26",
  "text": "\"수레가 뭔가를 싣고 안으로 들어온 겁니다.\"",
  "sec": 4.971
 },
 {
  "num": "149",
  "scene": "S26",
  "text": "\"소인이 삼십 년을 몰았습니다. 그것만은 압니다.\"",
  "sec": 5.651
 },
 {
  "num": "150",
  "scene": "S26",
  "text": "사또가 한참을 그 자국을 들여다봤어요.",
  "sec": 4.811
 },
 {
  "num": "151",
  "scene": "S26",
  "text": "그러고는 손가락을 자국에 넣어 봤습니다.",
  "sec": 4.051
 },
 {
  "num": "152",
  "scene": "S26",
  "text": "깊이가 달랐어요.",
  "sec": 2.211
 },
 {
  "num": "153",
  "scene": "S27",
  "text": "사또가 관아를 뒤지라 했습니다.",
  "sec": 3.731
 },
 {
  "num": "154",
  "scene": "S27",
  "text": "창고가 아니라 관아 안을 뒤지라고요.",
  "sec": 4.371
 },
 {
  "num": "155",
  "scene": "S27",
  "text": "아전들이 펄쩍 뛰었어요.",
  "sec": 3.451
 },
 {
  "num": "156",
  "scene": "S27",
  "text": "\"수레나 모는 자의 말을 믿으시겠습니까.\"",
  "sec": 4.011
 },
 {
  "num": "157",
  "scene": "S27",
  "text": "사또가 대답했지요. \"믿고 안 믿고는 내가 정한다.\"",
  "sec": 5.531
 },
 {
  "num": "158",
  "scene": "S27",
  "text": "그 말에 아전들이 입을 다물었습니다.",
  "sec": 3.851
 },
 {
  "num": "159",
  "scene": "S27",
  "text": "그런데 한 사람만 얼굴이 하얗게 질렸어요.",
  "sec": 5.211
 },
 {
  "num": "160",
  "scene": "S28",
  "text": "뒷간 옆 헛간에서 나왔습니다.",
  "sec": 4.171
 },
 {
  "num": "161",
  "scene": "S28",
  "text": "멍석을 덮어 쌓아 둔 벼가 백 석이었어요.",
  "sec": 5.171
 },
 {
  "num": "162",
  "scene": "S28",
  "text": "하나도 축나지 않고 그대로였지요.",
  "sec": 5.211
 },
 {
  "num": "163",
  "scene": "S28",
  "text": "아직 내다 팔지 못한 것이었습니다.",
  "sec": 3.851
 },
 {
  "num": "164",
  "scene": "S28",
  "text": "마당에 있던 사람들이 아무 말도 못 했어요.",
  "sec": 4.411
 },
 {
  "num": "165",
  "scene": "S28",
  "text": "창고에서 백 석이 사라진 게 아니라 관아 안에서 자리만 바뀐 겁니다.",
  "sec": 7.851
 },
 {
  "num": "166",
  "scene": "S29",
  "text": "허허, 그래서 누가 그걸 옮겼겠습니까.",
  "sec": 4.171
 },
 {
  "num": "167",
  "scene": "S30",
  "text": "그 아전이었어요.",
  "sec": 2.171
 },
 {
  "num": "168",
  "scene": "S30",
  "text": "환곡을 거둬들이는 일을 맡은 사람이었습니다.",
  "sec": 4.291
 },
 {
  "num": "169",
  "scene": "S30",
  "text": "장부에는 백 석을 도둑맞았다고 적어 놓고요.",
  "sec": 5.651
 },
 {
  "num": "170",
  "scene": "S30",
  "text": "실은 제가 옮겨 두었다가 이듬해 봄에 팔 작정이었지요.",
  "sec": 6.211
 },
 {
  "num": "171",
  "scene": "S30",
  "text": "봄에는 곡식값이 세 배가 되거든요.",
  "sec": 4.011
 },
 {
  "num": "172",
  "scene": "S30",
  "text": "도둑맞았다고 적어 두면 나라에서 메워 줍니다.",
  "sec": 5.411
 },
 {
  "num": "173",
  "scene": "S30",
  "text": "메워 준 곡식도 제 것이 되고요.",
  "sec": 3.691
 },
 {
  "num": "174",
  "scene": "S30",
  "text": "그 수를 쓴 아전이 그 고을에만 있었겠습니까.",
  "sec": 4.971
 },
 {
  "num": "175",
  "scene": "S31",
  "text": "창고지기 노인이 풀려났어요.",
  "sec": 3.491
 },
 {
  "num": "176",
  "scene": "S31",
  "text": "곤장 맞은 자리가 아물지 않아 걷지를 못했습니다.",
  "sec": 5.131
 },
 {
  "num": "177",
  "scene": "S31",
  "text": "사람들이 들것에 실어 집까지 데려다줬지요.",
  "sec": 5.491
 },
 {
  "num": "178",
  "scene": "S31",
  "text": "노인은 아무 말도 하지 않았어요.",
  "sec": 4.251
 },
 {
  "num": "179",
  "scene": "S31",
  "text": "사흘을 앓고 나서야 겨우 입을 열었다고 합니다.",
  "sec": 4.771
 },
 {
  "num": "180",
  "scene": "S31",
  "text": "\"내가 지킨 창고인데 내가 못 지켰구나\" 하더랍니다.",
  "sec": 5.851
 },
 {
  "num": "181",
  "scene": "S32",
  "text": "며칠 뒤 노인이 만수를 찾아왔습니다.",
  "sec": 4.011
 },
 {
  "num": "182",
  "scene": "S32",
  "text": "지팡이를 짚고 걸어왔어요.",
  "sec": 3.371
 },
 {
  "num": "183",
  "scene": "S32",
  "text": "그러고는 만수 앞에 절을 하려 했지요.",
  "sec": 4.251
 },
 {
  "num": "184",
  "scene": "S32",
  "text": "만수가 놀라 말렸습니다.",
  "sec": 3.371
 },
 {
  "num": "185",
  "scene": "S32",
  "text": "\"어르신, 이러지 마십시오.\"",
  "sec": 3.131
 },
 {
  "num": "186",
  "scene": "S32",
  "text": "노인이 만수 손을 잡고 한참을 울었어요.",
  "sec": 5.371
 },
 {
  "num": "187",
  "scene": "S32",
  "text": "옥에서는 한 방울도 안 울던 사람이었습니다.",
  "sec": 3.851
 },
 {
  "num": "188",
  "scene": "S33",
  "text": "관아에서도 사례를 보내왔어요.",
  "sec": 3.331
 },
 {
  "num": "189",
  "scene": "S33",
  "text": "엽전 꾸러미가 제법 묵직했습니다.",
  "sec": 4.371
 },
 {
  "num": "190",
  "scene": "S33",
  "text": "만수가 받지 않았어요.",
  "sec": 3.331
 },
 {
  "num": "191",
  "scene": "S33",
  "text": "\"소인은 땅을 봤을 뿐입니다.\"",
  "sec": 3.891
 },
 {
  "num": "192",
  "scene": "S33",
  "text": "\"자국이 말한 것이지 소인이 말한 게 아닙니다.\"",
  "sec": 3.451
 },
 {
  "num": "193",
  "scene": "S33",
  "text": "\"소인은 그저 삼십 년을 몰았을 뿐입니다.\"",
  "sec": 4.571
 },
 {
  "num": "194",
  "scene": "S33",
  "text": "\"그 삼십 년이 아니었으면 소인도 그냥 지나쳤을 겁니다.\"",
  "sec": 5.931
 },
 {
  "num": "195",
  "scene": "S34",
  "text": "대신 한 가지만 청했어요.",
  "sec": 3.571
 },
 {
  "num": "196",
  "scene": "S34",
  "text": "\"고을 어귀 비탈길에 돌을 좀 깔아 주십시오.\"",
  "sec": 4.731
 },
 {
  "num": "197",
  "scene": "S34",
  "text": "\"비만 오면 바퀴가 빠져 수레가 넘어집니다.\"",
  "sec": 4.451
 },
 {
  "num": "198",
  "scene": "S34",
  "text": "\"거기서 소를 잃은 사람이 올해만 둘입니다.\"",
  "sec": 5.811
 },
 {
  "num": "199",
  "scene": "S34",
  "text": "\"삼십 년을 그 길로 다녔는데 아무도 그걸 묻지 않았습니다.\"",
  "sec": 6.171
 },
 {
  "num": "200",
  "scene": "S34",
  "text": "사또가 그 말에 한참을 말을 못 했어요.",
  "sec": 4.731
 },
 {
  "num": "201",
  "scene": "S34",
  "text": "엽전 꾸러미보다 돌 몇 짐이 어려운 청이 아니었는데 말이지요.",
  "sec": 5.931
 },
 {
  "num": "202",
  "scene": "S35",
  "text": "이듬해 봄에 그 비탈에 돌이 깔렸습니다.",
  "sec": 4.491
 },
 {
  "num": "203",
  "scene": "S35",
  "text": "넓적한 돌을 수레바퀴 너비로 두 줄 놓았어요.",
  "sec": 5.691
 },
 {
  "num": "204",
  "scene": "S35",
  "text": "비가 와도 바퀴가 빠지지 않게요.",
  "sec": 4.011
 },
 {
  "num": "205",
  "scene": "S35",
  "text": "사람들이 그 길을 만수 길이라고 불렀습니다.",
  "sec": 5.251
 },
 {
  "num": "206",
  "scene": "S35",
  "text": "그 뒤로 거기서 수레가 넘어진 적이 없었다고 합니다.",
  "sec": 5.091
 },
 {
  "num": "207",
  "scene": "S36",
  "text": "만수는 예순이 넘도록 수레를 몰았다고 합니다.",
  "sec": 5.371
 },
 {
  "num": "208",
  "scene": "S36",
  "text": "창고지기 노인의 조카뻘 되는 아이가 따라다니며 배웠고요.",
  "sec": 5.411
 },
 {
  "num": "209",
  "scene": "S36",
  "text": "그 아이가 나중에 그 고을 수레꾼이 되었지요.",
  "sec": 5.091
 },
 {
  "num": "210",
  "scene": "S36",
  "text": "만수가 그 아이한테 제일 먼저 가르친 게 땅 보는 법이었답니다.",
  "sec": 6.251
 },
 {
  "num": "211",
  "scene": "S37",
  "text": "그 고을에서는 그 뒤로 이런 말이 돌았답니다.",
  "sec": 4.571
 },
 {
  "num": "212",
  "scene": "S37",
  "text": "\"땅은 거짓말을 안 한다.\"",
  "sec": 2.691
 },
 {
  "num": "213",
  "scene": "S37",
  "text": "수레가 지나간 자리는 지울 수 없다는 뜻이었지요.",
  "sec": 5.571
 },
 {
  "num": "214",
  "scene": "S38",
  "text": "허허, 어떻습니까.",
  "sec": 2.331
 },
 {
  "num": "215",
  "scene": "S38",
  "text": "글 읽는 사람 수십이 못 본 것을, 수레꾼 하나가 땅에서 읽었지요.",
  "sec": 6.971
 },
 {
  "num": "216",
  "scene": "S38",
  "text": "사람이 삼십 년을 한 길만 다니면 그 길이 말을 걸어오는 모양입니다.",
  "sec": 7.771
 },
 {
  "num": "217",
  "scene": "S38",
  "text": "천한 일이라고 하던 그 눈이 말이지요.",
  "sec": 4.251
 },
 {
  "num": "218",
  "scene": "S38",
  "text": "아는 것에 무슨 귀천이 있겠습니까.",
  "sec": 3.971
 },
 {
  "num": "219",
  "scene": "S39",
  "text": "그런데 말이오. 그 아전은 그 뒤로 어찌 되었겠습니까.",
  "sec": 6.571
 },
 {
  "num": "220",
  "scene": "S39",
  "text": "환곡을 만지던 손으로 제 배를 채웠으니 벌이 가볍지 않았다지요. 허허, 그 이야기는 다음에 또 해 드리리다.",
  "sec": 12.051
 },
 {
  "num": "221",
  "scene": "S40",
  "text": "허허, 오늘 이야기는 여기까지올시다.",
  "sec": 5.011
 },
 {
  "num": "222",
  "scene": "S40",
  "text": "다음 이야기가 궁금하시거든, 엽전 대신 구독 한 번 눌러 주시게.",
  "sec": 6.771
 },
 {
  "num": "223",
  "scene": "S40",
  "text": "그럼 편히들 쉬시고, 다음 장날에 또 뵙겠소.",
  "sec": 5.651
 }
]