[
 {
  "num": "001",
  "scene": "S01",
  "text": "온 고을이 사흘째 강을 뒤졌습니다.",
  "sec": 4.771
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "다섯 살 아이가 없어졌거든요.",
  "sec": 2.851
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "그런데 눈먼 악사 하나가 강을 등지고 산으로 올라갔어요.",
  "sec": 9.011
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "\"아이는 강에 없습니다. 산에 있습니다.\"",
  "sec": 5.091
 },
 {
  "num": "005",
  "scene": "S02",
  "text": "눈이 안 보이는 사람이 지팡이로 땅을 두드리고 다녔지요.",
  "sec": 5.891
 },
 {
  "num": "006",
  "scene": "S02",
  "text": "고을 사람들은 그 뒤에서 혀를 찼습니다.",
  "sec": 5.371
 },
 {
  "num": "007",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 6.651
 },
 {
  "num": "008",
  "scene": "S03",
  "text": "오늘도 먼 길 오셨으니, 편히 앉아 들어들 보시게.",
  "sec": 6.251
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 6.011
 },
 {
  "num": "010",
  "scene": "S05",
  "text": "옛날 옛적, 평안도 어느 고을에 명보라는 악사가 있었습니다.",
  "sec": 6.651
 },
 {
  "num": "011",
  "scene": "S05",
  "text": "명보는 다섯 살에 앓다가 눈이 멀었어요.",
  "sec": 4.811
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "그 뒤로 해금을 배웠지요.",
  "sec": 3.091
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "눈먼 사람이 먹고살 길이 그것밖에 없던 시절이었거든요.",
  "sec": 5.651
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "잔칫집에 불려 가 켜고, 초상집에 불려 가 켰습니다.",
  "sec": 5.691
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "그렇게 마흔 해를 살았어요.",
  "sec": 4.811
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "해금은 줄이 둘뿐인데 사람 목소리를 다 냅니다.",
  "sec": 7.211
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "울기도 하고 웃기도 하지요.",
  "sec": 3.171
 },
 {
  "num": "018",
  "scene": "S05",
  "text": "명보는 그 소리로 남의 잔치와 남의 초상을 마흔 해 채웠어요.",
  "sec": 8.171
 },
 {
  "num": "019",
  "scene": "S06",
  "text": "그런데 사람들은 명보를 사람으로 치지 않았어요.",
  "sec": 6.771
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "연주할 때만 부르고, 끝나면 마당 끝으로 물렸지요.",
  "sec": 5.771
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "밥도 따로 내주었고요.",
  "sec": 3.051
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "\"장님\"이라 부르고 이름은 잘 부르지 않았습니다.",
  "sec": 5.571
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "명보는 그런 대접에 익숙했어요.",
  "sec": 4.291
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "다만 켤 때만은 아무도 그를 함부로 하지 못했습니다.",
  "sec": 6.051
 },
 {
  "num": "025",
  "scene": "S06",
  "text": "해금이 울면 마당이 조용해졌거든요.",
  "sec": 4.691
 },
 {
  "num": "026",
  "scene": "S07",
  "text": "명보는 지팡이 하나로 온 고을을 다녔어요.",
  "sec": 5.091
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "눈이 안 보이는데도 남의 도움 없이 다녔지요.",
  "sec": 5.571
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "지팡이로 땅을 두드리면 소리가 돌아오거든요.",
  "sec": 4.371
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "돌담 앞에서는 소리가 튕기고, 논 앞에서는 소리가 퍼집니다.",
  "sec": 6.691
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "명보는 그 돌아오는 소리로 길을 읽었어요.",
  "sec": 4.491
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "마흔 해를 그렇게 다녔으니 고을 땅을 발바닥으로 다 외웠지요.",
  "sec": 7.251
 },
 {
  "num": "032",
  "scene": "S07",
  "text": "어디 돌이 튀어나왔는지, 어디가 패었는지까지요.",
  "sec": 5.491
 },
 {
  "num": "033",
  "scene": "S07",
  "text": "고을 사람들은 그걸 신기해하면서도 대수롭지 않게 여겼습니다.",
  "sec": 6.851
 },
 {
  "num": "034",
  "scene": "S08",
  "text": "명보는 발소리만 듣고 누가 오는지 알았어요.",
  "sec": 5.091
 },
 {
  "num": "035",
  "scene": "S08",
  "text": "\"김 서방이오? 오늘은 짐이 무거우신가 보오.\"",
  "sec": 4.571
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "그러면 사람들이 소스라치게 놀랐지요.",
  "sec": 4.251
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "사람마다 걸음이 다르거든요. 짐을 지면 또 달라지고요.",
  "sec": 5.971
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "눈으로 보는 것보다 귀로 듣는 게 더 정확할 때가 있는 법입니다.",
  "sec": 6.411
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "명보는 목소리도 한 번 들으면 잊지 않았어요.",
  "sec": 5.291
 },
 {
  "num": "040",
  "scene": "S08",
  "text": "십 년 만에 만난 사람도 \"아무개 아니시오\" 하고 맞혔지요.",
  "sec": 6.251
 },
 {
  "num": "041",
  "scene": "S09",
  "text": "명보는 밤길도 무섭지 않았어요.",
  "sec": 4.131
 },
 {
  "num": "042",
  "scene": "S09",
  "text": "어차피 낮이나 밤이나 같았으니까요.",
  "sec": 3.491
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "잔치가 늦게 끝나면 별빛도 없는 길을 혼자 걸어 돌아왔습니다.",
  "sec": 6.891
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "그래서 남들이 자는 시각의 소리를 명보만 들었지요.",
  "sec": 5.851
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "부엉이가 우는 자리, 개울물 소리가 달라지는 자리를 다 알았어요.",
  "sec": 7.451
 },
 {
  "num": "046",
  "scene": "S09",
  "text": "고을이 잠든 뒤의 소리는 명보 차지였습니다.",
  "sec": 4.811
 },
 {
  "num": "047",
  "scene": "S10",
  "text": "그해 여름이었어요.",
  "sec": 2.891
 },
 {
  "num": "048",
  "scene": "S10",
  "text": "고을 아랫마을에 다섯 살짜리 사내아이가 있었습니다.",
  "sec": 6.731
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "이름은 언년이 동생, 그냥 \"막내\"라고들 불렀지요.",
  "sec": 5.931
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "어미가 밭에 간 사이 마당에서 혼자 놀던 아이였어요.",
  "sec": 5.651
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "아비는 일찍 죽고 어미 혼자 키우는 아이였지요.",
  "sec": 4.731
 },
 {
  "num": "052",
  "scene": "S10",
  "text": "말이 늦어 다섯 살인데도 몇 마디밖에 못 했습니다.",
  "sec": 6.051
 },
 {
  "num": "053",
  "scene": "S11",
  "text": "해가 기울어 어미가 돌아왔는데 아이가 없었어요.",
  "sec": 7.291
 },
 {
  "num": "054",
  "scene": "S11",
  "text": "마당에도, 방에도, 뒤란에도 없었습니다.",
  "sec": 5.531
 },
 {
  "num": "055",
  "scene": "S11",
  "text": "어미가 온 동네를 뛰어다니며 아이 이름을 불렀지요.",
  "sec": 5.971
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "그런데 아무 데도 없었어요.",
  "sec": 3.451
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "아이 신발 한 짝이 마당 끝에 놓여 있었습니다.",
  "sec": 6.091
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "그거 하나가 전부였어요.",
  "sec": 3.211
 },
 {
  "num": "059",
  "scene": "S12",
  "text": "그날 밤 온 마을이 횃불을 들고 나섰어요.",
  "sec": 5.331
 },
 {
  "num": "060",
  "scene": "S12",
  "text": "집집마다 뒤지고 뒷산 들머리까지 훑었습니다.",
  "sec": 5.531
 },
 {
  "num": "061",
  "scene": "S12",
  "text": "그래도 아이는 나오지 않았지요.",
  "sec": 3.731
 },
 {
  "num": "062",
  "scene": "S12",
  "text": "날이 밝자 사람들이 강으로 갔어요.",
  "sec": 4.051
 },
 {
  "num": "063",
  "scene": "S12",
  "text": "아이가 없어지면 제일 먼저 물부터 뒤지던 시절이었거든요.",
  "sec": 6.651
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "실제로 그렇게 잃는 아이가 많았고요.",
  "sec": 4.611
 },
 {
  "num": "065",
  "scene": "S13",
  "text": "그 마을 앞으로 강이 하나 흘렀거든요.",
  "sec": 4.931
 },
 {
  "num": "066",
  "scene": "S13",
  "text": "아이가 물에 빠졌으리라는 것이었어요.",
  "sec": 4.291
 },
 {
  "num": "067",
  "scene": "S13",
  "text": "어른들이 물속을 장대로 찔러 가며 훑었습니다.",
  "sec": 5.491
 },
 {
  "num": "068",
  "scene": "S13",
  "text": "하루, 이틀, 사흘이 지났어요.",
  "sec": 4.291
 },
 {
  "num": "069",
  "scene": "S13",
  "text": "그런데 아무것도 나오지 않았습니다.",
  "sec": 4.651
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "아래쪽 여울까지 훑었는데도 빈손이었어요.",
  "sec": 4.931
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "사람들은 오히려 그걸 더 나쁘게 여겼습니다. 멀리 쓸려 갔다고요.",
  "sec": 7.491
 },
 {
  "num": "072",
  "scene": "S14",
  "text": "사흘째 되는 날, 마을 어른들이 말했어요.",
  "sec": 4.811
 },
 {
  "num": "073",
  "scene": "S14",
  "text": "\"이제 그만 찾세. 물에 쓸려 내려갔을 게야.\"",
  "sec": 4.771
 },
 {
  "num": "074",
  "scene": "S14",
  "text": "어미는 강가에 주저앉아 일어나지 못했습니다.",
  "sec": 5.131
 },
 {
  "num": "075",
  "scene": "S14",
  "text": "장례를 치르자는 말까지 나왔어요.",
  "sec": 3.331
 },
 {
  "num": "076",
  "scene": "S14",
  "text": "시신도 없는 장례를요.",
  "sec": 2.811
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "어미는 그 말에 아무 대꾸도 하지 않았어요.",
  "sec": 4.891
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "그저 강물만 보고 앉아 있었습니다.",
  "sec": 3.531
 },
 {
  "num": "079",
  "scene": "S15",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 4.251
 },
 {
  "num": "080",
  "scene": "S15",
  "text": "사람들은 눈에 보이는 데부터 찾지요.",
  "sec": 4.171
 },
 {
  "num": "081",
  "scene": "S15",
  "text": "그런데 그날 밤, 눈이 안 보이는 사람 하나가 뭔가를 들었습니다.",
  "sec": 8.371
 },
 {
  "num": "082",
  "scene": "S16",
  "text": "아이가 없어진 날 밤이었어요.",
  "sec": 3.451
 },
 {
  "num": "083",
  "scene": "S16",
  "text": "명보는 이웃 고을 잔치에서 돌아오던 길이었습니다.",
  "sec": 6.571
 },
 {
  "num": "084",
  "scene": "S16",
  "text": "뒷산 아랫길을 지나는데 걸음이 멎었지요.",
  "sec": 4.691
 },
 {
  "num": "085",
  "scene": "S16",
  "text": "산 쪽에서 아주 가느다란 소리가 났거든요.",
  "sec": 4.851
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "바람 소리도 아니고 짐승 소리도 아니었습니다.",
  "sec": 4.491
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "가늘고 높고, 자꾸 끊기는 소리였어요.",
  "sec": 4.691
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "명보는 지팡이를 들고 한참 서 있었습니다.",
  "sec": 4.691
 },
 {
  "num": "089",
  "scene": "S17",
  "text": "명보는 그 자리에 한참 서 있었어요.",
  "sec": 4.811
 },
 {
  "num": "090",
  "scene": "S17",
  "text": "소리는 끊겼다 이어졌다 했습니다.",
  "sec": 4.771
 },
 {
  "num": "091",
  "scene": "S17",
  "text": "아주 멀고 아주 작았지요.",
  "sec": 4.651
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "땅 밑에서 올라오는 것 같았어요.",
  "sec": 3.811
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "그때는 그게 무슨 소리인지 몰랐습니다.",
  "sec": 4.171
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "잔치에서 술을 한 잔 걸친 뒤라 잘못 들었나 싶기도 했고요.",
  "sec": 4.651
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "그래서 그냥 지나쳤어요. 그게 두고두고 마음에 걸렸습니다.",
  "sec": 6.051
 },
 {
  "num": "096",
  "scene": "S18",
  "text": "그런데 사흘째 되는 날, 아이를 못 찾았다는 말을 들었어요.",
  "sec": 5.811
 },
 {
  "num": "097",
  "scene": "S18",
  "text": "명보는 그 밤 소리가 떠올랐습니다.",
  "sec": 3.691
 },
 {
  "num": "098",
  "scene": "S18",
  "text": "지팡이를 짚고 아이 어미네 마당으로 갔지요.",
  "sec": 4.291
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "그리고 이렇게 말했어요.",
  "sec": 2.531
 },
 {
  "num": "100",
  "scene": "S18",
  "text": "\"아이는 강에 없습니다.\"",
  "sec": 2.891
 },
 {
  "num": "101",
  "scene": "S18",
  "text": "마당에 있던 사람들이 다 돌아봤어요.",
  "sec": 4.051
 },
 {
  "num": "102",
  "scene": "S18",
  "text": "명보가 남의 일에 나선 건 처음이었거든요.",
  "sec": 5.051
 },
 {
  "num": "103",
  "scene": "S19",
  "text": "마당이 조용해졌다가 곧 웅성거렸어요.",
  "sec": 4.651
 },
 {
  "num": "104",
  "scene": "S19",
  "text": "\"그걸 자네가 어찌 아나.\"",
  "sec": 2.971
 },
 {
  "num": "105",
  "scene": "S19",
  "text": "\"장님이 뭘 봤다고 그러는가.\"",
  "sec": 3.691
 },
 {
  "num": "106",
  "scene": "S19",
  "text": "명보가 대답했습니다.",
  "sec": 2.451
 },
 {
  "num": "107",
  "scene": "S19",
  "text": "\"본 게 아니라 들었습니다. 그날 밤 산에서 소리가 났습니다.\"",
  "sec": 6.971
 },
 {
  "num": "108",
  "scene": "S19",
  "text": "\"사람 소리였습니다. 아이 소리요.\"",
  "sec": 4.211
 },
 {
  "num": "109",
  "scene": "S19",
  "text": "\"짐승 소리와 사람 소리는 다릅니다. 소인은 그것만 마흔 해 들었습니다.\"",
  "sec": 8.091
 },
 {
  "num": "110",
  "scene": "S20",
  "text": "사람들은 더 듣지 않았어요.",
  "sec": 3.771
 },
 {
  "num": "111",
  "scene": "S20",
  "text": "\"산짐승 소리였겠지.\"",
  "sec": 2.731
 },
 {
  "num": "112",
  "scene": "S20",
  "text": "\"사흘이 지났는데 산에 있으면 벌써 죽었네.\"",
  "sec": 5.571
 },
 {
  "num": "113",
  "scene": "S20",
  "text": "그러고는 하나둘 흩어졌습니다.",
  "sec": 4.171
 },
 {
  "num": "114",
  "scene": "S20",
  "text": "마당에 어미와 명보만 남았어요.",
  "sec": 4.131
 },
 {
  "num": "115",
  "scene": "S20",
  "text": "해가 기울고 있었습니다.",
  "sec": 3.091
 },
 {
  "num": "116",
  "scene": "S20",
  "text": "그날이 사흘째였으니, 나흘째로 넘어가는 참이었지요.",
  "sec": 5.331
 },
 {
  "num": "117",
  "scene": "S21",
  "text": "어미가 명보의 소매를 붙들었어요.",
  "sec": 3.811
 },
 {
  "num": "118",
  "scene": "S21",
  "text": "\"어디였습니까. 제가 가겠습니다.\"",
  "sec": 3.611
 },
 {
  "num": "119",
  "scene": "S21",
  "text": "\"저 혼자라도 가겠습니다.\"",
  "sec": 3.051
 },
 {
  "num": "120",
  "scene": "S21",
  "text": "명보가 잠깐 가만히 있다가 지팡이를 고쳐 쥐었습니다.",
  "sec": 6.691
 },
 {
  "num": "121",
  "scene": "S21",
  "text": "\"소인이 앞장서지요. 다만 조용히 따라오셔야 합니다.\"",
  "sec": 5.731
 },
 {
  "num": "122",
  "scene": "S21",
  "text": "\"소인은 귀로 길을 찾습니다. 발소리가 크면 못 듣습니다.\"",
  "sec": 6.971
 },
 {
  "num": "123",
  "scene": "S21",
  "text": "어미가 고개를 끄덕였어요.",
  "sec": 3.211
 },
 {
  "num": "124",
  "scene": "S22",
  "text": "그렇게 둘이 뒷산으로 올라갔습니다. 탁!",
  "sec": 4.691
 },
 {
  "num": "125",
  "scene": "S23",
  "text": "명보는 그날 밤 자기가 섰던 자리부터 다시 짚었어요.",
  "sec": 6.811
 },
 {
  "num": "126",
  "scene": "S23",
  "text": "거기서 소리가 난 쪽으로 방향을 잡았지요.",
  "sec": 4.451
 },
 {
  "num": "127",
  "scene": "S23",
  "text": "몇 걸음 가다 멈추고, 또 몇 걸음 가다 멈췄습니다.",
  "sec": 7.531
 },
 {
  "num": "128",
  "scene": "S23",
  "text": "\"조용히 하십시오. 숨도 천천히 쉬십시오.\"",
  "sec": 6.651
 },
 {
  "num": "129",
  "scene": "S23",
  "text": "어미는 숨을 죽이고 따라갔어요.",
  "sec": 4.731
 },
 {
  "num": "130",
  "scene": "S23",
  "text": "산은 이미 어둑해지고 있었습니다.",
  "sec": 4.571
 },
 {
  "num": "131",
  "scene": "S23",
  "text": "어미 눈에는 아무것도 안 보였지만, 명보에게는 어차피 같았지요.",
  "sec": 6.691
 },
 {
  "num": "132",
  "scene": "S24",
  "text": "명보는 지팡이로 땅을 두드리며 나아갔어요.",
  "sec": 4.451
 },
 {
  "num": "133",
  "scene": "S24",
  "text": "\"땅이 꽉 찬 데는 소리가 짧게 끊깁니다.\"",
  "sec": 4.571
 },
 {
  "num": "134",
  "scene": "S24",
  "text": "\"속이 빈 데는 소리가 울려서 길게 남지요.\"",
  "sec": 5.571
 },
 {
  "num": "135",
  "scene": "S24",
  "text": "마흔 해를 그 소리로 길을 찾은 사람이었으니까요.",
  "sec": 5.131
 },
 {
  "num": "136",
  "scene": "S24",
  "text": "한 걸음 한 걸음 두드리며 산허리를 돌았습니다.",
  "sec": 5.371
 },
 {
  "num": "137",
  "scene": "S24",
  "text": "한 시진이 넘게 그러고 다녔어요.",
  "sec": 3.491
 },
 {
  "num": "138",
  "scene": "S24",
  "text": "어미는 몇 번이나 주저앉았다 다시 일어났습니다.",
  "sec": 5.451
 },
 {
  "num": "139",
  "scene": "S25",
  "text": "그러다 명보가 뚝 멈췄어요.",
  "sec": 4.211
 },
 {
  "num": "140",
  "scene": "S25",
  "text": "지팡이를 들어 올린 채 한참 서 있었습니다.",
  "sec": 5.691
 },
 {
  "num": "141",
  "scene": "S25",
  "text": "그 앞은 수풀이 우거진 비탈이었어요.",
  "sec": 4.851
 },
 {
  "num": "142",
  "scene": "S25",
  "text": "겉보기에는 그냥 덤불이었지요.",
  "sec": 4.451
 },
 {
  "num": "143",
  "scene": "S25",
  "text": "명보가 다시 한 번 두드렸습니다.",
  "sec": 3.851
 },
 {
  "num": "144",
  "scene": "S25",
  "text": "북소리처럼 낮고 길게 울렸어요.",
  "sec": 4.811
 },
 {
  "num": "145",
  "scene": "S25",
  "text": "다른 자리와 확실히 달랐습니다.",
  "sec": 3.531
 },
 {
  "num": "146",
  "scene": "S26",
  "text": "\"여깁니다. 여기가 비었습니다.\"",
  "sec": 3.771
 },
 {
  "num": "147",
  "scene": "S26",
  "text": "둘이 손으로 덤불을 걷어 냈어요.",
  "sec": 4.331
 },
 {
  "num": "148",
  "scene": "S26",
  "text": "그 아래 시커먼 구멍이 나왔습니다.",
  "sec": 4.531
 },
 {
  "num": "149",
  "scene": "S26",
  "text": "오래전에 버려진 숯가마 구덩이였어요.",
  "sec": 4.291
 },
 {
  "num": "150",
  "scene": "S26",
  "text": "덤불이 덮여 있어 어른도 모르고 지나치던 자리였지요.",
  "sec": 4.971
 },
 {
  "num": "151",
  "scene": "S26",
  "text": "십 년 전에 숯 굽던 자리라고 했습니다.",
  "sec": 4.371
 },
 {
  "num": "152",
  "scene": "S26",
  "text": "아무도 거기 구덩이가 있는 줄 몰랐어요.",
  "sec": 5.011
 },
 {
  "num": "153",
  "scene": "S27",
  "text": "어미가 구멍에 대고 아이 이름을 불렀어요.",
  "sec": 4.891
 },
 {
  "num": "154",
  "scene": "S27",
  "text": "한 번, 두 번, 세 번.",
  "sec": 4.931
 },
 {
  "num": "155",
  "scene": "S27",
  "text": "아무 소리도 없었습니다.",
  "sec": 3.531
 },
 {
  "num": "156",
  "scene": "S27",
  "text": "어미 얼굴이 하얗게 질렸지요.",
  "sec": 3.971
 },
 {
  "num": "157",
  "scene": "S27",
  "text": "그때 명보가 손을 들어 어미를 조용히 시켰어요.",
  "sec": 5.731
 },
 {
  "num": "158",
  "scene": "S27",
  "text": "\"아주머니, 잠깐만 숨을 멈춰 주십시오.\"",
  "sec": 4.691
 },
 {
  "num": "159",
  "scene": "S27",
  "text": "산이 통째로 조용해졌습니다.",
  "sec": 3.891
 },
 {
  "num": "160",
  "scene": "S28",
  "text": "명보가 구덩이 가장자리에 귀를 붙였습니다.",
  "sec": 5.371
 },
 {
  "num": "161",
  "scene": "S28",
  "text": "한참을 그러고 있었어요.",
  "sec": 2.891
 },
 {
  "num": "162",
  "scene": "S28",
  "text": "그러더니 고개를 들고 말했지요.",
  "sec": 3.691
 },
 {
  "num": "163",
  "scene": "S28",
  "text": "\"숨소리가 납니다. 아직 삽니다.\"",
  "sec": 5.851
 },
 {
  "num": "164",
  "scene": "S28",
  "text": "어미가 그 자리에 무너지듯 주저앉았어요.",
  "sec": 4.331
 },
 {
  "num": "165",
  "scene": "S28",
  "text": "그러고는 곧바로 벌떡 일어나 산을 뛰어 내려갔습니다.",
  "sec": 5.331
 },
 {
  "num": "166",
  "scene": "S29",
  "text": "허허, 그 말에 어미가 어찌 되었겠습니까.",
  "sec": 5.171
 },
 {
  "num": "167",
  "scene": "S29",
  "text": "산에서 내려가는 데 반각도 안 걸렸다지요.",
  "sec": 3.971
 },
 {
  "num": "168",
  "scene": "S30",
  "text": "어미가 마을로 뛰어 내려가 소리를 질렀어요.",
  "sec": 5.011
 },
 {
  "num": "169",
  "scene": "S30",
  "text": "\"찾았습니다! 산입니다! 살아 있답니다!\"",
  "sec": 5.691
 },
 {
  "num": "170",
  "scene": "S30",
  "text": "조금 전까지 혀를 차던 사람들이 밧줄을 들고 뛰었습니다.",
  "sec": 6.091
 },
 {
  "num": "171",
  "scene": "S30",
  "text": "사다리를 지고 올라간 사람도 있었고요.",
  "sec": 4.571
 },
 {
  "num": "172",
  "scene": "S30",
  "text": "조금 전에 \"장님이 뭘 알겠느냐\" 하던 입들이었지요.",
  "sec": 5.731
 },
 {
  "num": "173",
  "scene": "S30",
  "text": "그래도 그때만큼은 아무도 말을 아끼지 않았습니다.",
  "sec": 4.771
 },
 {
  "num": "174",
  "scene": "S31",
  "text": "구덩이는 어른 키 세 배쯤 깊었어요.",
  "sec": 4.331
 },
 {
  "num": "175",
  "scene": "S31",
  "text": "밧줄을 내려 사람이 들어갔지요.",
  "sec": 3.491
 },
 {
  "num": "176",
  "scene": "S31",
  "text": "아이는 구덩이 바닥 한쪽에 웅크리고 있었습니다.",
  "sec": 5.331
 },
 {
  "num": "177",
  "scene": "S31",
  "text": "목이 쉬어 소리도 못 내는 상태였어요.",
  "sec": 4.411
 },
 {
  "num": "178",
  "scene": "S31",
  "text": "사흘 동안 거기 있었던 겁니다.",
  "sec": 3.691
 },
 {
  "num": "179",
  "scene": "S31",
  "text": "구덩이 벽이 미끄러워 기어오를 수가 없었어요.",
  "sec": 4.971
 },
 {
  "num": "180",
  "scene": "S31",
  "text": "소리를 질러도 덤불이 덮여 있어 밖으로 새어 나가지 않았고요.",
  "sec": 6.171
 },
 {
  "num": "181",
  "scene": "S32",
  "text": "아이는 살았어요.",
  "sec": 2.451
 },
 {
  "num": "182",
  "scene": "S32",
  "text": "밤에 이슬이 고인 바위를 핥아 먹고 버텼다고 합니다.",
  "sec": 5.891
 },
 {
  "num": "183",
  "scene": "S32",
  "text": "어미는 아이를 안고 한참을 울었어요.",
  "sec": 4.851
 },
 {
  "num": "184",
  "scene": "S32",
  "text": "마을 사람들도 아무 말을 못 했지요.",
  "sec": 4.091
 },
 {
  "num": "185",
  "scene": "S32",
  "text": "사흘 동안 엉뚱한 데만 뒤졌으니까요.",
  "sec": 4.051
 },
 {
  "num": "186",
  "scene": "S32",
  "text": "강에서 건진 건 아무것도 없었지요.",
  "sec": 3.931
 },
 {
  "num": "187",
  "scene": "S32",
  "text": "아이는 처음부터 산에 있었던 겁니다.",
  "sec": 4.491
 },
 {
  "num": "188",
  "scene": "S33",
  "text": "사람들이 명보 앞에 절을 했어요.",
  "sec": 3.971
 },
 {
  "num": "189",
  "scene": "S33",
  "text": "명보는 손사래를 쳤습니다.",
  "sec": 3.571
 },
 {
  "num": "190",
  "scene": "S33",
  "text": "\"소인은 들은 것을 말했을 뿐입니다.\"",
  "sec": 3.931
 },
 {
  "num": "191",
  "scene": "S33",
  "text": "\"그것도 사흘이나 지나서 말했지요. 그게 내내 마음에 걸립니다.\"",
  "sec": 6.771
 },
 {
  "num": "192",
  "scene": "S33",
  "text": "\"그날 밤에 바로 올라갔더라면 사흘을 덜 굶었을 텐데요.\"",
  "sec": 7.091
 },
 {
  "num": "193",
  "scene": "S33",
  "text": "그 말에 마을 사람들이 고개를 들지 못했습니다.",
  "sec": 4.851
 },
 {
  "num": "194",
  "scene": "S34",
  "text": "고을에서 사례를 모아 왔어요.",
  "sec": 3.171
 },
 {
  "num": "195",
  "scene": "S34",
  "text": "명보는 받지 않았습니다.",
  "sec": 3.691
 },
 {
  "num": "196",
  "scene": "S34",
  "text": "\"소인은 소리를 파는 사람입니다. 소리 값은 잔칫집에서 받지요.\"",
  "sec": 8.331
 },
 {
  "num": "197",
  "scene": "S34",
  "text": "\"오늘 것은 판 게 아니라 들은 겁니다.\"",
  "sec": 4.731
 },
 {
  "num": "198",
  "scene": "S34",
  "text": "대신 명보는 한 가지만 청했어요.",
  "sec": 3.731
 },
 {
  "num": "199",
  "scene": "S34",
  "text": "\"그 구덩이는 메워 주십시오. 다음 아이가 또 빠집니다.\"",
  "sec": 7.851
 },
 {
  "num": "200",
  "scene": "S35",
  "text": "그 뒤로 고을에서는 뭐가 없어지면 명보를 찾았어요.",
  "sec": 6.771
 },
 {
  "num": "201",
  "scene": "S35",
  "text": "소가 없어져도, 아이가 안 보여도요.",
  "sec": 3.971
 },
 {
  "num": "202",
  "scene": "S35",
  "text": "\"명보 어른, 귀 좀 빌려 주십시오\" 하고 말이지요.",
  "sec": 4.651
 },
 {
  "num": "203",
  "scene": "S35",
  "text": "이름을 부르기 시작한 것도 그때부터였습니다.",
  "sec": 4.731
 },
 {
  "num": "204",
  "scene": "S35",
  "text": "전에는 그냥 \"장님\"이었거든요.",
  "sec": 5.571
 },
 {
  "num": "205",
  "scene": "S35",
  "text": "이름으로 불리는 데 마흔 해가 걸린 셈이지요.",
  "sec": 4.331
 },
 {
  "num": "206",
  "scene": "S36",
  "text": "구덩이에서 나온 그 아이는 자라서 명보를 따라다녔어요.",
  "sec": 6.931
 },
 {
  "num": "207",
  "scene": "S36",
  "text": "잔칫집에 갈 때도, 초상집에 갈 때도요.",
  "sec": 5.011
 },
 {
  "num": "208",
  "scene": "S36",
  "text": "명보 손을 잡고 길을 일러 주었지요.",
  "sec": 4.571
 },
 {
  "num": "209",
  "scene": "S36",
  "text": "사람들이 왜 그러느냐 물으면 아이가 이렇게 답했답니다.",
  "sec": 6.011
 },
 {
  "num": "210",
  "scene": "S36",
  "text": "\"이 어른이 제 소리를 들어 주셨으니까요.\"",
  "sec": 3.931
 },
 {
  "num": "211",
  "scene": "S36",
  "text": "온 고을이 못 들은 소리를 한 사람이 들었으니까요.",
  "sec": 4.731
 },
 {
  "num": "212",
  "scene": "S37",
  "text": "명보는 예순이 넘도록 해금을 켰다고 합니다.",
  "sec": 5.251
 },
 {
  "num": "213",
  "scene": "S37",
  "text": "그 아이는 커서 고을 아전이 되었고요.",
  "sec": 4.411
 },
 {
  "num": "214",
  "scene": "S37",
  "text": "아전이 되고 나서도 명보 잔칫날이면 제일 앞자리에 앉았답니다.",
  "sec": 6.731
 },
 {
  "num": "215",
  "scene": "S38",
  "text": "허허, 어떻습니까. 눈 밝은 사람 백 명이 못 찾은 것을, 눈 감은 사람 하나가 찾았지요.",
  "sec": 9.491
 },
 {
  "num": "216",
  "scene": "S38",
  "text": "보이는 데만 찾으면 못 찾는 게 있습니다. 강만 뒤지면 산은 영영 모르지요.",
  "sec": 9.371
 },
 {
  "num": "217",
