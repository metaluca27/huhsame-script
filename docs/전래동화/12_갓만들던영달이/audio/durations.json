[
 {
  "num": "001",
  "scene": "S01",
  "text": "관아 마당에 검은 갓 열 개가 나란히 놓였습니다.",
  "sec": 6.171
 },
 {
  "num": "002",
  "scene": "S01",
  "text": "천한 갓장이가 제 집에서 지고 온 것이었어요.",
  "sec": 5.131
 },
 {
  "num": "003",
  "scene": "S01",
  "text": "그 갓들이 양반 행세하던 사내 하나를 벗겨 냈답니다.",
  "sec": 5.451
 },
 {
  "num": "004",
  "scene": "S01",
  "text": "갓을 만드는 사람은, 갓만 보고도 그 임자를 알았거든요.",
  "sec": 5.491
 },
 {
  "num": "005",
  "scene": "S02",
  "text": "\"이 갓, 안쪽을 좀 보십시오.\"",
  "sec": 4.051
 },
 {
  "num": "006",
  "scene": "S02",
  "text": "평생 갓을 만들기만 하고 한 번도 써 보지 못한 사람이었어요.",
  "sec": 6.371
 },
 {
  "num": "007",
  "scene": "S03",
  "text": "허허, 어서들 오시게. 장터 이야기꾼 허허서방이올시다.",
  "sec": 6.251
 },
 {
  "num": "008",
  "scene": "S03",
  "text": "오늘도 먼 길 오셨으니, 편히 앉아 들어들 보시게.",
  "sec": 6.451
 },
 {
  "num": "009",
  "scene": "S04",
  "text": "자, 그럼 부채 한 번 치고 시작해 봅시다. 탁!",
  "sec": 5.971
 },
 {
  "num": "010",
  "scene": "S05",
  "text": "옛날 옛적, 황해도 어느 고을에 영달이라는 갓장이가 있었습니다.",
  "sec": 7.291
 },
 {
  "num": "011",
  "scene": "S05",
  "text": "갓장이란 양반이 머리에 쓰는 갓을 만드는 사람이었지요.",
  "sec": 5.571
 },
 {
  "num": "012",
  "scene": "S05",
  "text": "갓은 말총으로 만듭니다. 말 꼬리털 말이에요.",
  "sec": 5.211
 },
 {
  "num": "013",
  "scene": "S05",
  "text": "그 가는 털을 한 올 한 올 엮어 모자를 짰어요.",
  "sec": 5.971
 },
 {
  "num": "014",
  "scene": "S05",
  "text": "갓 하나에 석 달이 걸렸습니다.",
  "sec": 3.811
 },
 {
  "num": "015",
  "scene": "S05",
  "text": "말총 한 올이 머리카락보다 가늘었어요.",
  "sec": 4.171
 },
 {
  "num": "016",
  "scene": "S05",
  "text": "그걸 이천 올쯤 엮어야 모자 하나가 됐습니다.",
  "sec": 5.451
 },
 {
  "num": "017",
  "scene": "S05",
  "text": "눈이 빠지는 일이라 갓장이는 마흔만 넘으면 눈이 어두워졌지요.",
  "sec": 6.891
 },
 {
  "num": "018",
  "scene": "S06",
  "text": "모자를 짜고 나면 양태를 짭니다. 갓의 넓은 챙이지요.",
  "sec": 6.251
 },
 {
  "num": "019",
  "scene": "S06",
  "text": "대나무를 머리카락처럼 가늘게 쪼개서 엮었어요.",
  "sec": 4.771
 },
 {
  "num": "020",
  "scene": "S06",
  "text": "그걸 다 짜면 옻칠을 여러 번 올립니다.",
  "sec": 5.891
 },
 {
  "num": "021",
  "scene": "S06",
  "text": "그래야 비를 맞아도 무너지지 않았거든요.",
  "sec": 4.171
 },
 {
  "num": "022",
  "scene": "S06",
  "text": "영달이는 그 일을 스물다섯 해 했습니다.",
  "sec": 5.091
 },
 {
  "num": "023",
  "scene": "S06",
  "text": "열여섯에 아비한테 배워 시작한 일이었어요.",
  "sec": 4.611
 },
 {
  "num": "024",
  "scene": "S06",
  "text": "아비도 갓장이였고, 그 아비의 아비도 갓장이였습니다.",
  "sec": 6.251
 },
 {
  "num": "025",
  "scene": "S07",
  "text": "그런데 영달이는 정작 갓을 쓸 수 없었어요.",
  "sec": 5.291
 },
 {
  "num": "026",
  "scene": "S07",
  "text": "갓일은 천한 일로 치던 시절이었거든요.",
  "sec": 4.611
 },
 {
  "num": "027",
  "scene": "S07",
  "text": "양반 머리에 얹힐 것을 만들면서, 제 머리는 늘 맨머리였습니다.",
  "sec": 6.811
 },
 {
  "num": "028",
  "scene": "S07",
  "text": "수건 하나 질끈 동여매고 앉아 갓을 짰지요.",
  "sec": 5.691
 },
 {
  "num": "029",
  "scene": "S07",
  "text": "영달이는 그걸 서운해하지 않았어요. 손이 바쁘면 그만이었으니까요.",
  "sec": 6.851
 },
 {
  "num": "030",
  "scene": "S07",
  "text": "다만 완성한 갓을 건네줄 때는 늘 두 손으로 받쳐 들었습니다.",
  "sec": 7.491
 },
 {
  "num": "031",
  "scene": "S07",
  "text": "제 손을 떠나는 마지막 순간이었으니까요.",
  "sec": 4.171
 },
 {
  "num": "032",
  "scene": "S08",
  "text": "영달이한테는 버릇이 하나 있었습니다.",
  "sec": 4.171
 },
 {
  "num": "033",
  "scene": "S08",
  "text": "갓을 다 만들면 안쪽에 표시를 하나 남겼어요.",
  "sec": 5.931
 },
 {
  "num": "034",
  "scene": "S08",
  "text": "말총 세 올을 일부러 반대로 엮어 두는 것이었지요.",
  "sec": 5.331
 },
 {
  "num": "035",
  "scene": "S08",
  "text": "겉에서는 절대 안 보이고, 뒤집어야 보였습니다.",
  "sec": 5.651
 },
 {
  "num": "036",
  "scene": "S08",
  "text": "왜 그러느냐 물으면 이렇게 답했어요.",
  "sec": 4.931
 },
 {
  "num": "037",
  "scene": "S08",
  "text": "\"내 손에서 나간 것은 내가 알아야지요.\"",
  "sec": 4.651
 },
 {
  "num": "038",
  "scene": "S08",
  "text": "갓이 비를 맞아 망가지면 고쳐 달라고 다시 들고 오는 사람이 많았거든요.",
  "sec": 7.251
 },
 {
  "num": "039",
  "scene": "S08",
  "text": "그때 뒤집어 보면 제 것인지 아닌지 대번에 알았습니다.",
  "sec": 5.691
 },
 {
  "num": "040",
  "scene": "S09",
  "text": "그 시절 갓은 그냥 모자가 아니었어요.",
  "sec": 4.771
 },
 {
  "num": "041",
  "scene": "S09",
  "text": "갓을 썼느냐 안 썼느냐로 사람 값이 갈렸습니다.",
  "sec": 5.571
 },
 {
  "num": "042",
  "scene": "S09",
  "text": "양태가 넓을수록 높은 자리였고요.",
  "sec": 4.611
 },
 {
  "num": "043",
  "scene": "S09",
  "text": "그러니 갓은 머리에 얹은 신분이었던 겁니다.",
  "sec": 5.291
 },
 {
  "num": "044",
  "scene": "S09",
  "text": "천민은 갓을 쓰면 매를 맞았어요.",
  "sec": 4.971
 },
 {
  "num": "045",
  "scene": "S09",
  "text": "그래서 갓 하나로 사람을 속이는 일도 종종 있었지요.",
  "sec": 5.211
 },
 {
  "num": "046",
  "scene": "S10",
  "text": "영달이 갓은 고을에서 값을 제일 잘 받았어요.",
  "sec": 5.491
 },
 {
  "num": "047",
  "scene": "S10",
  "text": "쓰고 삼 년을 다녀도 양태가 처지지 않았거든요.",
  "sec": 5.171
 },
 {
  "num": "048",
  "scene": "S10",
  "text": "이웃 고을 양반들도 사람을 보내 맞춰 갔습니다.",
  "sec": 4.451
 },
 {
  "num": "049",
  "scene": "S10",
  "text": "석 달을 기다려야 하는데도 그랬어요.",
  "sec": 4.371
 },
 {
  "num": "050",
  "scene": "S10",
  "text": "\"영달이 갓은 비 맞고도 안 처진다\"는 말이 돌았거든요.",
  "sec": 5.171
 },
 {
  "num": "051",
  "scene": "S10",
  "text": "그래도 영달이 살림은 늘 빠듯했습니다. 값을 후하게 부르지 못하는 성미였어요.",
  "sec": 10.011
 },
 {
  "num": "052",
  "scene": "S11",
  "text": "삼 년 전 일이었습니다.",
  "sec": 2.371
 },
 {
  "num": "053",
  "scene": "S11",
  "text": "이웃 고을 김 진사가 영달이한테 갓을 맞추러 왔어요.",
  "sec": 5.891
 },
 {
  "num": "054",
  "scene": "S11",
  "text": "김 진사는 머리가 유난히 작은 사람이었지요.",
  "sec": 4.571
 },
 {
  "num": "055",
  "scene": "S11",
  "text": "그래서 총모자를 좁게, 양태는 조금 넓게 잡았습니다.",
  "sec": 6.931
 },
 {
  "num": "056",
  "scene": "S11",
  "text": "그 한 사람에게만 맞는 갓이 된 거예요.",
  "sec": 3.771
 },
 {
  "num": "057",
  "scene": "S11",
  "text": "영달이는 그 갓 안에도 말총 세 올을 거꾸로 엮어 두었고요.",
  "sec": 7.571
 },
 {
  "num": "058",
  "scene": "S11",
  "text": "김 진사는 갓을 받아 쓰고 한참을 거울 앞에 서 있었다고 해요.",
  "sec": 6.651
 },
 {
  "num": "059",
  "scene": "S11",
  "text": "\"내 평생 이만한 갓은 처음일세.\" 하고요.",
  "sec": 5.331
 },
 {
  "num": "060",
  "scene": "S12",
  "text": "그러던 어느 봄, 고을에 낯선 양반 하나가 들어왔어요.",
  "sec": 6.691
 },
 {
  "num": "061",
  "scene": "S12",
  "text": "조 생원이라 했습니다.",
  "sec": 2.891
 },
 {
  "num": "062",
  "scene": "S12",
  "text": "한양에서 내려왔다고 했지요.",
  "sec": 3.011
 },
 {
  "num": "063",
  "scene": "S12",
  "text": "비단 두루마기에 갓이 번듯해서 누구도 의심하지 않았습니다.",
  "sec": 7.491
 },
 {
  "num": "064",
  "scene": "S12",
  "text": "말씨도 한양 말씨였고, 글도 제법 읽었지요.",
  "sec": 5.891
 },
 {
  "num": "065",
  "scene": "S12",
  "text": "고을 사람들은 귀한 손님이 왔다며 반겼습니다.",
  "sec": 5.531
 },
 {
  "num": "066",
  "scene": "S13",
  "text": "조 생원은 말솜씨가 좋았어요.",
  "sec": 3.531
 },
 {
  "num": "067",
  "scene": "S13",
  "text": "한양 이야기를 풀어놓으면 밤이 가는 줄 몰랐지요.",
  "sec": 6.011
 },
 {
  "num": "068",
  "scene": "S13",
  "text": "고을 유지 홍 참봉네 사랑방이 매일 꽉 찼습니다.",
  "sec": 5.691
 },
 {
  "num": "069",
  "scene": "S13",
  "text": "그러다 슬그머니 이런 말이 나왔어요.",
  "sec": 4.291
 },
 {
  "num": "070",
  "scene": "S13",
  "text": "처음엔 그냥 지나가는 말처럼 흘렸습니다.",
  "sec": 4.491
 },
 {
  "num": "071",
  "scene": "S13",
  "text": "그런데 그 말이 사람들 귀에 오래 남았어요.",
  "sec": 5.131
 },
 {
  "num": "072",
  "scene": "S14",
  "text": "\"내 한양에 아는 이가 많으니, 자제분 자리 하나쯤은 어렵지 않소.\"",
  "sec": 7.131
 },
 {
  "num": "073",
  "scene": "S14",
  "text": "그 시절엔 돈으로 벼슬을 사는 일이 실제로 있었거든요.",
  "sec": 5.291
 },
 {
  "num": "074",
  "scene": "S14",
  "text": "고을 사람들이 앞다투어 돈을 내놓았습니다.",
  "sec": 5.331
 },
 {
  "num": "075",
  "scene": "S14",
  "text": "논을 팔고 소를 판 집도 있었어요.",
  "sec": 4.291
 },
 {
  "num": "076",
  "scene": "S14",
  "text": "모인 돈이 삼백 냥이 넘었다고 합니다.",
  "sec": 4.691
 },
 {
  "num": "077",
  "scene": "S14",
  "text": "소 한 마리가 스무 냥 하던 시절이었어요.",
  "sec": 5.291
 },
 {
  "num": "078",
  "scene": "S14",
  "text": "고을 살림이 통째로 그 사랑방에 들어간 셈이었지요.",
  "sec": 5.811
 },
 {
  "num": "079",
  "scene": "S15",
  "text": "그 조 생원이 장날에 장터를 지나갔어요.",
  "sec": 5.891
 },
 {
  "num": "080",
  "scene": "S15",
  "text": "영달이가 마침 갓을 펴 놓고 앉아 있었지요.",
  "sec": 5.091
 },
 {
  "num": "081",
  "scene": "S15",
  "text": "고개를 들었다가 영달이 손이 멈췄습니다.",
  "sec": 4.891
 },
 {
  "num": "082",
  "scene": "S15",
  "text": "조 생원이 쓴 갓을 한참 올려다보았어요.",
  "sec": 5.011
 },
 {
  "num": "083",
  "scene": "S15",
  "text": "손에 들고 있던 대오리를 놓친 줄도 몰랐습니다.",
  "sec": 4.971
 },
 {
  "num": "084",
  "scene": "S16",
  "text": "그 갓은 영달이가 만든 것이었습니다.",
  "sec": 4.371
 },
 {
  "num": "085",
  "scene": "S16",
  "text": "스물다섯 해 갓을 짠 사람은 제 물건을 압니다.",
  "sec": 6.411
 },
 {
  "num": "086",
  "scene": "S16",
  "text": "양태 끝을 마무리한 결이 제 손버릇이었거든요.",
  "sec": 5.731
 },
 {
  "num": "087",
  "scene": "S16",
  "text": "그런데 그게 문제가 아니었어요.",
  "sec": 4.011
 },
 {
  "num": "088",
  "scene": "S16",
  "text": "그 갓은 삼 년 전 김 진사한테 맞춰 준 바로 그 갓이었습니다.",
  "sec": 6.931
 },
 {
  "num": "089",
  "scene": "S16",
  "text": "양태 끝이 미세하게 위로 말린 것까지 똑같았어요.",
  "sec": 6.611
 },
 {
  "num": "090",
  "scene": "S16",
  "text": "그건 그해 여름에만 나오던 영달이 버릇이었거든요.",
  "sec": 4.451
 },
 {
  "num": "091",
  "scene": "S17",
  "text": "게다가 그 갓이 조 생원 머리에는 맞지 않았어요.",
  "sec": 5.771
 },
 {
  "num": "092",
  "scene": "S17",
  "text": "김 진사는 머리가 작은 사람이었으니까요.",
  "sec": 4.051
 },
 {
  "num": "093",
  "scene": "S17",
  "text": "조 생원은 걸을 때마다 갓을 고쳐 썼습니다.",
  "sec": 5.731
 },
 {
  "num": "094",
  "scene": "S17",
  "text": "자꾸 앞으로 흘러내렸거든요.",
  "sec": 3.651
 },
 {
  "num": "095",
  "scene": "S17",
  "text": "영달이 눈에는 그게 훤히 보였지요.",
  "sec": 4.611
 },
 {
  "num": "096",
  "scene": "S17",
  "text": "갓이 맞는 사람은 하루 종일 손이 안 올라갑니다.",
  "sec": 5.851
 },
 {
  "num": "097",
  "scene": "S17",
  "text": "맞지 않는 사람은 열 걸음에 한 번씩 손이 올라가지요.",
  "sec": 5.651
 },
 {
  "num": "098",
  "scene": "S18",
  "text": "허허, 여기서 잠깐 뜸을 들여 봅시다.",
  "sec": 4.171
 },
 {
  "num": "099",
  "scene": "S18",
  "text": "남의 갓을 쓰면 표가 납니다. 머리가 다르니까요.",
  "sec": 5.571
 },
 {
  "num": "100",
  "scene": "S18",
  "text": "다만 그걸 알아보는 사람이 하나뿐이었지요.",
  "sec": 4.251
 },
 {
  "num": "101",
  "scene": "S19",
  "text": "영달이는 그날로 이웃 고을 사정을 알아봤어요.",
  "sec": 5.771
 },
 {
  "num": "102",
  "scene": "S19",
  "text": "김 진사는 작년 가을에 세상을 떴다고 했습니다.",
  "sec": 5.211
 },
 {
  "num": "103",
  "scene": "S19",
  "text": "자식이 없어 종들이 뿔뿔이 흩어졌고요.",
  "sec": 5.331
 },
 {
  "num": "104",
  "scene": "S19",
  "text": "그 집 물건도 이것저것 없어졌다더군요.",
  "sec": 4.331
 },
 {
  "num": "105",
  "scene": "S19",
  "text": "영달이 등에 소름이 돋았습니다.",
  "sec": 3.651
 },
 {
  "num": "106",
  "scene": "S19",
  "text": "죽은 사람 갓을 쓰고 다니는 사람이 고을 돈을 걷고 있었으니까요.",
  "sec": 7.171
 },
 {
  "num": "107",
  "scene": "S19",
  "text": "그날 밤 영달이는 한숨도 못 잤습니다.",
  "sec": 5.691
 },
 {
  "num": "108",
  "scene": "S20",
  "text": "영달이는 관아로 갔어요.",
  "sec": 2.851
 },
 {
  "num": "109",
  "scene": "S20",
  "text": "\"저 조 생원이라는 사람, 양반이 아닙니다.\"",
  "sec": 4.971
 },
 {
  "num": "110",
  "scene": "S20",
  "text": "\"저 사람이 쓴 것은 죽은 김 진사 갓입니다. 소인이 만들었습니다.\"",
  "sec": 6.651
 },
 {
  "num": "111",
  "scene": "S20",
  "text": "아전이 영달이를 위아래로 훑어보았지요.",
  "sec": 3.371
 },
 {
  "num": "112",
  "scene": "S20",
  "text": "맨머리에 수건을 동인 사내였어요.",
  "sec": 4.691
 },
 {
  "num": "113",
  "scene": "S20",
  "text": "손에는 옻이 묻어 검었고요.",
  "sec": 4.811
 },
 {
  "num": "114",
  "scene": "S21",
  "text": "\"갓장이가 갓을 알아본다고?\"",
  "sec": 2.971
 },
 {
  "num": "115",
  "scene": "S21",
  "text": "\"검은 갓이 다 거기서 거기지 무슨 수로 안다는 게냐.\"",
  "sec": 6.331
 },
 {
  "num": "116",
  "scene": "S21",
  "text": "\"천한 것이 양반을 모함하면 어찌 되는지 아느냐.\"",
  "sec": 6.691
 },
 {
  "num": "117",
  "scene": "S21",
  "text": "영달이는 물러서지 않았어요.",
  "sec": 3.451
 },
 {
  "num": "118",
  "scene": "S21",
  "text": "\"뒤집어 보면 압니다. 안에 표시가 있습니다.\"",
  "sec": 5.771
 },
 {
  "num": "119",
  "scene": "S21",
  "text": "\"제가 만든 갓은 제가 압니다. 스물다섯 해를 만들었습니다.\"",
  "sec": 6.491
 },
 {
  "num": "120",
  "scene": "S21",
  "text": "그래도 아전은 코웃음만 쳤어요.",
  "sec": 3.651
 },
 {
  "num": "121",
  "scene": "S22",
  "text": "돌아온 것은 매였습니다.",
  "sec": 3.411
 },
 {
  "num": "122",
  "scene": "S22",
  "text": "영달이는 곤장 열 대를 맞고 관아 밖으로 내쫓겼어요.",
  "sec": 6.931
 },
 {
  "num": "123",
  "scene": "S22",
  "text": "소문이 고을에 퍼졌지요.",
  "sec": 3.251
 },
 {
  "num": "124",
  "scene": "S22",
  "text": "\"갓장이가 미쳤다더라.\"",
  "sec": 2.731
 },
 {
  "num": "125",
  "scene": "S22",
  "text": "그런데 영달이는 그날 밤 잠을 자지 않았습니다.",
  "sec": 5.171
 },
 {
  "num": "126",
  "scene": "S22",
  "text": "등이 터져 엎드려 있으면서도 생각만 했지요.",
  "sec": 5.611
 },
 {
  "num": "127",
  "scene": "S22",
  "text": "말로는 안 된다면 눈으로 보여 주는 수밖에 없었으니까요.",
  "sec": 5.411
 },
 {
  "num": "128",
  "scene": "S23",
  "text": "이튿날 아침, 영달이가 지게를 지고 관아로 갔습니다. 탁!",
  "sec": 8.331
 },
 {
  "num": "129",
  "scene": "S24",
  "text": "지게에는 갓이 열 개 실려 있었어요.",
  "sec": 4.251
 },
 {
  "num": "130",
  "scene": "S24",
  "text": "제 집에 남아 있던 갓을 다 지고 온 것이었습니다.",
  "sec": 4.811
 },
 {
  "num": "131",
  "scene": "S24",
  "text": "관아 마당에 그걸 하나씩 내려놓았지요.",
  "sec": 4.331
 },
 {
  "num": "132",
  "scene": "S24",
  "text": "구경꾼이 담 밖까지 찼습니다.",
  "sec": 3.491
 },
 {
  "num": "133",
  "scene": "S24",
  "text": "조 생원도 불려 나왔고요.",
  "sec": 2.971
 },
 {
  "num": "134",
  "scene": "S24",
  "text": "\"천한 것이 또 무슨 수작인가.\" 하며 웃었습니다.",
  "sec": 5.491
 },
 {
  "num": "135",
  "scene": "S24",
  "text": "그 웃음이 그날의 마지막 웃음이었지요.",
  "sec": 4.251
 },
 {
  "num": "136",
  "scene": "S25",
  "text": "영달이는 갓 열 개를 멍석 위에 늘어놓았어요.",
  "sec": 5.771
 },
 {
  "num": "137",
  "scene": "S25",
  "text": "그리고 사또를 향해 말했습니다.",
  "sec": 4.291
 },
 {
  "num": "138",
  "scene": "S25",
  "text": "\"이 열 개는 모두 소인이 만든 것입니다.\"",
  "sec": 4.611
 },
 {
  "num": "139",
  "scene": "S25",
  "text": "\"하나씩 뒤집어 보시지요.\"",
  "sec": 3.011
 },
 {
  "num": "140",
  "scene": "S25",
  "text": "사또가 아전에게 눈짓을 했어요.",
  "sec": 4.091
 },
 {
  "num": "141",
  "scene": "S25",
  "text": "아전이 마지못해 갓 하나를 집어 들었습니다.",
  "sec": 4.611
 },
 {
  "num": "142",
  "scene": "S26",
  "text": "영달이가 갓 하나를 뒤집었어요.",
  "sec": 4.331
 },
 {
  "num": "143",
  "scene": "S26",
  "text": "총모자 안쪽을 손가락으로 짚었습니다.",
  "sec": 4.171
 },
 {
  "num": "144",
  "scene": "S26",
  "text": "\"여기 말총 세 올이 거꾸로 엮여 있습니다.\"",
  "sec": 4.851
 },
 {
  "num": "145",
  "scene": "S26",
  "text": "\"이건 제 버릇입니다. 남이 흉내 낼 수 없어요.\"",
  "sec": 5.611
 },
 {
  "num": "146",
  "scene": "S26",
  "text": "열 개를 다 뒤집었는데 열 개가 다 같았습니다.",
  "sec": 5.651
 },
 {
  "num": "147",
  "scene": "S26",
  "text": "마당에 있던 사람들이 하나씩 들여다보고 고개를 끄덕였어요.",
  "sec": 5.611
 },
 {
  "num": "148",
  "scene": "S26",
  "text": "\"과연 똑같구먼.\" 하는 소리가 여기저기서 났습니다.",
  "sec": 6.371
 },
 {
  "num": "149",
  "scene": "S27",
  "text": "사또가 조 생원의 갓을 벗기게 했어요.",
  "sec": 4.451
 },
 {
  "num": "150",
  "scene": "S27",
  "text": "마당이 조용해졌습니다.",
  "sec": 3.091
 },
 {
  "num": "151",
  "scene": "S27",
  "text": "영달이가 그 갓을 받아 뒤집었지요.",
  "sec": 5.091
 },
 {
  "num": "152",
  "scene": "S27",
  "text": "말총 세 올이 거꾸로 엮여 있었습니다.",
  "sec": 4.171
 },
 {
  "num": "153",
  "scene": "S27",
  "text": "영달이가 그 자리를 손가락으로 짚어 보였어요.",
  "sec": 5.371
 },
 {
  "num": "154",
  "scene": "S27",
  "text": "사또가 허리를 굽혀 한참을 들여다봤습니다.",
  "sec": 5.691
 },
 {
  "num": "155",
  "scene": "S28",
  "text": "영달이가 제 갓 하나와 조 생원 갓을 나란히 들었어요.",
  "sec": 6.011
 },
 {
  "num": "156",
  "scene": "S28",
  "text": "안쪽 표시가 똑같았습니다.",
  "sec": 4.051
 },
 {
  "num": "157",
  "scene": "S28",
  "text": "\"이 갓은 삼 년 전 김 진사 어른께 맞춰 드린 것입니다.\"",
  "sec": 5.931
 },
 {
  "num": "158",
  "scene": "S28",
  "text": "\"머리가 작으셔서 총모자를 좁게 잡았지요.\"",
  "sec": 5.731
 },
 {
  "num": "159",
  "scene": "S28",
  "text": "\"그래서 저 어른 머리에는 자꾸 흘러내리는 겁니다.\"",
  "sec": 5.251
 },
 {
  "num": "160",
  "scene": "S28",
  "text": "\"갓이란 머리에 맞춰 짓는 물건입니다. 옷보다 더 맞춰 짓지요.\"",
  "sec": 7.331
 },
 {
  "num": "161",
  "scene": "S28",
  "text": "\"남의 갓은 쓰면 압니다.\"",
  "sec": 3.411
 },
 {
  "num": "162",
  "scene": "S29",
  "text": "조 생원은 아무 말도 하지 못했어요.",
  "sec": 4.571
 },
 {
  "num": "163",
  "scene": "S29",
  "text": "그제야 사람들이 웅성거리기 시작했습니다.",
  "sec": 4.651
 },
 {
  "num": "164",
  "scene": "S29",
  "text": "\"저 갓이 자꾸 흘러내리는 건 나도 봤네.\"",
  "sec": 4.451
 },
 {
  "num": "165",
  "scene": "S29",
  "text": "\"머리에 안 맞는 갓을 왜 쓰고 다니나 했지.\"",
  "sec": 4.651
 },
 {
  "num": "166",
  "scene": "S29",
  "text": "한번 터진 말은 걷잡을 수 없었어요.",
  "sec": 4.291
 },
 {
  "num": "167",
  "scene": "S29",
  "text": "그동안 이상했던 것들이 하나씩 튀어나왔습니다.",
  "sec": 5.051
 },
 {
  "num": "168",
  "scene": "S30",
  "text": "사또가 이웃 고을에 사람을 보냈어요.",
  "sec": 4.211
 },
 {
  "num": "169",
  "scene": "S30",
  "text": "저녁이 되기 전에 김 진사네 늙은 종이 왔습니다.",
  "sec": 5.091
 },
 {
  "num": "170",
  "scene": "S30",
  "text": "종은 조 생원을 보자마자 손가락질을 했어요.",
  "sec": 4.931
 },
 {
  "num": "171",
  "scene": "S30",
  "text": "\"저 사람은 우리 댁에서 문간을 지키던 자입니다.\"",
  "sec": 5.571
 },
 {
  "num": "172",
  "scene": "S30",
  "text": "\"진사 어른 돌아가신 뒤로 보이지 않더니…\"",
  "sec": 4.651
 },
 {
  "num": "173",
  "scene": "S30",
  "text": "늙은 종이 말끝을 흐리며 주저앉았어요.",
  "sec": 6.251
 },
 {
  "num": "174",
  "scene": "S30",
  "text": "그 한마디로 다 끝난 것이었습니다.",
  "sec": 3.971
 },
 {
  "num": "175",
  "scene": "S31",
  "text": "허허, 이제 다 드러났지요.",
  "sec": 4.371
 },
 {
  "num": "176",
  "scene": "S31",
  "text": "그런데 이 이야기는 여기서 한 걸음이 더 있습니다.",
  "sec": 5.971
 },
 {
  "num": "177",
  "scene": "S32",
  "text": "조 생원은 그 자리에서 오라에 묶였어요.",
  "sec": 4.331
 },
 {
  "num": "178",
  "scene": "S32",
  "text": "죽은 주인의 호패와 갓을 훔쳐 양반 행세를 한 것이었습니다.",
  "sec": 7.251
 },
 {
  "num": "179",
  "scene": "S32",
  "text": "삼백 냥은 그대로 나왔지요. 아직 쓰지 못했거든요.",
  "sec": 6.451
 },
 {
  "num": "180",
  "scene": "S32",
  "text": "논 판 사람, 소 판 사람이 제 돈을 도로 찾았습니다.",
  "sec": 6.491
 },
 {
  "num": "181",
  "scene": "S32",
  "text": "돈을 받아 든 사람들이 영달이 쪽을 돌아봤어요.",
  "sec": 4.771
 },
 {
  "num": "182",
  "scene": "S32",
  "text": "그런데 영달이는 벌써 갓을 챙겨 지게에 싣고 있었습니다.",
  "sec": 7.371
 },
 {
  "num": "183",
  "scene": "S33",
  "text": "사또가 영달이를 불렀어요.",
  "sec": 3.691
 },
 {
  "num": "184",
  "scene": "S33",
  "text": "\"네 덕에 고을이 삼백 냥을 지켰다. 무엇을 주면 좋겠느냐.\"",
  "sec": 6.611
 },
 {
  "num": "185",
  "scene": "S33",
  "text": "영달이는 한참을 가만히 있었습니다.",
  "sec": 4.331
 },
 {
  "num": "186",
  "scene": "S33",
  "text": "쌀도 엽전도 말하지 않았어요.",
  "sec": 3.851
 },
 {
  "num": "187",
  "scene": "S33",
  "text": "평생 무엇을 달라고 해 본 적이 없는 사람이었거든요.",
  "sec": 5.211
 },
 {
  "num": "188",
  "scene": "S33",
  "text": "한참 뒤에야 조심스럽게 입을 열었습니다.",
  "sec": 5.491
 },
 {
  "num": "189",
  "scene": "S34",
  "text": "\"소인이 만든 갓, 그 안쪽에 이름을 새기게 해 주십시오.\"",
  "sec": 5.571
 },
 {
  "num": "190",
  "scene": "S34",
  "text": "\"천한 것이 이름을 남기면 안 된다 하시면 그만두겠습니다.\"",
  "sec": 6.411
 },
 {
  "num": "191",
  "scene": "S34",
  "text": "\"다만 이번 일 같은 것이 또 있으면, 이름이 있어야 밝힐 수 있습니다.\"",
  "sec": 7.691
 },
 {
  "num": "192",
  "scene": "S34",
  "text": "사또가 한참 보다가 고개를 끄덕였어요.",
  "sec": 4.091
 },
 {
  "num": "193",
  "scene": "S34",
  "text": "\"그리하라. 네 이름이 네 물건에 붙는 것이 어찌 죄가 되겠느냐.\"",
  "sec": 6.851
 },
 {
  "num": "194",
  "scene": "S34",
  "text": "그 한마디에 영달이가 처음으로 고개를 들었습니다.",
  "sec": 5.211
 },
 {
  "num": "195",
  "scene": "S35",
  "text": "그날부터 영달이 갓 안쪽에는 작은 낙인이 하나 찍혔어요.",
  "sec": 6.851
 },
 {
  "num": "196",
  "scene": "S35",
  "text": "겉에서는 여전히 보이지 않았습니다.",
  "sec": 3.731
 },
 {
  "num": "197",
  "scene": "S35",
  "text": "쓴 사람도 몰랐고요.",
  "sec": 3.291
 },
 {
  "num": "198",
  "scene": "S35",
  "text": "다만 뒤집으면 거기 이름이 있었지요.",
  "sec": 3.931
 },
 {
  "num": "199",
  "scene": "S35",
  "text": "영달이는 낙인을 찍을 때마다 한참을 들여다봤다고 해요.",
  "sec": 6.131
 },
 {
  "num": "200",
  "scene": "S35",
  "text": "스물다섯 해 만에 제 이름을 물건에 붙인 것이었으니까요.",
  "sec": 5.651
 },
 {
  "num": "201",
  "scene": "S36",
  "text": "그 뒤로 고을에서는 갓을 살 때 안쪽부터 뒤집어 보게 됐어요.",
  "sec": 7.531
 },
 {
  "num": "202",
  "scene": "S36",
  "text": "낙인이 있는 갓이 값을 두 배로 받았습니다.",
  "sec": 4.691
 },
 {
  "num": "203",
  "scene": "S36",
  "text": "이웃 고을에서도 사람이 왔고요.",
  "sec": 3.291
 },
 {
  "num": "204",
  "scene": "S36",
  "text": "\"이거 영달이가 만든 것입니까?\" 하고 묻는 말이 인사처럼 됐지요.",
  "sec": 7.211
 },
 {
  "num": "205",
  "scene": "S36",
  "text": "갓장이가 이름으로 불린 것도 그때가 처음이었습니다.",
  "sec": 5.771
 },
 {
  "num": "206",
  "scene": "S36",
  "text": "전에는 그냥 \"갓쟁이\"였거든요.",
  "sec": 4.091
 },
 {
  "num": "207",
  "scene": "S37",
  "text": "영달이는 평생 갓을 쓰지 못했어요.",
  "sec": 4.891
 },
 {
  "num": "208",
  "scene": "S37",
  "text": "죽을 때까지 맨머리에 수건만 동였습니다.",
  "sec": 5.131
 },
 {
  "num": "209",
  "scene": "S37",
  "text": "그런데 고을 양반 백 명의 갓 안쪽에 영달이 이름이 있었지요.",
  "sec": 7.211
 },
 {
  "num": "210",
  "scene": "S37",
  "text": "쓴 사람들은 평생 그걸 모르고 다녔고요.",
  "sec": 4.291
 },
 {
  "num": "211",
  "scene": "S37",
  "text": "머리 위에 이름을 얹고 다닌 셈이지요.",
  "sec": 4.731
 },
 {
  "num": "212",
  "scene": "S38",
  "text": "허허, 어떻습니까. 갓 한 번 못 써 본 사람이, 갓 쓴 사람을 벗겨 냈지요.",
  "sec": 7.691
 },
 {
